From ade4883c57c71d72455c7d1c68514c528a8c66ee Mon Sep 17 00:00:00 2001
From: Mika Laitio <mika.laitio@amd.com>
Date: Thu, 16 Apr 2026 00:36:14 -0700
Subject: [PATCH 18/19] rocprofiler-systems use therock provided elfutils

Signed-off-by: Mika Laitio <mika.laitio@amd.com>
---
 profiler/CMakeLists.txt | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/profiler/CMakeLists.txt b/profiler/CMakeLists.txt
index 6b8b8ea8..1867d184 100644
--- a/profiler/CMakeLists.txt
+++ b/profiler/CMakeLists.txt
@@ -315,6 +315,7 @@ if(THEROCK_ENABLE_ROCPROFV3)
         -DROCPROFSYS_GFX_TARGETS="${_ROCPROFSYS_GFX_TARGETS_ESCAPED}"
         -DROCPROFSYS_BUILD_SPDLOG=OFF
         -DROCPROFSYS_BUILD_SQLITE3=OFF
+        -DROCPROFSYS_BUILD_ELFUTILS=OFF # use elfutils provided by therock
         -DROCPROFSYS_USE_PYTHON="${_ROCPROFSYS_USE_PYTHON}"
         -DROCPROFSYS_PYTHON_VERSIONS:STRING="${_ROCPROFSYS_PYTHON_VERSIONS_STR}"
         -DROCPROFSYS_PYTHON_ROOT_DIRS:STRING="${_ROCPROFSYS_PYTHON_ROOT_DIRS_STR}"
@@ -326,6 +327,7 @@ if(THEROCK_ENABLE_ROCPROFV3)
       CMAKE_INCLUDES
         therock_explicit_finders.cmake
       BUILD_DEPS
+        therock-elfutils
         therock-spdlog
         therock-fmt
         roctracer
-- 
