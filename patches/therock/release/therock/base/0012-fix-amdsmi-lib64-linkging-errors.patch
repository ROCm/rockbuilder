Subject: [PATCH 12/21] fix amdsmi lib64 linkging errors

Signed-off-by: Mika Laitio <mika.laitio@amd.com>
---
 ...ries-before-lib-to-fix-linking-error.patch | 43 +++++++++++++++++++
 1 file changed, 43 insertions(+)
 create mode 100644 patches/amd-mainline/rocm-systems/0006-link-lib64-libraries-before-lib-to-fix-linking-error.patch

diff --git a/patches/amd-mainline/rocm-systems/0006-link-lib64-libraries-before-lib-to-fix-linking-error.patch b/patches/amd-mainline/rocm-systems/0006-link-lib64-libraries-before-lib-to-fix-linking-error.patch
new file mode 100644
index 0000000..7ed9e23
--- /dev/null
+++ b/patches/amd-mainline/rocm-systems/0006-link-lib64-libraries-before-lib-to-fix-linking-error.patch
@@ -0,0 +1,43 @@
+From 25b67b20379d4b6399e6ab1967b34a3205791f07 Mon Sep 17 00:00:00 2001
+From: Mika Laitio <mika.laitio@amd.com>
+Date: Mon, 13 Apr 2026 14:02:18 -0700
+Subject: [PATCH 6/6] link /lib64 libraries before /lib to fix linking error
+
+Linking of amdsmi can fail on systems which have both
+the 32 and 64 bit libraries installed.
+
+In these systems the 32 bit version of libraries are usually
+installed to /lib-folder and 64-bit versions to /lib64 folder
+which can lead to linking error if lib-folder is specified
+before the lib64 folder because then the 32-bit version of libraries
+are tried to link to 64 bit version of amdsmi.
+
+Fix is simply the specify the lib64 folder before the lib-folder.
+
+Example of the error that this fixes:
+
+0.1	: && /therock/build/compiler/amd-llvm/dist/lib/llvm/bin/clang -fPIC -O3 -DNDEBUG  -L/therock/build/third-party/sysdeps/linux/libdrm/build/stage/lib/rocm_sysdeps/lib -Wl,-rpath-link,/therock/build/third-party/sysdeps/linux/libdrm/build/stage/lib/rocm_sysdeps/lib -L/therock/build/third-party/sysdeps/linux/libmnl/build/stage/lib/rocm_sysdeps/lib -Wl,-rpath-link,/therock/build/third-party/sysdeps/linux/libmnl/build/stage/lib/rocm_sysdeps/lib -L/therock/build/third-party/sysdeps/linux/libnl/build/stage/lib/rocm_sysdeps/lib -Wl,-rpath-link,/therock/build/third-party/sysdeps/linux/libnl/build/stage/lib/rocm_sysdeps/lib -Wl,--build-id=sha1   -Xlinker --dependency-file=goamdsmi_shim/CMakeFiles/goamdsmi_shim64.dir/link.d -shared -Wl,-soname,libgoamdsmi_shim64.so.1 -o goamdsmi_shim/libgoamdsmi_shim64.so.1.0 goamdsmi_shim/CMakeFiles/goamdsmi_shim64.dir/smiwrapper/amdsmi_go_shim.c.o  -Wl,-rpath,/therock/build/core/amdsmi/build/src:  -lpthread  -lrt  -lm  src/libamd_smi.so.26.4.0  -L/lib  -L/lib64 && :
+0.1	ld.lld: error: /usr/lib/gcc/x86_64-mageia-linux/12/../../../../lib64/crti.o is incompatible with elf32-i386
+0.1	ld.lld: error: /therock/build/compiler/amd-llvm/dist/lib/llvm/lib/clang/23/lib/linux/clang_rt.crtbegin-x86_64.o is incompatible with elf32-i386
+
+Signed-off-by: Mika Laitio <mika.laitio@amd.com>
+---
+ projects/amdsmi/goamdsmi_shim/CMakeLists.txt | 2 +-
+ 1 file changed, 1 insertion(+), 1 deletion(-)
+
+diff --git a/projects/amdsmi/goamdsmi_shim/CMakeLists.txt b/projects/amdsmi/goamdsmi_shim/CMakeLists.txt
+index 3549c8f07f..4f0c7e4d65 100644
+--- a/projects/amdsmi/goamdsmi_shim/CMakeLists.txt
++++ b/projects/amdsmi/goamdsmi_shim/CMakeLists.txt
+@@ -90,8 +90,8 @@ add_library(${GOAMDSMI_SHIM_TARGET} SHARED ${go_amd_smi_sources} ${go_amd_smi_he
+ target_link_libraries(${GOAMDSMI_SHIM_TARGET} pthread rt m)
+
+ target_link_libraries(${GOAMDSMI_SHIM_TARGET} amd_smi)
+-target_link_libraries(${GOAMDSMI_SHIM_TARGET} -L${AMDSMI_DIR}/lib)
+ target_link_libraries(${GOAMDSMI_SHIM_TARGET} -L${AMDSMI_DIR}/lib64)
++target_link_libraries(${GOAMDSMI_SHIM_TARGET} -L${AMDSMI_DIR}/lib)
+
+ ## Set the VERSION and SOVERSION values
+ set_property(TARGET ${GOAMDSMI_SHIM_TARGET} PROPERTY SOVERSION "${VERSION_MAJOR}")
+--
+2.41.3
