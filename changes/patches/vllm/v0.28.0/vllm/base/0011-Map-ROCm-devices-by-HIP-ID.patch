From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Mika Laitio <mika.laitio@amd.com>
Date: Tue, 15 Sep 2026 10:25:25 -0700
Subject: [PATCH] Map ROCm devices by HIP ID

- AMD-SMI handle order can differ from the HIP
  physical device order on mixed-GPU hosts.
- Positional indexing therefore reports an MI210
  for a W7900 process and a W7900 for an MI210.
- Wrong names select unrelated fused-MoE tuning
  files and reduce performance even though generic
  fallback configurations preserve correctness.
- Match handles through AMD-SMI's explicit hip_id
  instead of their positions in the handle list.
- Apply the mapping to architecture, name, UUID,
  memory, XGMI, and NUMA queries without creating
  a HIP context.
- Add tests that reverse AMD-SMI handle order.

Tools used:
- GPT-5.6 Sol: GPT-5.6 Sol

Signed-off-by: Mika Laitio <mika.laitio@amd.com>
---
 vllm/platforms/rocm.py            |   48 +++++++++++++++++++++++++------------
 tests/rocm/test_amdsmi_mapping.py |   46 +++++++++++++++++++++++++++++++++++
 2 files changed, 79 insertions(+), 15 deletions(-)

diff --git a/vllm/platforms/rocm.py b/vllm/platforms/rocm.py
index 9072c71426..5205b0bc94 100644
--- a/vllm/platforms/rocm.py
+++ b/vllm/platforms/rocm.py
@@ -31,6 +31,7 @@
         AmdSmiMemoryType,
         amdsmi_get_gpu_asic_info,
         amdsmi_get_gpu_device_uuid,
+        amdsmi_get_gpu_enumeration_info,
         amdsmi_get_gpu_memory_total,
         amdsmi_get_processor_handles,
         amdsmi_init,
@@ -174,25 +175,42 @@
     return wrapper


+def _get_amdsmi_handle(physical_device_id: int):
+    """Map a physical HIP device ID to its AMD-SMI handle."""
+    ret = None
+    for handle in amdsmi_get_processor_handles():
+        enumeration_info = amdsmi_get_gpu_enumeration_info(handle)
+        if enumeration_info.get("hip_id") == physical_device_id:
+            ret = handle
+            break
+    if ret is None:
+        raise RuntimeError(
+            f"amdsmi did not return a handle for HIP device {physical_device_id}"
+        )
+    return ret
+
+
 @with_amdsmi_context
 def _query_gcn_arch_from_amdsmi() -> str:
     """Query GCN arch from amdsmi. Raises if not available."""
-    handles = amdsmi_get_processor_handles()
-    if handles:
-        asic_info = amdsmi_get_gpu_asic_info(handles[0])
-        # Use target_graphics_version which contains the gfx name
-        # e.g., 'gfx942' for MI300X/MI325X
-        target_gfx = asic_info.get("target_graphics_version", "")
-        if target_gfx:
-            return target_gfx
+    physical_device_id = 0
+    visible_devices = os.environ.get("HIP_VISIBLE_DEVICES", "")
+    if visible_devices:
+        physical_device_id = int(visible_devices.split(",")[0])
+    handle = _get_amdsmi_handle(physical_device_id)
+    asic_info = amdsmi_get_gpu_asic_info(handle)
+    # Use target_graphics_version which contains the gfx name
+    # e.g., 'gfx942' for MI300X/MI325X
+    target_gfx = asic_info.get("target_graphics_version", "")
+    if target_gfx:
+        return target_gfx
     raise RuntimeError("amdsmi did not return valid GCN arch")


 @with_amdsmi_context
 def _query_total_memory_from_amdsmi(physical_device_id: int) -> int:
     """Query total VRAM (bytes) from amdsmi. Raises if not available."""
-    handles = amdsmi_get_processor_handles()
-    handle = handles[physical_device_id]
+    handle = _get_amdsmi_handle(physical_device_id)
     return amdsmi_get_gpu_memory_total(handle, AmdSmiMemoryType.VRAM)


@@ -803,7 +821,7 @@
         """
         Query if the set of gpus are fully connected by xgmi (1 hop)
         """
