diff --git a/tests/rocm/test_amdsmi_mapping.py b/tests/rocm/test_amdsmi_mapping.py
new file mode 100644
index 0000000000..614be297ee
--- /dev/null
+++ b/tests/rocm/test_amdsmi_mapping.py
@@ -0,0 +1,46 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+
+import pytest
+
+from vllm.platforms import current_platform
+from vllm.platforms import rocm
+
+
+pytestmark = pytest.mark.skipif(
+    not current_platform.is_rocm(),
+    reason="ROCm-only platform tests",
+)
+
+
+@pytest.fixture
+def reversed_amdsmi_handles(monkeypatch):
+    mi210 = object()
+    w7900 = object()
+    handles = [mi210, w7900]
+    hip_ids = {
+        mi210: {"hip_id": 1},
+        w7900: {"hip_id": 0},
+    }
+    monkeypatch.setattr(rocm, "amdsmi_get_processor_handles", lambda: handles)
+    monkeypatch.setattr(
+        rocm,
+        "amdsmi_get_gpu_enumeration_info",
+        lambda handle: hip_ids[handle],
+    )
+    return mi210, w7900
+
+
+def test_get_amdsmi_handle_maps_physical_hip_id(reversed_amdsmi_handles):
+    mi210, w7900 = reversed_amdsmi_handles
+
+    assert rocm._get_amdsmi_handle(0) is w7900
+    assert rocm._get_amdsmi_handle(1) is mi210
+
+
+def test_get_amdsmi_handle_rejects_unknown_hip_id(reversed_amdsmi_handles):
+    with pytest.raises(
+        RuntimeError,
+        match="did not return a handle for HIP device 2",
+    ):
+        rocm._get_amdsmi_handle(2)
