+        handles = [_get_amdsmi_handle(i) for i in physical_device_ids]
         for i, handle in enumerate(handles):
             for j, peer_handle in enumerate(handles):
                 if i < j:
@@ -822,7 +840,7 @@
     @lru_cache(maxsize=8)
     def get_device_name(cls, device_id: int = 0) -> str:
