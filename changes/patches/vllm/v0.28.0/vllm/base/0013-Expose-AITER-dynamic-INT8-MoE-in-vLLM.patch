+def test_aiter_ck_int8_weights_are_shuffled(monkeypatch):
+    from vllm._aiter_ops import rocm_aiter_ops
+    from vllm.platforms import rocm
+
+    w13 = torch.ones((2, 4, 8), dtype=torch.int8)
+    w2 = torch.ones((2, 8, 2), dtype=torch.int8)
+    shuffled_w13 = w13.clone()
+    shuffled_w2 = w2.clone()
+    monkeypatch.setattr(rocm, "on_gfx1100", lambda: False)
+    monkeypatch.setattr(
+        rocm_aiter_ops,
+        "shuffle_weights",
+        lambda *_args: (shuffled_w13, shuffled_w2),
+    )
+
+    actual_w13, actual_w2 = convert_to_int8_moe_kernel_format(
+        Int8MoeBackend.AITER,
+        w13,
+        w2,
+    )
+
+    assert actual_w13 is shuffled_w13
+    assert actual_w2 is shuffled_w2
+    assert actual_w13.is_shuffled
+    assert actual_w2.is_shuffled
+
+
+def test_aiter_gfx1100_int8_weights_use_triton_layout(monkeypatch):
+    from vllm.platforms import rocm
+
+    layer = torch.nn.Module()
+    w13 = torch.arange(12, dtype=torch.int8).view(1, 4, 3)
+    w2 = torch.arange(6, dtype=torch.int8).view(1, 3, 2)
+    layer.register_parameter(
+        "w13_scale",
+        torch.nn.Parameter(
+            torch.arange(4, dtype=torch.float32).view(1, 4),
+            requires_grad=False,
+        ),
+    )
+    layer.register_parameter(
+        "w2_scale",
+        torch.nn.Parameter(
+            torch.arange(3, dtype=torch.float32).view(1, 3),
+            requires_grad=False,
+        ),
+    )
+    monkeypatch.setattr(rocm, "on_gfx1100", lambda: True)
+
+    actual_w13, actual_w2 = convert_to_int8_moe_kernel_format(
+        Int8MoeBackend.AITER,
+        w13,
+        w2,
+        layer=layer,
+    )
+
+    expected_w13 = w13[:, [0, 2, 1, 3], :].transpose(1, 2).contiguous()
+    expected_w2 = w2.transpose(1, 2).contiguous()
+    torch.testing.assert_close(actual_w13, expected_w13)
+    torch.testing.assert_close(actual_w2, expected_w2)
+    torch.testing.assert_close(
+        layer.w13_scale,
+        torch.tensor([[0.0, 2.0, 1.0, 3.0]]),
+    )
+    torch.testing.assert_close(
+        layer.w2_scale,
+        torch.tensor([[0.0, 1.0, 2.0]]),
+    )
+    assert actual_w13.aiter_int8_triton
+    assert actual_w2.aiter_int8_triton
+
+
