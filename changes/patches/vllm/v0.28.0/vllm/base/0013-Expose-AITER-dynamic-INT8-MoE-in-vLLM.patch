+def _get_int8_scale_parameter_name(layer: torch.nn.Module, sub: str) -> str:
+    ret = ""
+    for candidate in (f"{sub}_scale", f"{sub}_weight_scale"):
+        if hasattr(layer, candidate):
+            ret = candidate
+            break
+    if not ret:
+        raise ValueError(f"Missing {sub} INT8 weight scale parameter")
+    return ret
+
+
+def _prepare_aiter_triton_int8_weights(
+    layer: torch.nn.Module,
+    w13: torch.Tensor,
+    w2: torch.Tensor,
+) -> tuple[torch.Tensor, torch.Tensor]:
+    """Convert separated vLLM weights to AITER's Triton MoE layout."""
+    num_experts, gate_up_dim, hidden_dim = w13.shape
+    assert gate_up_dim % 2 == 0
+    intermediate_dim = gate_up_dim // 2
+
+    w13 = (
+        w13.view(num_experts, 2, intermediate_dim, hidden_dim)
+        .transpose(1, 2)
+        .reshape(num_experts, gate_up_dim, hidden_dim)
+        .transpose(1, 2)
+        .contiguous()
+    )
+    w2 = w2.transpose(1, 2).contiguous()
+
+    w13_scale_name = _get_int8_scale_parameter_name(layer, "w13")
+    w2_scale_name = _get_int8_scale_parameter_name(layer, "w2")
+    w13_scale = getattr(layer, w13_scale_name).data
+    w2_scale = getattr(layer, w2_scale_name).data
+    if w13_scale.dim() == 3:
+        assert w13_scale.shape[-1] == 1
+        w13_scale = w13_scale.squeeze(-1)
+    if w2_scale.dim() == 3:
+        assert w2_scale.shape[-1] == 1
+        w2_scale = w2_scale.squeeze(-1)
+    w13_scale = (
+        w13_scale.view(num_experts, 2, intermediate_dim)
+        .transpose(1, 2)
+        .reshape(num_experts, gate_up_dim)
+        .contiguous()
+    )
+    w2_scale = w2_scale.contiguous()
+    replace_parameter(layer, w13_scale_name, w13_scale)
+    replace_parameter(layer, w2_scale_name, w2_scale)
+    w13.aiter_int8_triton = True
+    w2.aiter_int8_triton = True
+    return w13, w2
+
+
