+def test_aiter_dynamic_int8_uses_gfx1100_triton(monkeypatch):
+    from vllm.model_executor.layers.fused_moe.experts import rocm_aiter_moe
+    from vllm.model_executor.layers.fused_moe.experts.rocm_aiter_moe import (
+        rocm_aiter_fused_experts,
+    )
+    from vllm.platforms import rocm
+
+    expected = torch.zeros((2, 8), dtype=torch.bfloat16)
+    captured = {}
+
+    def fake_int8_moe(*args):
+        captured["args"] = args
+        return expected
+
+    monkeypatch.setattr(rocm, "on_gfx1100", lambda: True)
+    monkeypatch.setattr(
+        rocm_aiter_moe,
+        "rocm_aiter_int8_moe_from_topk",
+        fake_int8_moe,
+    )
+    quant_config = make_int8_moe_quant_config(
+        Int8MoeBackend.AITER,
+        w1_scale=torch.ones((2, 16)),
+        w2_scale=torch.ones((2, 8)),
+        per_act_token_quant=True,
+    )
+    w1 = torch.ones((2, 8, 16), dtype=torch.int8)
+    w2 = torch.ones((2, 8, 8), dtype=torch.int8)
+    w1.aiter_int8_triton = True
+    w2.aiter_int8_triton = True
+
+    actual = rocm_aiter_fused_experts(
+        hidden_states=torch.zeros((2, 8), dtype=torch.bfloat16),
+        w1=w1,
+        w2=w2,
+        topk_weights=torch.ones((2, 1)),
+        topk_ids=torch.zeros((2, 1), dtype=torch.int32),
+        moe_config=_make_int8_moe_config(moe_backend="aiter"),
+        quant_config=quant_config,
+    )
+
+    assert actual is expected
+    assert captured["args"][1] is w1
+    assert captured["args"][2] is w2
