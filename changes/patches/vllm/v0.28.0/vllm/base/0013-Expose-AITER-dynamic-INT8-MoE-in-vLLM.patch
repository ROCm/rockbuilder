+def test_int8_explicit_moe_backend_aiter(monkeypatch):
+    """An explicit --moe-backend aiter selects the AITER INT8 backend."""
+
+    class SupportedAiterExperts:
+        @staticmethod
+        def is_supported_config(*_args):
+            return True, None
+
+    monkeypatch.setattr(
+        int8_oracle,
+        "backend_to_kernel_cls",
+        lambda _backend: [SupportedAiterExperts],
+    )
+
+    config = _make_int8_moe_config(moe_backend="aiter")
+    backend, experts_cls = select_int8_moe_backend(
+        config,
+        weight_key=kInt8StaticChannelSym,
+        activation_key=kInt8DynamicTokenSym,
+    )
+
+    assert backend == Int8MoeBackend.AITER
+    assert experts_cls is SupportedAiterExperts
+
+
+@requires_aiter_int8_target
+def test_int8_explicit_aiter_supported_on_target(monkeypatch):
+    from vllm.model_executor.layers.fused_moe.experts.rocm_aiter_moe import (
+        AiterInt8Experts,
+    )
+
+    monkeypatch.setattr(
+        AiterInt8Experts,
+        "_supports_current_device",
+        staticmethod(lambda: True),
+    )
+    config = _make_int8_moe_config(moe_backend="aiter")
+    backend, experts_cls = select_int8_moe_backend(
+        config,
+        weight_key=kInt8StaticChannelSym,
+        activation_key=kInt8DynamicTokenSym,
+    )
+
+    assert backend == Int8MoeBackend.AITER
+    assert experts_cls is AiterInt8Experts
+
+
