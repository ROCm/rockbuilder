+def _use_aiter_triton_int8_on_gfx1201(m: int, n: int, k: int) -> bool:
+    """Select Triton only for gfx1201 shapes where it clearly beats CKTile."""
+    ret = False
+    if (n, k) == (1280, 8192):
+        ret = m < 16
+    elif (n, k) == (11008, 4096):
+        ret = m <= 8
+    elif (n, k) == (4096, 11008):
+        ret = m <= 32
+    elif (n, k) == (28672, 8192):
+        ret = m <= 64
+    elif (n, k) == (28672, 4096):
+        ret = m <= 128
+    elif (n, k) == (4096, 14336):
+        ret = m <= 32
+    elif (n, k) == (6144, 4096):
+        ret = m <= 8
+    return ret
+
+
