@@ -0,0 +1,226 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+
+import torch
+from compressed_tensors.quantization import QuantizationArgs
+
+from vllm.model_executor.layers.fused_moe.config import FusedMoEConfig
+from vllm.model_executor.layers.fused_moe.experts.triton_moe import (
+    TritonW4A8IntExperts,
+)
+from vllm.model_executor.utils import replace_parameter, set_weight_attrs
+
+from .compressed_tensors_moe_wna16 import (
+    CompressedTensorsWNA16MoEMethod,
+)
+
+
+def _validate_w4a8_input(input_quant: QuantizationArgs) -> None:
+    if not input_quant.dynamic:
+        raise ValueError("ROCm W4A8 requires dynamic input quantization.")
+    if not input_quant.symmetric:
+        raise ValueError("ROCm W4A8 requires symmetric input quantization.")
+    if input_quant.num_bits != 8:
+        raise ValueError("ROCm W4A8 requires 8-bit input quantization.")
+
+
+class CompressedTensorsW4A8Int8PackedRocmMoEMethod(
+    CompressedTensorsWNA16MoEMethod
+):
+    """Packed-checkpoint ROCm W4A8 using native INT8 matrix compute."""
+
+    def __init__(
+        self,
+        weight_quant: QuantizationArgs,
+        input_quant: QuantizationArgs,
+        moe: FusedMoEConfig,
+        layer_name: str | None = None,
+    ):
+        _validate_w4a8_input(input_quant)
+        super().__init__(weight_quant, None, moe, layer_name)
+        self.experts_cls = TritonW4A8IntExperts
+
+    def create_weights(
+        self,
+        layer: torch.nn.Module,
+        num_experts: int,
+        hidden_size: int,
+        intermediate_size_per_partition: int,
+        params_dtype: torch.dtype,
+        **extra_weight_attrs,
+    ):
+        extra_weight_attrs.setdefault(
+            "intermediate_size_full",
+            intermediate_size_per_partition,
+        )
+        super().create_weights(
+            layer,
+            num_experts,
+            hidden_size,
+            intermediate_size_per_partition,
+            params_dtype,
+            **extra_weight_attrs,
+        )
+
+class CompressedTensorsW4A8Int8RocmMoEMethod(CompressedTensorsWNA16MoEMethod):
+    """Unpacked-checkpoint ROCm W4A8 using native INT8 matrix compute."""
+
+    def __init__(
+        self,
+        weight_quant: QuantizationArgs,
+        input_quant: QuantizationArgs,
+        moe: FusedMoEConfig,
+        layer_name: str | None = None,
+    ):
+        _validate_w4a8_input(input_quant)
+        super().__init__(weight_quant, None, moe, layer_name)
+        self.experts_cls = TritonW4A8IntExperts
+
+    def create_weights(
+        self,
+        layer: torch.nn.Module,
+        num_experts: int,
+        hidden_size: int,
+        intermediate_size_per_partition: int,
+        params_dtype: torch.dtype,
+        **extra_weight_attrs,
+    ):
+        if self.moe.has_bias:
+            raise ValueError("ROCm W4A8 fallback does not support expert bias.")
+
+        experts = num_experts
+        inter = intermediate_size_per_partition
+        group_size = self.group_size
+        num_groups_w13 = hidden_size // group_size
+        num_groups_w2 = inter // group_size
+        layer.num_groups_w13 = num_groups_w13
+        layer.num_groups_w2 = num_groups_w2
+
+        w13 = torch.nn.Parameter(
+            torch.empty(experts, 2 * inter, hidden_size, dtype=torch.int8),
+            requires_grad=False,
+        )
+        set_weight_attrs(w13, extra_weight_attrs)
+        layer.register_parameter("w13_weight", w13)
+
+        w2 = torch.nn.Parameter(
+            torch.empty(experts, hidden_size, inter, dtype=torch.int8),
+            requires_grad=False,
+        )
+        set_weight_attrs(w2, extra_weight_attrs)
+        layer.register_parameter("w2_weight", w2)
+
+        w13_scale = torch.nn.Parameter(
+            torch.ones(
+                experts,
+                2 * inter,
+                num_groups_w13,
+                dtype=params_dtype,
+            ),
+            requires_grad=False,
+        )
+        set_weight_attrs(
+            w13_scale,
+            {"quant_method": "group", **extra_weight_attrs},
+        )
+        layer.register_parameter("w13_weight_scale", w13_scale)
+
+        w2_scale = torch.nn.Parameter(
+            torch.ones(
+                experts,
+                hidden_size,
+                num_groups_w2,
+                dtype=params_dtype,
+            ),
+            requires_grad=False,
+        )
+        set_weight_attrs(
+            w2_scale,
+            {"quant_method": "group", **extra_weight_attrs},
+        )
+        set_weight_attrs(w2_scale, {"load_full_w2": False})
+        layer.register_parameter("w2_weight_scale", w2_scale)
+
+        for name in ("w13_weight_packed", "w2_weight_packed"):
+            parameter = torch.nn.Parameter(torch.empty(0), requires_grad=False)
+            set_weight_attrs(parameter, extra_weight_attrs)
+            layer.register_parameter(name, parameter)
+
+        for name in ("w13_weight_shape", "w2_weight_shape"):
+            parameter = torch.nn.Parameter(torch.empty(2), requires_grad=False)
+            set_weight_attrs(parameter, extra_weight_attrs)
+            layer.register_parameter(name, parameter)
+
+        for name, size in (
+            ("w13_weight_g_idx", hidden_size),
+            ("w2_weight_g_idx", inter),
+            ("w13_g_idx_sort_indices", hidden_size),
+            ("w2_g_idx_sort_indices", inter),
+        ):
+            parameter = torch.nn.Parameter(
+                torch.empty(experts, size, dtype=torch.int32),
+                requires_grad=False,
+            )
+            set_weight_attrs(parameter, extra_weight_attrs)
+            layer.register_parameter(name, parameter)
+
+        layer.a13_scale = None
+        layer.a2_scale = None
+        self.is_k_full = True
+
+    @staticmethod
+    def _pack_moe_weight(weight: torch.Tensor) -> torch.Tensor:
+        if weight.dtype != torch.int8:
+            raise ValueError(f"Expected INT4 values in int8, got {weight.dtype}.")
+        if weight.shape[-1] % 8 != 0:
+            raise ValueError(
+                f"INT4 input dimension must be divisible by 8, got {weight.shape[-1]}."
+            )
+        values = (weight.to(torch.int32) + 8) & 0xF
+        shifts = torch.arange(8, device=weight.device, dtype=torch.int32) * 4
+        packed = torch.sum(
+            values.view(*weight.shape[:-1], weight.shape[-1] // 8, 8) << shifts,
+            dim=-1,
+            dtype=torch.int32,
+        )
+        ret = packed.transpose(1, 2).contiguous()
+        return ret
+
+    def process_weights_after_loading(self, layer: torch.nn.Module) -> None:
+        w13_packed = self._pack_moe_weight(layer.w13_weight.data)
+        w2_packed = self._pack_moe_weight(layer.w2_weight.data)
+        w13_scale = layer.w13_weight_scale.data.transpose(1, 2).contiguous()
+        w2_scale = layer.w2_weight_scale.data.transpose(1, 2).contiguous()
+
+        replace_parameter(
+            layer,
+            "w13_weight_packed",
+            torch.nn.Parameter(w13_packed, requires_grad=False),
+        )
+        replace_parameter(
+            layer,
+            "w2_weight_packed",
+            torch.nn.Parameter(w2_packed, requires_grad=False),
+        )
+        replace_parameter(
+            layer,
+            "w13_weight_scale",
+            torch.nn.Parameter(w13_scale, requires_grad=False),
+        )
+        replace_parameter(
+            layer,
+            "w2_weight_scale",
+            torch.nn.Parameter(w2_scale, requires_grad=False),
+        )
+        replace_parameter(
+            layer,
+            "w13_weight",
+            torch.nn.Parameter(torch.empty(0), requires_grad=False),
+        )
+        replace_parameter(
+            layer,
+            "w2_weight",
+            torch.nn.Parameter(torch.empty(0), requires_grad=False),
+        )
+        super().process_weights_after_loading(layer)
+
