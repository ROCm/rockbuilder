+def test_pack_signed_int4_along_input():
+    weight = torch.tensor(
+        [[-8, -7, -1, 0, 1, 2, 6, 7]],
+        dtype=torch.int8,
+    )
+
+    actual = pack_signed_int4_along_input(weight)
+    expected = sum((int(value) + 8) << (index * 4) for index, value in enumerate(weight[0]))
+
+    assert actual.dtype == torch.int32
+    assert actual.shape == (1, 1)
+    assert int(actual[0, 0].to(torch.int64) & 0xFFFFFFFF) == expected
+
+
+def test_pack_signed_int4_moe_weight():
+    weight = torch.tensor(
+        [[[-8, -7, -1, 0, 1, 2, 6, 7], [7, 6, 2, 1, 0, -1, -7, -8]]],
+        dtype=torch.int8,
+    )
+
+    actual = CompressedTensorsW4A8Int8RocmMoEMethod._pack_moe_weight(weight)
+
+    assert actual.dtype == torch.int32
+    assert actual.shape == (1, 1, 2)
+    for output_index in range(2):
+        expected = sum(
+            (int(value) + 8) << (index * 4)
+            for index, value in enumerate(weight[0, output_index])
+        )
+        assert (
+            int(actual[0, 0, output_index].to(torch.int64) & 0xFFFFFFFF)
+            == expected
