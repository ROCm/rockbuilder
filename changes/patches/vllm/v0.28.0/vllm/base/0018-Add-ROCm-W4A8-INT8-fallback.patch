+@pytest.mark.skipif(not current_platform.is_rocm(), reason="ROCm only")
+@pytest.mark.parametrize("M,K,N,G", [(1, 256, 256, 128), (17, 512, 512, 128)])
+def test_triton_w4a8_gemm_matches_reference(M, K, N, G):
+    set_random_seed(0)
+    x = torch.randn((M, K), device=device, dtype=torch.bfloat16)
+    x_fp32 = x.float()
+    x_scale = torch.clamp(
+        x_fp32.abs().amax(dim=-1, keepdim=True) / 127.0,
+        min=torch.finfo(torch.float32).tiny,
+    )
+    x_quantized = torch.round(x_fp32 / x_scale).clamp(-127, 127).to(torch.int8)
+    weight = torch.randint(0, 16, (K, N), device=device, dtype=torch.int32)
+    weight_packed = _pack_int4_along_n(weight)
+    weight_scale = (
+        0.05 * torch.rand((K // G, N), device=device, dtype=torch.float32)
+    ).to(torch.bfloat16)
+
+    actual = triton_w4a8_gemm(
+        x_quantized,
+        x_scale,
+        weight_packed,
+        weight_scale,
+        G,
+        output_dtype=torch.bfloat16,
+    )
+    scale_full = weight_scale.float().repeat_interleave(G, dim=0)
+    weight_dequant = (weight - 8).float() * scale_full
+    expected = ((x_quantized.float() * x_scale) @ weight_dequant).to(torch.bfloat16)
+
+    torch.testing.assert_close(actual, expected, rtol=1e-2, atol=1e-2)
+
