+        if _prefer_triton_int8_on_gfx90a_or_gfx1100():
+            return (
+                False,
+                "Triton INT8 linear is faster on gfx90a/gfx1100 in automatic mode. "
+                "Use --linear-backend=aiter to override.",
+            )
         return True, None

     @classmethod
