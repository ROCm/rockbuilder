+def _prefer_triton_int8_on_gfx90a_or_gfx1100() -> bool:
+    from vllm.model_executor.kernels.linear import _get_linear_backend
+    from vllm.platforms.rocm import on_gfx1100, on_gfx90a
+
+    ret = (on_gfx90a() or on_gfx1100()) and _get_linear_backend() == "auto"
+    return ret
+
