@@ -71,6 +73,64 @@ def test_aiter_kernel_implements_is_supported():
     # This validates the method works correctly even on non-ROCm platforms


+@pytest.mark.parametrize(
+    ("gfx90a", "gfx1100", "linear_backend", "expected"),
+    [
+        (True, False, "auto", True),
+        (False, True, "auto", True),
+        (False, False, "auto", False),
+        (True, False, "aiter", False),
+        (False, True, "triton", False),
+    ],
+)
+def test_auto_prefers_triton_int8_on_gfx90a_gfx1100(
+    gfx90a,
+    gfx1100,
+    linear_backend,
+    expected,
+):
+    from vllm.model_executor.kernels.linear.scaled_mm import aiter as aiter_kernel
+
+    with (
+        patch("vllm.platforms.rocm.on_gfx90a", return_value=gfx90a),
+        patch("vllm.platforms.rocm.on_gfx1100", return_value=gfx1100),
+        patch(
+            "vllm.model_executor.kernels.linear._get_linear_backend",
+            return_value=linear_backend,
+        ),
+    ):
+        assert aiter_kernel._prefer_triton_int8_on_gfx90a_or_gfx1100() is expected
+
+
+@pytest.mark.parametrize(
+    ("prefer_triton", "expected"),
+    [(True, False), (False, True)],
+)
+def test_aiter_int8_support_respects_rocm_auto_policy(
+    prefer_triton,
+    expected,
+):
+    from vllm.model_executor.kernels.linear.scaled_mm import aiter as aiter_kernel
+
+    with (
+        patch.dict(sys.modules, {"aiter": types.ModuleType("aiter")}),
+        patch.object(aiter_kernel.current_platform, "is_rocm", return_value=True),
+        patch.object(
+            aiter_kernel.rocm_aiter_ops,
+            "is_int8_linear_enabled",
+            return_value=True,
+        ),
+        patch.object(
+            aiter_kernel,
+            "_prefer_triton_int8_on_gfx90a_or_gfx1100",
+            return_value=prefer_triton,
+        ),
+    ):
+        supported, _ = AiterInt8ScaledMMLinearKernel.is_supported()
+
+    assert supported is expected
+
+
 def test_cpu_kernel_accepts_all_configs():
