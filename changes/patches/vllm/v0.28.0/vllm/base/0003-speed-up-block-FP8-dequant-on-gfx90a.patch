+from unittest.mock import Mock, patch
+
+import pytest
+import torch
+
+from vllm.model_executor.layers.quantization.utils.fp8_utils import (
+    _gfx90a_fast_fp8_eligible,
+)
+
+
+def _tensor(dtype: torch.dtype) -> Mock:
+    return Mock(dtype=dtype, device=torch.device("cuda:0"), is_cuda=True)
+
+
+def test_fast_fp8_eligible_on_gfx90a() -> None:
+    with (
+        patch(
+            "vllm.model_executor.layers.quantization.utils.fp8_utils."
+            "current_platform.is_rocm",
+            return_value=True,
+        ),
+        patch(
+            "torch.cuda.get_device_properties",
+            return_value=Mock(gcnArchName="gfx90a:sramecc+:xnack-"),
+        ),
+    ):
+        assert _gfx90a_fast_fp8_eligible(
+            _tensor(torch.float8_e4m3fn),
+            _tensor(torch.float8_e4m3fn),
+            _tensor(torch.float32),
+            _tensor(torch.float32),
+            [128, 128],
+        )
+
+
+@pytest.mark.parametrize(
+    ("a_dtype", "b_dtype", "as_dtype", "bs_dtype", "block_size"),
+    [
+        (
+            torch.float8_e4m3fnuz,
+            torch.float8_e4m3fn,
+            torch.float32,
+            torch.float32,
+            [128, 128],
+        ),
+        (
+            torch.float8_e4m3fn,
+            torch.float8_e4m3fnuz,
+            torch.float32,
+            torch.float32,
+            [128, 128],
+        ),
+        (
+            torch.float8_e4m3fn,
+            torch.float8_e4m3fn,
+            torch.float16,
+            torch.float32,
+            [128, 128],
+        ),
+        (
+            torch.float8_e4m3fn,
+            torch.float8_e4m3fn,
+            torch.float32,
+            torch.float16,
+            [128, 128],
+        ),
+        (
+            torch.float8_e4m3fn,
+            torch.float8_e4m3fn,
+            torch.float32,
+            torch.float32,
+            [64, 128],
+        ),
+    ],
+)
+def test_fast_fp8_rejects_unsupported_inputs(
+    a_dtype: torch.dtype,
+    b_dtype: torch.dtype,
+    as_dtype: torch.dtype,
+    bs_dtype: torch.dtype,
+    block_size: list[int],
+) -> None:
+    with (
+        patch(
+            "vllm.model_executor.layers.quantization.utils.fp8_utils."
+            "current_platform.is_rocm",
+            return_value=True,
+        ),
+        patch(
+            "torch.cuda.get_device_properties",
+            return_value=Mock(gcnArchName="gfx90a"),
+        ),
+    ):
+        assert not _gfx90a_fast_fp8_eligible(
+            _tensor(a_dtype),
+            _tensor(b_dtype),
+            _tensor(as_dtype),
+            _tensor(bs_dtype),
+            block_size,
+        )
+
+
+def test_fast_fp8_rejects_non_gfx90a() -> None:
+    with (
+        patch(
+            "vllm.model_executor.layers.quantization.utils.fp8_utils."
+            "current_platform.is_rocm",
+            return_value=True,
+        ),
+        patch(
+            "torch.cuda.get_device_properties",
+            return_value=Mock(gcnArchName="gfx1100"),
+        ),
+    ):
+        assert not _gfx90a_fast_fp8_eligible(
+            _tensor(torch.float8_e4m3fn),
+            _tensor(torch.float8_e4m3fn),
+            _tensor(torch.float32),
+            _tensor(torch.float32),
+            [128, 128],
+        )
