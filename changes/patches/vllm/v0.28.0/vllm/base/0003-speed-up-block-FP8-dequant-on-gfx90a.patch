     return x_q, x_s_packed


+@triton.jit
+def _gfx90a_fast_fp8_to_f16(value):
+    """Decode e4m3fn to fp16 scaled by exactly 2^-8."""
+    value_u16 = value.to(tl.uint16)
+    value_f16_bits = ((value_u16 & 0x80) << 8) | ((value_u16 & 0x7F) << 7)
+    nan_bits = ((value_u16 & 0x80) << 8) | 0x7E00
+    value_f16_bits = tl.where((value_u16 & 0x7F) == 0x7F, nan_bits, value_f16_bits)
+    return value_f16_bits.to(tl.float16, bitcast=True)
+
+
+def _gfx90a_fast_fp8_eligible(
+    A: torch.Tensor,
+    B: torch.Tensor,
+    As: torch.Tensor,
+    Bs: torch.Tensor,
+    block_size: list[int],
+) -> bool:
+    """Return whether the gfx90a-specific e4m3fn decoder is safe to use."""
+    if not current_platform.is_rocm() or not A.is_cuda:
+        return False
+
+    if not (A.device == B.device == As.device == Bs.device):
+        return False
+
+    device_arch = torch.cuda.get_device_properties(A.device).gcnArchName.split(":", 1)[0]
+
+    return (
+        device_arch == "gfx90a"
+        and A.dtype == torch.float8_e4m3fn
+        and B.dtype == torch.float8_e4m3fn
+        and As.dtype == torch.float32
+        and Bs.dtype == torch.float32
+        and list(block_size) == [128, 128]
+    )
+
+
