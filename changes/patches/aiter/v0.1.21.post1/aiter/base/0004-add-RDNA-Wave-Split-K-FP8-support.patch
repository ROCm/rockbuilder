+
+## RDNA Wave Split-K FP8 correctness
+
+The RDNA validator covers gfx1100, gfx1200, and gfx1201. The gfx1100 kernel
+decodes E4M3FN operands to FP16 before using FP16 WMMA. The gfx1200 and gfx1201
+kernels use native E4M3FN FP8 WMMA.
+
+On a homogeneous host, set `GPU_ARCHS` to the installed architecture:
+
+```bash
+export PYTHONPATH="${PWD}:${PYTHONPATH:-}"
+GPU_ARCHS=gfx1100 \
+  python op_tests/validation/validate_rdna_wv_split_kq.py
+```
+
+Replace `gfx1100` with `gfx1200` or `gfx1201` as appropriate. On a
+mixed-architecture host, expose only the device under test to the ROCm runtime.
+For example, if that device is physical device 1:
+
+```bash
+ROCR_VISIBLE_DEVICES=1 \
+  GPU_ARCHS=gfx1200 \
+  python op_tests/validation/validate_rdna_wv_split_kq.py
+```
+
+The validator checks FP16 and BF16 output, activation row counts from one
+through four, output-column tails, and small and large K dimensions. It fails
+if AITER selects a format other than E4M3FN, the visible GPU is unsupported, or
+the kernel differs from dequantized FP32 matrix multiplication beyond the
+existing Wave Split-K tolerance.
diff --git a/op_tests/validation/validate_rdna_wv_split_kq.py b/op_tests/validation/validate_rdna_wv_split_kq.py
new file mode 100644
index 00000000..823c83c1
--- /dev/null
+++ b/op_tests/validation/validate_rdna_wv_split_kq.py
@@ -0,0 +1,74 @@
+# SPDX-License-Identifier: MIT
+# Copyright (C) 2026, Advanced Micro Devices, Inc. All rights reserved.
+
+import torch
+
+import aiter
+
+
+SUPPORTED_ARCHITECTURES = {"gfx1100", "gfx1200", "gfx1201"}
+TEST_SHAPES = (
+    (1, 4, 16),
+    (2, 60, 96),
+    (3, 17, 6192),
+    (4, 320, 16400),
+)
+
+
+def quantize_fp8(tensor):
+    scale = tensor.abs().max().float() / torch.finfo(aiter.dtypes.fp8).max
+    ret = (tensor / scale).to(aiter.dtypes.fp8), scale
+    return ret
+
+
+def validate_shape(output_dtype, rows, columns, inner, cu_count):
+    x = torch.randn((rows, inner), dtype=output_dtype, device="cuda")
+    weight = torch.randn((columns, inner), dtype=output_dtype, device="cuda")
+    x_fp8, x_scale = quantize_fp8(x)
+    weight_fp8, weight_scale = quantize_fp8(weight)
+    reference = (
+        torch.matmul(x_fp8.float(), weight_fp8.float().t()) * x_scale * weight_scale
+    ).to(output_dtype)
+    actual = torch.empty((rows, columns), dtype=output_dtype, device="cuda")
+    aiter.wvSplitKQ(
+        weight_fp8,
+        x_fp8,
+        actual,
+        weight_scale,
+        x_scale,
+        cu_count,
+    )
+    torch.cuda.synchronize()
+    torch.testing.assert_close(actual, reference, rtol=1e-2, atol=1e-2)
+    ret = (actual.float() - reference.float()).abs().max().item()
+    return ret
+
+
+def main():
+    torch.manual_seed(137)
+    properties = torch.cuda.get_device_properties("cuda")
+    architecture = properties.gcnArchName.split(":", maxsplit=1)[0]
+    if architecture not in SUPPORTED_ARCHITECTURES:
+        raise RuntimeError(
+            f"Expected one of {sorted(SUPPORTED_ARCHITECTURES)}, found {architecture}"
+        )
+    if aiter.dtypes.fp8 != torch.float8_e4m3fn:
+        raise RuntimeError(f"Expected E4M3FN, found {aiter.dtypes.fp8}")
+
+    for output_dtype in (torch.float16, torch.bfloat16):
+        for rows, columns, inner in TEST_SHAPES:
+            max_error = validate_shape(
+                output_dtype,
+                rows,
+                columns,
+                inner,
+                properties.multi_processor_count,
+            )
+            print(
+                f"PASS architecture={architecture} dtype={output_dtype} "
+                f"shape=({rows},{columns},{inner}) max_abs_error={max_error:.8g}"
+            )
+
+
+if __name__ == "__main__":
+    main()
