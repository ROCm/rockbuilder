 }
 #endif // defined(__HIP__MI350_MI300_MI250__) TODO: Add NAVI support

+template <typename scalar_t, typename fp8_t, int N>
+__global__ void __launch_bounds__(32) wvSplitKQ_rdna_(const int K,
+                                                      const int Kp,
+                                                      const int M,
+                                                      const fp8_t* B,
+                                                      const fp8_t* __restrict__ A,
+                                                      scalar_t* C,
+                                                      const float* __restrict__ s_A,
+                                                      const float* __restrict__ s_B)
+{
+#if defined(AITER_WVSPLITKQ_RDNA_WAVE32)
+#if defined(__gfx1100__)
+    using input_t = __half;
+#else
+    using input_t = rocwmma::float8_t;
+#endif
+    using fragment_a =
+        rocwmma::fragment<rocwmma::matrix_a, 16, 16, 16, input_t, rocwmma::row_major>;
+    using fragment_b =
+        rocwmma::fragment<rocwmma::matrix_b, 16, 16, 16, input_t, rocwmma::col_major>;
+    using fragment_c = rocwmma::fragment<rocwmma::accumulator, 16, 16, 16, float>;
+
+    __shared__ input_t tile_a[16 * 16];
+    __shared__ input_t tile_b[16 * 16];
+    __shared__ float tile_c[16 * 16];
+
+    const auto* a_fp8 = reinterpret_cast<const rocwmma::float8_t*>(A);
+    const auto* b_fp8 = reinterpret_cast<const rocwmma::float8_t*>(B);
+    const int lane    = threadIdx.x;
+    const float scale = *s_A * *s_B;
+
+    for(int m = blockIdx.x * 16; m < M; m += gridDim.x * 16)
+    {
+        fragment_c accumulator;
+        rocwmma::fill_fragment(accumulator, 0.0f);
+
+        for(int k = 0; k < K; k += 16)
+        {
+            for(int i = lane; i < 16 * 16; i += 32)
+            {
+                const int row    = i / 16;
+                const int column = i % 16;
+#if defined(__gfx1100__)
+                tile_a[i] =
+                    row < N ? __float2half(static_cast<float>(a_fp8[row * K + k + column]))
+                            : __float2half(0.0f);
+                tile_b[column * 16 + row] =
+                    m + column < M
+                        ? __float2half(static_cast<float>(b_fp8[(m + column) * Kp + k + row]))
+                        : __float2half(0.0f);
+#else
+                tile_a[i] = row < N ? a_fp8[row * K + k + column] : input_t{};
+                tile_b[column * 16 + row] =
+                    m + column < M ? b_fp8[(m + column) * Kp + k + row] : input_t{};
+#endif
+            }
+            rocwmma::synchronize_workgroup();
+
+            fragment_a frag_a;
+            fragment_b frag_b;
+            rocwmma::load_matrix_sync(frag_a, tile_a, 16);
+            rocwmma::load_matrix_sync(frag_b, tile_b, 16);
+            rocwmma::mma_sync(accumulator, frag_a, frag_b, accumulator);
+            rocwmma::synchronize_workgroup();
+        }
+
+        rocwmma::store_matrix_sync(
+            tile_c, accumulator, 16, rocwmma::mem_row_major);
+        rocwmma::synchronize_workgroup();
+        for(int i = lane; i < N * 16; i += 32)
+        {
+            const int row    = i / 16;
+            const int column = i % 16;
+            if(m + column < M)
+            {
+                C[row * M + m + column] = __float2s<scalar_t>(tile_c[i] * scale);
+            }
+        }
+        rocwmma::synchronize_workgroup();
+    }
+#else
+    UNREACHABLE_CODE
+#endif
+}
