 {
 #define WVSPLITKQ(_WvPrGrp, _YTILEs, _YTILEm, _YTILEb, _UNRLs, _UNRLm, _UNRLb, _N)                 \
     {                                                                                              \
-        dim3 block(64, _WvPrGrp);                                                                  \
