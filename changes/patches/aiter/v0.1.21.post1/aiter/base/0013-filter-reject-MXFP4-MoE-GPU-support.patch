From d0a3b81dba5bcec09e78af62958c641d2469ec40 Mon Sep 17 00:00:00 2001
From: Mika Laitio <mika.laitio@amd.com>
Date: Fri, 4 Sep 2026 01:03:55 -0700
Subject: [PATCH 13/22] MXFP4 MoE GPU support

- Build MXFP4 auxiliary kernels only for gfx950
- Preserve gfx950 objects in mixed GPU builds
- Reject unsupported JIT requests before compile

Tools used:
- GPT: 5.6 Sol

Signed-off-by: Mika Laitio <mika.laitio@amd.com>
---
 aiter/jit/optCompilerConfig.json  |  3 +++
 op_tests/test_jit_module_archs.py | 10 ++++++++++
 2 files changed, 13 insertions(+)

diff --git a/aiter/jit/optCompilerConfig.json b/aiter/jit/optCompilerConfig.json
index 88accd02..9da5bad0 100644
--- a/aiter/jit/optCompilerConfig.json
+++ b/aiter/jit/optCompilerConfig.json
@@ -659,6 +659,9 @@
         "blob_gen_cmd": "''"
     },
     "module_moe_mxfp4_aux": {
+        "supported_gpu_archs": [
+            "gfx950"
+        ],
         "srcs": [
             "f'{AITER_CSRC_DIR}/kernels/mxfp4_moe/moe_mxfp4_aux.cu'",
             "f'{AITER_CSRC_DIR}/pybind/moe_mxfp4_aux_pybind.cu'"
diff --git a/op_tests/test_jit_module_archs.py b/op_tests/test_jit_module_archs.py
index 02be0041..bb054848 100644
--- a/op_tests/test_jit_module_archs.py
+++ b/op_tests/test_jit_module_archs.py
@@ -113,3 +113,13 @@ def test_opus_moe_keeps_only_gfx950(monkeypatch):
     args = core.get_args_of_build("module_moe_opus")

     assert args["gpu_archs"] == ["gfx950"]
+
+
+def test_mxfp4_moe_aux_rejects_gfx1100(monkeypatch):
+    monkeypatch.setattr(core, "get_gfx_list", lambda: ["gfx1100"])
+
+    with pytest.raises(
+        RuntimeError,
+        match=r"module_moe_mxfp4_aux.*gfx1100.*gfx950",
+    ):
+        core.get_args_of_build("module_moe_mxfp4_aux")
--
2.43.0
