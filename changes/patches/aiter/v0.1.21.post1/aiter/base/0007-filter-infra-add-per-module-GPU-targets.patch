+def _get_module_gpu_archs(
+    supported_gpu_archs: list[str] | None,
+    requested_gpu_archs: list[str] | None = None,
+) -> list[str]:
+    """Return requested GPU targets supported by one JIT module."""
+    requested = (
+        get_gfx_list() if requested_gpu_archs is None else requested_gpu_archs
+    )
+    requested = list(dict.fromkeys(requested))
+    ret_arr = requested
+    if supported_gpu_archs is not None:
+        supported = set(supported_gpu_archs)
+        ret_arr = [arch for arch in requested if arch in supported]
+    return ret_arr
+
+
+def _unsupported_module_error(
+    md_name: str,
+    requested_gpu_archs: list[str],
+    supported_gpu_archs: list[str],
+) -> RuntimeError:
+    ret = RuntimeError(
+        f"[aiter] {md_name} does not support requested GPU architectures "
+        f"{requested_gpu_archs}; supported architectures: {supported_gpu_archs}"
+    )
+    return ret
+
