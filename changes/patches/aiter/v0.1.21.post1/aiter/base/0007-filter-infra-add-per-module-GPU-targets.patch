+# SPDX-License-Identifier: MIT
+# Copyright (C) 2026, Advanced Micro Devices, Inc. All rights reserved.
+
+import json
+
+import pytest
+
+from aiter.jit import core
+
+
+def test_get_module_gpu_archs_preserves_requested_order():
+    ret_arr = core._get_module_gpu_archs(
+        ["gfx90a", "gfx942"],
+        ["gfx1100", "gfx942", "gfx90a", "gfx942"],
+    )
+
+    assert ret_arr == ["gfx942", "gfx90a"]
+
+
+def test_get_args_of_build_filters_unsupported_module(tmp_path, monkeypatch):
+    config = {
+        "module_supported": {
+            "srcs": [],
+            "supported_gpu_archs": ["gfx90a"],
+        },
+        "module_generic": {
+            "srcs": [],
+        },
+    }
+    (tmp_path / "optCompilerConfig.json").write_text(
+        json.dumps(config),
+        encoding="utf-8",
+    )
+    monkeypatch.setattr(core, "this_dir", str(tmp_path))
+    monkeypatch.setattr(core, "get_gfx_list", lambda: ["gfx1100", "gfx90a"])
+
+    modules, _ = core.get_args_of_build("all")
+
+    assert [module["md_name"] for module in modules] == [
+        "module_supported",
+        "module_generic",
+    ]
+    assert modules[0]["gpu_archs"] == ["gfx90a"]
+    assert modules[1]["gpu_archs"] == ["gfx1100", "gfx90a"]
+
+
+def test_get_args_of_build_rejects_unsupported_direct_jit(tmp_path, monkeypatch):
+    config = {
+        "module_supported": {
+            "srcs": [],
+            "supported_gpu_archs": ["gfx90a"],
+        },
+    }
+    (tmp_path / "optCompilerConfig.json").write_text(
+        json.dumps(config),
+        encoding="utf-8",
+    )
+    monkeypatch.setattr(core, "this_dir", str(tmp_path))
+    monkeypatch.setattr(core, "get_gfx_list", lambda: ["gfx1100"])
+
+    with pytest.raises(
+        RuntimeError,
+        match=r"module_supported.*gfx1100.*gfx90a",
+    ):
+        core.get_args_of_build("module_supported")
