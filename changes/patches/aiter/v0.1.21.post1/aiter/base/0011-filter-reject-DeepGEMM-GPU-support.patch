From 556ff4011fa535ccd62e11229cea8229074596e9 Mon Sep 17 00:00:00 2001
From: Mika Laitio <mika.laitio@amd.com>
Date: Fri, 4 Sep 2026 01:01:04 -0700
Subject: [PATCH 11/22] DeepGEMM GPU support

- Exclude gfx1100 from DeepGEMM code objects
- Preserve validated GPU targets in mixed builds
- Reject unsupported JIT requests before compile

Tools used:
- GPT: 5.6 Sol

Signed-off-by: Mika Laitio <mika.laitio@amd.com>
---
 aiter/jit/optCompilerConfig.json  |  7 +++++++
 op_tests/test_jit_module_archs.py | 10 ++++++++++
 2 files changed, 17 insertions(+)

diff --git a/aiter/jit/optCompilerConfig.json b/aiter/jit/optCompilerConfig.json
index edef121d..ed951118 100644
--- a/aiter/jit/optCompilerConfig.json
+++ b/aiter/jit/optCompilerConfig.json
@@ -326,6 +326,13 @@
         "blob_gen_cmd": "f'{AITER_CSRC_DIR}/ck_gemm_a8w8_bpreshuffle/gen_instances.py --working_path {{}} --tune_file {AITER_CONFIGS.AITER_CONFIG_GEMM_A8W8_BPRESHUFFLE_FILE}'"
     },
     "module_deepgemm": {
+        "supported_gpu_archs": [
+            "gfx90a",
+            "gfx940",
+            "gfx941",
+            "gfx942",
+            "gfx950"
+        ],
         "srcs": [
             "f'{AITER_CSRC_DIR}/pybind/deepgemm_pybind.cu'",
             "f'{AITER_CSRC_DIR}/ck_deepgemm/deepgemm.cu'"
diff --git a/op_tests/test_jit_module_archs.py b/op_tests/test_jit_module_archs.py
index 5f1a3a8b..a0162c74 100644
--- a/op_tests/test_jit_module_archs.py
+++ b/op_tests/test_jit_module_archs.py
@@ -91,3 +91,13 @@ def test_a8w8_bpreshuffle_cktile_rejects_gfx1100(monkeypatch):
         match=r"module_gemm_a8w8_bpreshuffle_cktile.*gfx1100",
     ):
         core.get_args_of_build("module_gemm_a8w8_bpreshuffle_cktile")
+
+
+def test_deepgemm_rejects_gfx1100(monkeypatch):
+    monkeypatch.setattr(core, "get_gfx_list", lambda: ["gfx1100"])
+
+    with pytest.raises(
+        RuntimeError,
+        match=r"module_deepgemm.*gfx1100",
+    ):
+        core.get_args_of_build("module_deepgemm")
--
2.43.0
