+# SPDX-License-Identifier: MIT
+# Copyright (C) 2026, Advanced Micro Devices, Inc. All rights reserved.
+
+import argparse
+from collections.abc import Callable
+
+import torch
+import torch.nn.functional as F
+
+import aiter
+
+
+def create_inputs(m: int, n: int, k: int) -> tuple[torch.Tensor, ...]:
+    device = torch.device("cuda")
+    x = torch.randint(-16, 17, (m, k), dtype=torch.int8, device=device)
+    weight = torch.randint(-16, 17, (n, k), dtype=torch.int8, device=device)
+    x_scale = torch.rand((m, 1), dtype=torch.float32, device=device) * 0.01
+    w_scale = torch.rand((n, 1), dtype=torch.float32, device=device) * 0.01
+    ret_arr = (x, weight, x_scale, w_scale)
+    return ret_arr
+
+
+def run_reference(
+    x: torch.Tensor,
+    weight: torch.Tensor,
+    x_scale: torch.Tensor,
+    w_scale: torch.Tensor,
+) -> torch.Tensor:
+    ret = F.linear(x.float() * x_scale, weight.float() * w_scale).bfloat16()
+    return ret
+
+
+def benchmark_ms(
+    op: Callable[[], torch.Tensor],
+    warmup: int,
+    repeat: int,
+) -> float:
+    for _ in range(warmup):
+        op()
+    torch.cuda.synchronize()
+
+    start = torch.cuda.Event(enable_timing=True)
+    end = torch.cuda.Event(enable_timing=True)
+    start.record()
+    for _ in range(repeat):
+        op()
+    end.record()
+    end.synchronize()
+    ret = start.elapsed_time(end) / repeat
+    return ret
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser(description="Compare AITER INT8 A8W8 backends")
+    parser.add_argument("--m", type=int, default=16)
+    parser.add_argument("--n", type=int, default=4096)
+    parser.add_argument("--k", type=int, default=4096)
+    parser.add_argument("--warmup", type=int, default=10)
+    parser.add_argument("--repeat", type=int, default=100)
+    args = parser.parse_args()
+
+    inputs = create_inputs(args.m, args.n, args.k)
+    reference = run_reference(*inputs)
+    backends = {
+        "default": lambda: aiter.gemm_a8w8(*inputs),
+        "cktile": lambda: aiter.gemm_a8w8_CKTile(*inputs),
+        "triton": lambda: aiter.gemm_a8w8_Triton(*inputs),
+    }
+
+    arch = torch.cuda.get_device_properties(0).gcnArchName
+    print(f"arch={arch} shape=({args.m}, {args.n}, {args.k})")
+    for name, op in backends.items():
+        output = op()
+        torch.testing.assert_close(output, reference, rtol=0.02, atol=0.02)
+        elapsed_ms = benchmark_ms(op, args.warmup, args.repeat)
+        print(f"{name}: {elapsed_ms:.6f} ms")
+
+
+if __name__ == "__main__":
+    main()
