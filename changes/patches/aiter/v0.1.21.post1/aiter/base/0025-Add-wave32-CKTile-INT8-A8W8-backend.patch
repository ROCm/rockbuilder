+// SPDX-License-Identifier: MIT
+// Copyright (C) 2026, Advanced Micro Devices, Inc. All rights reserved.
+
+#include <string>
+
+#include <torch/extension.h>
+
+#include "gemm_a8w8_cktile_common.cuh"
+#include "gemm_a8w8_cktile_manifest.h"
+
+using RowwiseKernel = torch::Tensor (*)(torch::Tensor&,
+                                        torch::Tensor&,
+                                        torch::Tensor&,
+                                        torch::Tensor&,
+                                        torch::Tensor&,
+                                        std::optional<torch::Tensor>,
+                                        int);
+
+template <typename ABDataType, typename DDataType, typename EDataType>
+RowwiseKernel rowwise_dispatch()
+{
+    RowwiseKernel ret =
+        a8w8_cktile_16x128x256_1x4x1_16x16_intrawave_0x0x0_1<ABDataType,
+                                                              DDataType,
+                                                              EDataType,
+                                                              true>;
+    return ret;
+}
+
+
+torch::Tensor gemm_a8w8_cktile(torch::Tensor& XQ,
+                               torch::Tensor& WQ,
+                               torch::Tensor& x_scale,
+                               torch::Tensor& w_scale,
+                               torch::Tensor& Y,
+                               std::optional<torch::Tensor> bias,
+                               int splitK)
+{
+    const std::string gfx = at::cuda::getCurrentDeviceProperties()->gcnArchName;
+    const bool supported_gfx = gfx.starts_with("gfx1100") || gfx.starts_with("gfx1200") ||
+                               gfx.starts_with("gfx1201");
+    TORCH_CHECK(supported_gfx,
+                "CKTile INT8 comparison supports gfx1100/gfx1200/gfx1201, got ",
+                gfx);
+    TORCH_CHECK(XQ.dtype() == at::ScalarType::Char && WQ.dtype() == at::ScalarType::Char,
+                "Weights and activations must both be int8");
+    TORCH_CHECK(x_scale.dtype() == at::ScalarType::Float &&
+                    w_scale.dtype() == at::ScalarType::Float,
+                "Scales must both be float32");
+    TORCH_CHECK(Y.dtype() == at::ScalarType::BFloat16, "Output must be bfloat16");
+    TORCH_CHECK(splitK >= 0 && splitK < 31, "splitK exponent must be in [0, 30]");
+    if(bias != std::nullopt)
+    {
+        TORCH_CHECK(bias.value().dtype() == Y.dtype(),
+                    "Output and bias must have the same dtype");
+    }
+
+    const int KBatch = 1 << splitK;
+    rowwise_dispatch<TILE_I8, TILE_FP32, TILE_BF16>()(
+        XQ, WQ, x_scale, w_scale, Y, bias, KBatch);
+    return Y;
+}
