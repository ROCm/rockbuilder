+@dataclass(frozen=True)
+class tileKernelInstance:
+    M_Tile: int
+    N_Tile: int
+    K_Tile: int
+    M_Warp: int
+    N_Warp: int
+    K_Warp: int
+    M_Warp_Tile: int
+    N_Warp_Tile: int
+    Scheduler: str
+    TiledMMAPermuteN: bool
+    TransposeC: bool
+    UsePersistentKernel: bool
+    BlockPerCu: int
+
+    @property
+    def name(self) -> str:
+        ret = "_".join(
+            [
+                "a8w8_cktile",
+                "x".join(str(x) for x in [self.M_Tile, self.N_Tile, self.K_Tile]),
+                "x".join(str(x) for x in [self.M_Warp, self.N_Warp, self.K_Warp]),
+                "x".join(str(x) for x in [self.M_Warp_Tile, self.N_Warp_Tile]),
+                self.Scheduler.lower(),
+                "x".join(
+                    str(int(x))
+                    for x in [
+                        self.TiledMMAPermuteN,
+                        self.TransposeC,
+                        self.UsePersistentKernel,
+                    ]
+                ),
+                str(self.BlockPerCu),
+            ]
+        )
+        return ret
+
+
+# Initial wave32 WMMA candidate for gfx1100 and gfx1201. Keep this separate
+# from the gfx9 CK instances until architecture-specific tuning is available.
+kernels_list_cktile = {
+    0: tileKernelInstance(
+        16,
+        128,
+        256,
+        1,
+        4,
+        1,
+        16,
+        16,
+        "Intrawave",
+        False,
+        False,
+        False,
+        1,
+    ),
+}
+
+default_kernels_dict_cktile = {-1: kernels_list_cktile[0]}
