+def gemm_a8w8_cktile(
+    XQ: torch.Tensor,
+    WQ: torch.Tensor,
+    x_scale: torch.Tensor,
+    w_scale: torch.Tensor,
+    Out: torch.Tensor,
+    bias: torch.Tensor | None = None,
+    splitK: int = 0,
+) -> torch.Tensor: ...
+
+
+def gemm_a8w8_CKTile(
+    XQ: Tensor,
+    WQ: Tensor,
+    x_scale: Tensor,
+    w_scale: Tensor,
+    bias: Tensor | None = None,
+    dtype: torch.dtype = dtypes.bf16,
+    splitK: int = 0,
+) -> Tensor:
+    """Run the experimental wave32 CKTile INT8 A8W8 comparison backend."""
+    if dtype != dtypes.bf16:
+        raise ValueError(f"CKTile INT8 comparison requires bfloat16 output, got {dtype}")
+
+    m, k = XQ.shape
+    n = WQ.shape[0]
+    if WQ.shape[1] != k:
+        raise ValueError(f"XQ and WQ K dimensions differ: {k} != {WQ.shape[1]}")
+    if x_scale.shape != (m, 1) or w_scale.shape != (n, 1):
+        raise ValueError(
+            "CKTile INT8 comparison requires x_scale[M, 1] and w_scale[N, 1], "
+            f"got {tuple(x_scale.shape)} and {tuple(w_scale.shape)}"
+        )
+
+    padded_m = ((m + 15) // 16) * 16
+    padded_n = ((n + 127) // 128) * 128
+    padded_k = ((k + 255) // 256) * 256
+    pad_m = padded_m - m
+    pad_n = padded_n - n
+    pad_k = padded_k - k
+
+    xq_padded = F.pad(XQ, (0, pad_k, 0, pad_m))
+    wq_padded = F.pad(WQ, (0, pad_k, 0, pad_n))
+    x_scale_padded = F.pad(x_scale, (0, 0, 0, pad_m))
+    w_scale_padded = F.pad(w_scale, (0, 0, 0, pad_n))
+    bias_padded = F.pad(bias, (0, pad_n)) if bias is not None else None
+    out = torch.empty(padded_m, padded_n, dtype=dtype, device=XQ.device)
+    padded_ret = gemm_a8w8_cktile(
+        xq_padded,
+        wq_padded,
+        x_scale_padded,
+        w_scale_padded,
+        out,
+        bias_padded,
+        splitK,
+    )
+    ret = padded_ret[:m, :n]
+    return ret
+
+
