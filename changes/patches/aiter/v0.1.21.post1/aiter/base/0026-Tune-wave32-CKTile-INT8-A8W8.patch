+// SPDX-License-Identifier: MIT
+// Copyright (C) 2026, Advanced Micro Devices, Inc. All rights reserved.
+
+#include <string>
+#include <unordered_map>
+
+#include <torch/extension.h>
+
+#include "gemm_a8w8_cktile_common.cuh"
+#include "gemm_a8w8_cktile_lookup.h"
+#include "gemm_a8w8_cktile_manifest.h"
+
+using RowwiseKernel = torch::Tensor (*)(torch::Tensor&,
+                                        torch::Tensor&,
+                                        torch::Tensor&,
+                                        torch::Tensor&,
+                                        torch::Tensor&,
+                                        std::optional<torch::Tensor>,
+                                        int);
+
+template <typename ABDataType, typename DDataType, typename EDataType>
+RowwiseKernel rowwise_tune_dispatch(int kernel_id)
+{
+    static const auto lookup = [] {
+        return std::unordered_map<int, RowwiseKernel>{
+            GENERATE_LOOKUP_TABLE(ABDataType, DDataType, EDataType, true)};
+    }();
+
+    const auto it = lookup.find(kernel_id);
+    TORCH_CHECK(it != lookup.end(), "Unknown CKTile A8W8 kernel id ", kernel_id);
+    RowwiseKernel ret = it->second;
+    return ret;
+}
+
+torch::Tensor gemm_a8w8_cktile_tune(torch::Tensor& XQ,
+                                    torch::Tensor& WQ,
+                                    torch::Tensor& x_scale,
+                                    torch::Tensor& w_scale,
+                                    torch::Tensor& Y,
+                                    int kernel_id,
+                                    int splitK)
+{
+    TORCH_CHECK(XQ.dtype() == at::ScalarType::Char && WQ.dtype() == at::ScalarType::Char,
+                "Weights and activations must both be int8");
+    TORCH_CHECK(x_scale.dtype() == at::ScalarType::Float &&
+                    w_scale.dtype() == at::ScalarType::Float,
+                "Scales must both be float32");
+    TORCH_CHECK(Y.dtype() == at::ScalarType::BFloat16, "Output must be bfloat16");
+    TORCH_CHECK(splitK >= 0 && splitK < 31, "splitK exponent must be in [0, 30]");
+
+    const int k_batch = 1 << splitK;
+    const std::optional<torch::Tensor> bias = std::nullopt;
+    rowwise_tune_dispatch<TILE_I8, TILE_FP32, TILE_BF16>(kernel_id)(
+        XQ, WQ, x_scale, w_scale, Y, bias, k_batch);
+    return Y;
+}
