@@ -0,0 +1,141 @@
+# SPDX-License-Identifier: MIT
+# Copyright (C) 2026, Advanced Micro Devices, Inc. All rights reserved.
+
+import argparse
+import csv
+import math
+import sys
+from collections.abc import Callable
+from pathlib import Path
+
+import torch
+import torch.nn.functional as F
+
+import aiter
+
+AITER_ROOT = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(AITER_ROOT / "csrc" / "ck_gemm_a8w8"))
+
+from gemm_a8w8_common import kernels_list_cktile  # noqa: E402
+
+
+def round_up(value: int, multiple: int) -> int:
+    ret = math.ceil(value / multiple) * multiple
+    return ret
+
+
+def create_inputs(m: int, n: int, k: int) -> tuple[torch.Tensor, ...]:
+    device = torch.device("cuda")
+    x = torch.randint(-16, 17, (m, k), dtype=torch.int8, device=device)
+    weight = torch.randint(-16, 17, (n, k), dtype=torch.int8, device=device)
+    x_scale = torch.rand((m, 1), dtype=torch.float32, device=device) * 0.01
+    w_scale = torch.rand((n, 1), dtype=torch.float32, device=device) * 0.01
+    ret_arr = (x, weight, x_scale, w_scale)
+    return ret_arr
+
+
+def pad_inputs(
+    inputs: tuple[torch.Tensor, ...],
+    kernel_id: int,
+) -> tuple[torch.Tensor, ...]:
+    x, weight, x_scale, w_scale = inputs
+    kernel = kernels_list_cktile[kernel_id]
+    m, k = x.shape
+    n = weight.shape[0]
+    m_pad = round_up(m, kernel.M_Tile)
+    n_pad = round_up(n, kernel.N_Tile)
+    k_pad = round_up(k, kernel.K_Tile)
+
+    x = F.pad(x, (0, k_pad - k, 0, m_pad - m))
+    weight = F.pad(weight, (0, k_pad - k, 0, n_pad - n))
+    x_scale = F.pad(x_scale, (0, 0, 0, m_pad - m))
+    w_scale = F.pad(w_scale, (0, 0, 0, n_pad - n))
+    out = torch.empty((m_pad, n_pad), dtype=torch.bfloat16, device=x.device)
+    ret_arr = (x, weight, x_scale, w_scale, out)
+    return ret_arr
+
+
+def benchmark_ms(op: Callable[[], torch.Tensor], warmup: int, repeat: int) -> float:
+    for _ in range(warmup):
+        op()
+    torch.cuda.synchronize()
+
+    start = torch.cuda.Event(enable_timing=True)
+    end = torch.cuda.Event(enable_timing=True)
+    start.record()
+    for _ in range(repeat):
+        op()
+    end.record()
+    end.synchronize()
+    ret = start.elapsed_time(end) / repeat
+    return ret
+
+
+def validate_candidates() -> None:
+    m, n, k = 17, 130, 260
+    inputs = create_inputs(m, n, k)
+    x, weight, x_scale, w_scale = inputs
+    reference = F.linear(x.float() * x_scale, weight.float() * w_scale).bfloat16()
+
+    for kernel_id in kernels_list_cktile:
+        padded = pad_inputs(inputs, kernel_id)
+        output = aiter.gemm_a8w8_cktile_tune(*padded, kernel_id, 0)[:m, :n]
+        torch.testing.assert_close(output, reference, rtol=0.02, atol=0.02)
+        print(f"validated kernel {kernel_id}: {kernels_list_cktile[kernel_id].name}")
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser(description="Tune wave32 CKTile INT8 A8W8 GEMM")
+    parser.add_argument("--m-values", default="1,32,64,128,256,512,1024,2048,4096")
+    parser.add_argument("--warmup", type=int, default=5)
+    parser.add_argument("--repeat", type=int, default=25)
+    parser.add_argument("--output", type=Path, default=Path("cktile_tuning.csv"))
+    args = parser.parse_args()
+
+    arch = torch.cuda.get_device_properties(0).gcnArchName
+    cu_count = torch.cuda.get_device_properties(0).multi_processor_count
+    supported_arch = any(arch.startswith(prefix) for prefix in ("gfx1100", "gfx1200", "gfx1201"))
+    if not supported_arch:
+        raise RuntimeError(f"This tuning run requires a wave32 gfx11/gfx12 GPU, got {arch}")
+    print(f"arch={arch} cu_count={cu_count}")
+
+    validate_candidates()
+    m_values = [int(value) for value in args.m_values.split(",")]
+    shapes = [(m, n, k) for n, k in [(1280, 8192), (8192, 1024)] for m in m_values]
+    fieldnames = ["arch", "cu_count", "M", "N", "K", "kernelId", "kernelName", "ms"]
+    rows = []
+
+    for m, n, k in shapes:
+        inputs = create_inputs(m, n, k)
+        shape_rows = []
