@@ -0,0 +1,224 @@
+# SPDX-License-Identifier: MIT
+# Copyright (C) 2026, Advanced Micro Devices, Inc. All rights reserved.
+
+from dataclasses import replace
+
+import pytest
+import torch
+
+import aiter
+from aiter.fused_moe import fused_moe
+from aiter.jit.utils.chip_info import get_gfx
+from aiter.ops.flydsl.moe_common import GateMode
+from aiter.ops.gfx1100_quant2 import (
+    Gfx1100Quant2Problem,
+    gfx1100_auto_prefers_ck,
+    gfx1100_backend,
+    gfx1100_ck_supports,
+)
+from aiter.ops.shuffle import shuffle_weight
+from op_tests import test_gfx11_dynamic_int8_moe as gfx11_tests
+from op_tests.test_gfx11_dynamic_int8_moe import _make_case, _reference
+from op_tests.test_gfx11_quant2_wmma import _make_runtime_case, _run_case, _with_guard
+
+
+def _base_problem():
+    return Gfx1100Quant2Problem(
+        arch="gfx1100",
+        token_count=16,
+        model_dim=256,
+        inter_dim=512,
+        expert_count=4,
+        topk=2,
+        input_dtype=torch.bfloat16,
+        output_dtype=torch.bfloat16,
+        activation=aiter.ActivationType.Silu.value,
+        quant_type=aiter.QuantType.per_Token.value,
+        q_dtype_a=torch.int8,
+        q_dtype_w=torch.int8,
+        is_gated=True,
+        gate_mode=GateMode.SEPARATED.value,
+        doweight_stage1=False,
+        w1_preshuffled=True,
+        w2_preshuffled=True,
+        has_weight_scales=True,
+        has_a1_scale=False,
+        has_a2_scale=False,
+        has_bias=False,
+        expert_parallel=False,
+        has_num_local_tokens=False,
+        stage2_scatter=False,
+        hidden_pad=0,
+        intermediate_pad=0,
+    )
+
+
+def test_gfx1100_capability_and_auto_selection(monkeypatch):
+    problem = _base_problem()
+    assert gfx1100_ck_supports(problem)
+    assert gfx1100_auto_prefers_ck(problem)
+    assert not gfx1100_auto_prefers_ck(
+        replace(
+            problem,
+            model_dim=4096,
+            inter_dim=14336,
+            expert_count=8,
+        )
+    )
+    assert not gfx1100_auto_prefers_ck(replace(problem, has_bias=True))
+    assert not gfx1100_ck_supports(replace(problem, arch="gfx1201"))
+    assert not gfx1100_ck_supports(replace(problem, has_weight_scales=False))
+
+    monkeypatch.setenv("AITER_GFX1100_QUANT2_BACKEND", "auto")
+    assert gfx1100_backend(problem) == "ck"
+    assert (
+        gfx1100_backend(
+            replace(
+                problem,
+                model_dim=4096,
+                inter_dim=14336,
+                expert_count=8,
+            )
+        )
+        == "triton"
+    )
+    assert gfx1100_auto_prefers_ck(
+        replace(
+            problem,
+            token_count=64,
+            model_dim=2048,
+            inter_dim=1024,
+            expert_count=8,
+        )
+    )
+    monkeypatch.setenv("AITER_GFX1100_QUANT2_BACKEND", "triton")
+    assert gfx1100_backend(problem) == "triton"
+    monkeypatch.setenv("AITER_GFX1100_QUANT2_BACKEND", "ck")
+    with pytest.raises(ValueError, match="requires weight scales"):
+        gfx1100_backend(replace(problem, has_weight_scales=False))
+
+
+@pytest.mark.parametrize("backend", ["auto", "ck", "triton"])
+@pytest.mark.parametrize(
+    (
+        "is_gated,gate_mode,activation,with_bias,doweight_stage1,"
+        "expert_parallel,preshuffled"
+    ),
+    [
+        (True, GateMode.SEPARATED, aiter.ActivationType.Silu, True, False, False, True),
+        (True, GateMode.INTERLEAVE, aiter.ActivationType.Swiglu, True, True, False, True),
+        (False, GateMode.SEPARATED, aiter.ActivationType.GeluTanh, True, False, False, True),
+        (True, GateMode.SEPARATED, aiter.ActivationType.Silu, True, True, True, True),
+        (True, GateMode.SEPARATED, aiter.ActivationType.Gelu, True, False, False, False),
+        (True, GateMode.INTERLEAVE, aiter.ActivationType.Situv2, False, False, False, False),
+        (True, GateMode.INTERLEAVE, aiter.ActivationType.Silu, True, False, False, True),
+        (False, GateMode.SEPARATED, aiter.ActivationType.Silu, False, True, False, False),
+    ],
+)
+def test_gfx1100_feature_parity(
+    monkeypatch,
+    backend,
+    is_gated,
+    gate_mode,
+    activation,
+    with_bias,
+    doweight_stage1,
+    expert_parallel,
+    preshuffled,
+):
+    if get_gfx() != "gfx1100":
+        pytest.skip("gfx1100-only Quant2 validation")
+
+    monkeypatch.setenv("AITER_GFX1100_QUANT2_BACKEND", backend)
+    case = _make_case(is_gated, gate_mode, with_bias, expert_parallel)
+    num_local_tokens = 5 if expert_parallel else case["hidden"].shape[0]
+    if expert_parallel:
+        case["topk_ids"][num_local_tokens:] = case["expert_mask"].numel() + 17
+    if preshuffled:
+        w1 = shuffle_weight(case["w1_q"], layout=(16, 16))
+        w2 = shuffle_weight(case["w2_q"], layout=(16, 16))
+    else:
+        w1, w2 = case["w1_q"], case["w2_q"]
+    actual = fused_moe(
+        case["hidden"],
+        w1,
+        w2,
+        case["topk_weights"],
+        case["topk_ids"],
+        expert_mask=case["expert_mask"],
+        activation=activation,
+        quant_type=aiter.QuantType.per_Token,
+        doweight_stage1=doweight_stage1,
+        w1_scale=case["w1_scale"],
+        w2_scale=case["w2_scale"],
+        num_local_tokens=torch.tensor(
+            [num_local_tokens],
+            device="cuda",
+            dtype=torch.int32,
+        ),
+        bias1=case["bias1"],
+        bias2=case["bias2"],
+        gate_mode=gate_mode.value,
+    )
+    expected = _reference(
+        case["hidden_q"],
+        case["hidden_scale"],
+        case["w1_q"],
+        case["w1_scale"],
+        case["w2_q"],
+        case["w2_scale"],
+        case["topk_weights"],
+        case["topk_ids"],
+        activation,
+        gate_mode,
+        case["bias1"],
+        case["bias2"],
+        doweight_stage1,
+        case["expert_mask"],
+        num_local_tokens,
+    )
+    torch.testing.assert_close(actual, expected, rtol=0.08, atol=24)
+
+
+@pytest.mark.parametrize("backend", ["auto", "ck", "triton"])
+@pytest.mark.parametrize(
+    "shape",
+    [
+        (1, 1, True, 256, 512, 4),
+        (17, 1, True, 256, 512, 4),
+        (16, 2, False, 288, 544, 4),
+        (16, 2, False, 4096, 14336, 8),
+    ],
+)
+def test_gfx1100_guards_tails_and_determinism(monkeypatch, backend, shape):
+    if get_gfx() != "gfx1100":
+        pytest.skip("gfx1100-only Quant2 validation")
+
+    monkeypatch.setenv("AITER_GFX1100_QUANT2_BACKEND", backend)
+    case = list(_make_runtime_case(*shape))
+    case[1] = _with_guard(case[1])
+    case[2] = _with_guard(case[2])
+    case = tuple(case)
+    output = _run_case(case)
+    repeated = _run_case(case)
+    torch.testing.assert_close(repeated, output, rtol=0, atol=0)
+
+
+@pytest.mark.parametrize("backend", ["ck", "triton"])
+def test_gfx1100_prequantized_and_fixed_scales(monkeypatch, backend):
+    if get_gfx() != "gfx1100":
+        pytest.skip("gfx1100-only Quant2 validation")
+
+    monkeypatch.setenv("AITER_GFX1100_QUANT2_BACKEND", backend)
+    monkeypatch.setattr(gfx11_tests, "get_gfx", lambda: "gfx11-test")
+    gfx11_tests.test_gfx11_dynamic_int8_prequantized_input()
+
+
+@pytest.mark.parametrize("backend", ["ck", "triton"])
+def test_gfx1100_stage2_scatter(monkeypatch, backend):
+    if get_gfx() != "gfx1100":
+        pytest.skip("gfx1100-only Quant2 validation")
+
+    monkeypatch.setenv("AITER_GFX1100_QUANT2_BACKEND", backend)
+    monkeypatch.setattr(gfx11_tests, "get_gfx", lambda: "gfx11-test")
+    gfx11_tests.test_gfx11_dynamic_int8_stage2_scatter()
