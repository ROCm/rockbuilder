+#pragma once
+// SPDX-License-Identifier: MIT
+// Copyright (C) 2026, Advanced Micro Devices, Inc. All rights reserved.
+
+#include "ck_tile/core.hpp"
+#include "ck_tile/ops/gemm/warp/warp_gemm_attribute_wmma_impl_8bit_traits.hpp"
+#include <ATen/hip/HIPContext.h>
+#include <hip/hip_runtime.h>
+#include <torch/extension.h>
+
+namespace gfx11_quant2_full {
+
+inline constexpr char kStage1KernelName[] =
+    "gfx1100_quant2_wmma_full_stage1";
+inline constexpr char kStage1LinearRawKernelName[] =
+    "gfx1100_quant2_wmma_stage1_linear_raw";
+inline constexpr char kStage1LinearShuffledKernelName[] =
+    "gfx1100_quant2_wmma_stage1_linear_shuffled";
+inline constexpr char kStage2KernelName[] =
+    "gfx1100_quant2_wmma_full_stage2";
+inline constexpr char kStage2RawKernelName[] =
+    "gfx1100_quant2_wmma_stage2_raw";
+
+using index_t = ck_tile::index_t;
+using WmmaTraits =
+    ck_tile::WmmaTraits<ck_tile::gfx11_t, int8_t, int8_t, int32_t, 16, 16, 16>;
+using AVec = WmmaTraits::AVecType;
+using BVec = WmmaTraits::BVecType;
+using CVec = WmmaTraits::CVecType;
+
+CK_TILE_DEVICE index_t operand_row(index_t lane)
+{
+    const index_t lane16 = lane & 15;
+    return ((lane16 & 1) << 3) | (lane16 >> 1);
+}
+
+CK_TILE_DEVICE index_t operand_k_offset(index_t lane)
+{
+    ck_tile::ignore = lane;
+    return 0;
+}
+
+CK_TILE_DEVICE index_t shuffled_weight_offset(
+    index_t expert, index_t output, index_t k_chunk, index_t output_size, index_t K)
+{
+    const index_t expert_offset = expert * output_size * K;
+    const index_t tile_offset   = ((output / 16) * (K / 16) + k_chunk) * 16 * 16;
+    return expert_offset + tile_offset + (output & 15) * 16;
+}
+
+CK_TILE_DEVICE index_t raw_weight_offset(
+    index_t expert, index_t output, index_t k, index_t output_size, index_t K)
+{
+    return (expert * output_size + output) * K + k;
+}
+
+CK_TILE_DEVICE index_t route_token(index_t sorted_id) { return sorted_id & 0x00ffffff; }
+
+CK_TILE_DEVICE index_t route_slot(index_t sorted_id) { return (sorted_id >> 24) & 0xff; }
+
+__global__ void stage1_kernel(const int8_t* input,
+                              const int8_t* weight,
+                              const float* input_scale,
+                              const float* weight_scale,
+                              const int32_t* sorted_ids,
+                              const int32_t* sorted_expert_ids,
+                              const int32_t* num_valid_ids,
+                              ck_tile::bf16_t* output,
+                              index_t token_count,
+                              index_t topk,
+                              index_t inter_dim,
+                              index_t K)
+{
+    const index_t lane         = threadIdx.x;
+    const index_t input_row    = operand_row(lane);
+    const index_t input_k      = operand_k_offset(lane);
+    const index_t output_row   = (lane >> 4) * 8;
+    const index_t sorted_block = blockIdx.y * 16;
+    const index_t output_col   = blockIdx.x * 16 + (lane & 15);
+    const index_t max_routes   = num_valid_ids[0];
+
+    if(sorted_block >= max_routes || output_col >= inter_dim)
+        return;
+
+    const index_t expert = sorted_expert_ids[blockIdx.y];
+    CVec gate_acc{};
+    CVec up_acc{};
+    for(index_t k = 0; k < K; k += 16)
+    {
+        const index_t sorted_pos = sorted_block + input_row;
+        AVec a_vec{};
+        if(sorted_pos < max_routes)
+        {
+            const index_t sorted_id = sorted_ids[sorted_pos];
+            const index_t token     = route_token(sorted_id);
+            if(token < token_count)
+                a_vec = *reinterpret_cast<const AVec*>(input + token * K + k + input_k);
+        }
+
+        const index_t k_chunk = k / 16;
+        const index_t gate_offset =
+            shuffled_weight_offset(expert, output_col, k_chunk, inter_dim * 2, K);
+        const index_t up_offset =
+            shuffled_weight_offset(expert, output_col + inter_dim, k_chunk, inter_dim * 2, K);
+        const BVec gate_vec = *reinterpret_cast<const BVec*>(weight + gate_offset + input_k);
+        const BVec up_vec   = *reinterpret_cast<const BVec*>(weight + up_offset + input_k);
+        gate_acc = WmmaTraits::wmma_intrinsic(a_vec, gate_vec, gate_acc);
+        up_acc   = WmmaTraits::wmma_intrinsic(a_vec, up_vec, up_acc);
+    }
+
+    for(index_t i = 0; i < 8; ++i)
+    {
+        const index_t sorted_pos = sorted_block + output_row + i;
+        if(sorted_pos < max_routes)
+        {
+            const index_t sorted_id = sorted_ids[sorted_pos];
+            const index_t token     = route_token(sorted_id);
+            const index_t slot      = route_slot(sorted_id);
+            if(token < token_count && slot < topk)
+            {
+                const index_t route = token * topk + slot;
+                const float scale_a = input_scale[token];
+                const float gate_scale =
+                    weight_scale[expert * inter_dim * 2 + output_col];
+                const float up_scale =
+                    weight_scale[expert * inter_dim * 2 + output_col + inter_dim];
+                float gate = static_cast<float>(gate_acc[i]) * scale_a * gate_scale;
+                const float up = static_cast<float>(up_acc[i]) * scale_a * up_scale;
+                gate = gate / (1.0f + ck_tile::exp(-gate));
+                output[route * inter_dim + output_col] =
+                    ck_tile::type_convert<ck_tile::bf16_t>(gate * up);
+            }
+        }
+    }
+}
+
+__global__ void stage1_linear_kernel(const int8_t* input,
+                                     const int8_t* weight,
+                                     const float* input_scale,
+                                     const float* weight_scale,
+                                     const float* sorted_weights,
+                                     const float* bias,
+                                     const int32_t* sorted_ids,
+                                     const int32_t* sorted_expert_ids,
+                                     const int32_t* num_valid_ids,
+                                     float* output,
+                                     index_t token_count,
+                                     index_t topk,
+                                     index_t output_dim,
+                                     index_t K,
+                                     bool preshuffled)
+{
+    const index_t lane         = threadIdx.x;
+    const index_t input_row    = operand_row(lane);
+    const index_t input_k      = operand_k_offset(lane);
+    const index_t output_row   = (lane >> 4) * 8;
+    const index_t sorted_block = blockIdx.y * 16;
+    const index_t output_col   = blockIdx.x * 16 + (lane & 15);
+    const index_t max_routes   = num_valid_ids[0];
+
+    if(sorted_block >= max_routes || output_col >= output_dim)
+        return;
+
+    const index_t expert = sorted_expert_ids[blockIdx.y];
+    CVec acc{};
+    for(index_t k = 0; k < K; k += 16)
+    {
+        const index_t sorted_pos = sorted_block + input_row;
+        AVec a_vec{};
+        if(sorted_pos < max_routes)
+        {
+            const index_t sorted_id = sorted_ids[sorted_pos];
+            const index_t token     = route_token(sorted_id);
+            if(token < token_count)
+                a_vec = *reinterpret_cast<const AVec*>(input + token * K + k + input_k);
+        }
+
+        const index_t weight_offset =
+            preshuffled
+                ? shuffled_weight_offset(expert, output_col, k / 16, output_dim, K)
+                : raw_weight_offset(expert, output_col, k, output_dim, K);
+        const BVec b_vec = *reinterpret_cast<const BVec*>(weight + weight_offset + input_k);
+        acc = WmmaTraits::wmma_intrinsic(a_vec, b_vec, acc);
+    }
+
+    for(index_t i = 0; i < 8; ++i)
+    {
+        const index_t sorted_pos = sorted_block + output_row + i;
+        if(sorted_pos < max_routes)
+        {
+            const index_t sorted_id = sorted_ids[sorted_pos];
+            const index_t token     = route_token(sorted_id);
+            const index_t slot      = route_slot(sorted_id);
+            if(token < token_count && slot < topk)
+            {
+                const index_t route = token * topk + slot;
+                float value = static_cast<float>(acc[i]) * input_scale[token] *
+                              weight_scale[expert * output_dim + output_col];
+                if(sorted_weights != nullptr)
+                    value *= sorted_weights[sorted_pos];
+                if(bias != nullptr)
+                    value += bias[expert * output_dim + output_col];
+                output[route * output_dim + output_col] = value;
+            }
+        }
+    }
+}
+
+__global__ void stage2_kernel(const int8_t* input,
+                              const int8_t* weight,
+                              const float* input_scale,
+                              const float* weight_scale,
+                              const float* sorted_weights,
+                              const float* bias,
+                              const int32_t* sorted_ids,
+                              const int32_t* sorted_expert_ids,
+                              const int32_t* num_valid_ids,
+                              ck_tile::bf16_t* output,
+                              index_t token_count,
+                              index_t topk,
+                              index_t output_dim,
+                              index_t K,
+                              bool preshuffled)
+{
+    const index_t lane         = threadIdx.x;
+    const index_t input_row    = operand_row(lane);
+    const index_t input_k      = operand_k_offset(lane);
+    const index_t output_row   = (lane >> 4) * 8;
+    const index_t sorted_block = blockIdx.y * 16;
+    const index_t output_col   = blockIdx.x * 16 + (lane & 15);
+    const index_t max_routes   = num_valid_ids[0];
+
+    if(sorted_block >= max_routes || output_col >= output_dim)
+        return;
+
+    const index_t expert = sorted_expert_ids[blockIdx.y];
+    CVec acc{};
+    for(index_t k = 0; k < K; k += 16)
+    {
+        const index_t sorted_pos = sorted_block + input_row;
+        AVec a_vec{};
+        if(sorted_pos < max_routes)
+        {
+            const index_t sorted_id = sorted_ids[sorted_pos];
+            const index_t token     = route_token(sorted_id);
+            const index_t slot      = route_slot(sorted_id);
+            if(token < token_count && slot < topk)
+            {
+                const index_t route = token * topk + slot;
+                a_vec = *reinterpret_cast<const AVec*>(input + route * K + k + input_k);
+            }
+        }
+
+        const index_t weight_offset =
+            preshuffled
+                ? shuffled_weight_offset(expert, output_col, k / 16, output_dim, K)
+                : raw_weight_offset(expert, output_col, k, output_dim, K);
+        const BVec b_vec = *reinterpret_cast<const BVec*>(weight + weight_offset + input_k);
+        acc = WmmaTraits::wmma_intrinsic(a_vec, b_vec, acc);
+    }
+
+    for(index_t i = 0; i < 8; ++i)
+    {
+        const index_t sorted_pos = sorted_block + output_row + i;
+        if(sorted_pos < max_routes)
+        {
+            const index_t sorted_id = sorted_ids[sorted_pos];
+            const index_t token     = route_token(sorted_id);
+            const index_t slot      = route_slot(sorted_id);
+            if(token < token_count && slot < topk)
+            {
+                const index_t route = token * topk + slot;
+                float value = static_cast<float>(acc[i]) * input_scale[route] *
+                              weight_scale[expert * output_dim + output_col];
+                if(bias != nullptr)
+                    value += bias[expert * output_dim + output_col];
+                if(sorted_weights != nullptr)
+                    value *= sorted_weights[sorted_pos];
+                output[route * output_dim + output_col] =
+                    ck_tile::type_convert<ck_tile::bf16_t>(value);
+            }
+        }
+    }
+}
+
+inline torch::Tensor stage1(torch::Tensor& input,
+                            torch::Tensor& weight,
+                            torch::Tensor& output,
+                            torch::Tensor& sorted_ids,
+                            torch::Tensor& sorted_expert_ids,
+                            torch::Tensor& num_valid_ids,
+                            int topk,
+                            torch::Tensor& input_scale,
+                            torch::Tensor& weight_scale)
+{
+    TORCH_CHECK(input.is_contiguous() && weight.is_contiguous() && output.is_contiguous(),
+                "gfx11 full Quant2 stage1 requires contiguous tensors");
+    TORCH_CHECK(input_scale.scalar_type() == at::ScalarType::Float &&
+                    weight_scale.scalar_type() == at::ScalarType::Float,
+                "gfx11 full Quant2 stage1 scales must be fp32");
+    const index_t token_count = input.size(0);
+    const index_t inter_dim   = output.size(-1);
+    const index_t K           = input.size(-1);
+    TORCH_CHECK(K % 16 == 0 && inter_dim % 16 == 0,
+                "gfx11 full Quant2 stage1 dimensions must be divisible by 16");
+    const dim3 grid((inter_dim + 15) / 16, sorted_expert_ids.numel(), 1);
+    const dim3 block(32, 1, 1);
+    hipLaunchKernelGGL(stage1_kernel,
+                       grid,
+                       block,
+                       0,
+                       at::hip::getCurrentHIPStreamMasqueradingAsCUDA().stream(),
+                       static_cast<const int8_t*>(input.data_ptr()),
+                       static_cast<const int8_t*>(weight.data_ptr()),
+                       static_cast<const float*>(input_scale.data_ptr()),
+                       static_cast<const float*>(weight_scale.data_ptr()),
+                       static_cast<const int32_t*>(sorted_ids.data_ptr()),
+                       static_cast<const int32_t*>(sorted_expert_ids.data_ptr()),
+                       static_cast<const int32_t*>(num_valid_ids.data_ptr()),
+                       static_cast<ck_tile::bf16_t*>(output.data_ptr()),
+                       token_count,
+                       topk,
+                       inter_dim,
+                       K);
+    const hipError_t error = hipGetLastError();
+    TORCH_CHECK(error == hipSuccess,
+                "gfx11 full Quant2 stage1 launch failed: ",
+                hipGetErrorString(error));
+    return output;
+}
+
+inline torch::Tensor stage1_linear(torch::Tensor& input,
+                                   torch::Tensor& weight,
+                                   torch::Tensor& output,
+                                   torch::Tensor& sorted_ids,
+                                   torch::Tensor& sorted_expert_ids,
+                                   torch::Tensor& num_valid_ids,
+                                   int topk,
+                                   std::optional<torch::Tensor> sorted_weights,
+                                   torch::Tensor& input_scale,
+                                   torch::Tensor& weight_scale,
+                                   std::optional<torch::Tensor> bias,
+                                   bool preshuffled)
+{
+    TORCH_CHECK(input.is_contiguous() && weight.is_contiguous() && output.is_contiguous(),
+                "gfx11 full Quant2 stage1 linear requires contiguous tensors");
+    TORCH_CHECK(output.scalar_type() == at::ScalarType::Float,
+                "gfx11 full Quant2 stage1 linear output must be fp32");
+    const index_t token_count = input.size(0);
+    const index_t output_dim  = output.size(-1);
+    const index_t K           = input.size(-1);
+    TORCH_CHECK(K % 16 == 0 && output_dim % 16 == 0,
+                "gfx11 full Quant2 stage1 linear dimensions must be divisible by 16");
+    const dim3 grid((output_dim + 15) / 16, sorted_expert_ids.numel(), 1);
+    const dim3 block(32, 1, 1);
+    hipLaunchKernelGGL(stage1_linear_kernel,
+                       grid,
+                       block,
+                       0,
+                       at::hip::getCurrentHIPStreamMasqueradingAsCUDA().stream(),
+                       static_cast<const int8_t*>(input.data_ptr()),
+                       static_cast<const int8_t*>(weight.data_ptr()),
+                       static_cast<const float*>(input_scale.data_ptr()),
+                       static_cast<const float*>(weight_scale.data_ptr()),
+                       sorted_weights.has_value()
+                           ? static_cast<const float*>(sorted_weights.value().data_ptr())
+                           : nullptr,
+                       bias.has_value() ? static_cast<const float*>(bias.value().data_ptr())
+                                        : nullptr,
+                       static_cast<const int32_t*>(sorted_ids.data_ptr()),
+                       static_cast<const int32_t*>(sorted_expert_ids.data_ptr()),
+                       static_cast<const int32_t*>(num_valid_ids.data_ptr()),
+                       static_cast<float*>(output.data_ptr()),
+                       token_count,
+                       topk,
+                       output_dim,
+                       K,
+                       preshuffled);
+    const hipError_t error = hipGetLastError();
+    TORCH_CHECK(error == hipSuccess,
+                "gfx11 full Quant2 stage1 linear launch failed: ",
+                hipGetErrorString(error));
+    return output;
+}
+
+inline torch::Tensor stage2(torch::Tensor& input,
+                            torch::Tensor& weight,
+                            torch::Tensor& output,
+                            torch::Tensor& sorted_ids,
+                            torch::Tensor& sorted_expert_ids,
+                            torch::Tensor& num_valid_ids,
+                            int topk,
+                            std::optional<torch::Tensor> sorted_weights,
+                            torch::Tensor& input_scale,
+                            torch::Tensor& weight_scale,
+                            std::optional<torch::Tensor> bias,
+                            bool preshuffled)
+{
+    TORCH_CHECK(input.is_contiguous() && weight.is_contiguous() && output.is_contiguous(),
+                "gfx11 full Quant2 stage2 requires contiguous tensors");
+    TORCH_CHECK(input_scale.scalar_type() == at::ScalarType::Float &&
+                    weight_scale.scalar_type() == at::ScalarType::Float,
+                "gfx11 full Quant2 stage2 scales must be fp32");
+    const index_t token_count = input.size(0);
+    const index_t output_dim  = output.size(-1);
+    const index_t K           = input.size(-1);
+    TORCH_CHECK(K % 16 == 0 && output_dim % 16 == 0,
+                "gfx11 full Quant2 stage2 dimensions must be divisible by 16");
+    const dim3 grid((output_dim + 15) / 16, sorted_expert_ids.numel(), 1);
+    const dim3 block(32, 1, 1);
+    hipLaunchKernelGGL(stage2_kernel,
+                       grid,
+                       block,
+                       0,
+                       at::hip::getCurrentHIPStreamMasqueradingAsCUDA().stream(),
+                       static_cast<const int8_t*>(input.data_ptr()),
+                       static_cast<const int8_t*>(weight.data_ptr()),
+                       static_cast<const float*>(input_scale.data_ptr()),
+                       static_cast<const float*>(weight_scale.data_ptr()),
+                       sorted_weights.has_value()
+                           ? static_cast<const float*>(sorted_weights.value().data_ptr())
+                           : nullptr,
+                       bias.has_value() ? static_cast<const float*>(bias.value().data_ptr())
+                                        : nullptr,
+                       static_cast<const int32_t*>(sorted_ids.data_ptr()),
+                       static_cast<const int32_t*>(sorted_expert_ids.data_ptr()),
+                       static_cast<const int32_t*>(num_valid_ids.data_ptr()),
+                       static_cast<ck_tile::bf16_t*>(output.data_ptr()),
+                       token_count,
+                       topk,
+                       output_dim,
+                       K,
+                       preshuffled);
+    const hipError_t error = hipGetLastError();
+    TORCH_CHECK(error == hipSuccess,
+                "gfx11 full Quant2 stage2 launch failed: ",
+                hipGetErrorString(error));
+    return output;
+}
+
+} // namespace gfx11_quant2_full
