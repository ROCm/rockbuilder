diff --git a/aiter/ops/gfx1100_quant2.py b/aiter/ops/gfx1100_quant2.py
new file mode 100644
index 00000000..23f91552
--- /dev/null
+++ b/aiter/ops/gfx1100_quant2.py
@@ -0,0 +1,353 @@
+# SPDX-License-Identifier: MIT
+# Copyright (C) 2026, Advanced Micro Devices, Inc. All rights reserved.
+
+import os
+from dataclasses import dataclass
+
+import torch
+
+from aiter.ops.enum import ActivationType
+from aiter.ops.flydsl.moe_common import GateMode
+
+
+GFX1100_STAGE1_KERNEL = "gfx1100_quant2_wmma_full_stage1"
+GFX1100_STAGE1_LINEAR_RAW_KERNEL = "gfx1100_quant2_wmma_stage1_linear_raw"
+GFX1100_STAGE1_LINEAR_SHUFFLED_KERNEL = (
+    "gfx1100_quant2_wmma_stage1_linear_shuffled"
+)
+GFX1100_STAGE2_KERNEL = "gfx1100_quant2_wmma_full_stage2"
+GFX1100_STAGE2_RAW_KERNEL = "gfx1100_quant2_wmma_stage2_raw"
+_BACKEND_ENV = "AITER_GFX1100_QUANT2_BACKEND"
+
+
+@dataclass(frozen=True)
+class Gfx1100Quant2Problem:
+    arch: str
+    token_count: int
+    model_dim: int
+    inter_dim: int
+    expert_count: int
+    topk: int
+    input_dtype: torch.dtype
+    output_dtype: torch.dtype
+    activation: int
+    quant_type: int
+    q_dtype_a: torch.dtype
+    q_dtype_w: torch.dtype
+    is_gated: bool
+    gate_mode: str
+    doweight_stage1: bool
+    w1_preshuffled: bool
+    w2_preshuffled: bool
+    has_weight_scales: bool
+    has_a1_scale: bool
+    has_a2_scale: bool
+    has_bias: bool
+    expert_parallel: bool
+    has_num_local_tokens: bool
+    stage2_scatter: bool
+    hidden_pad: int
+    intermediate_pad: int
+
+
+def gfx1100_ck_supports(problem: Gfx1100Quant2Problem) -> bool:
+    activation = ActivationType(problem.activation)
+    activation_supported = activation in (
+        ActivationType.Silu,
+        ActivationType.Gelu,
+        ActivationType.GeluTanh,
+        ActivationType.No,
+    ) or (
+        problem.is_gated
+        and activation in (ActivationType.Swiglu, ActivationType.Situv2)
+    )
+    ret = (
+        problem.arch == "gfx1100"
+        and problem.output_dtype == torch.bfloat16
+        and problem.input_dtype in (torch.bfloat16, torch.int8)
+        and problem.quant_type == 2
+        and problem.q_dtype_a == torch.int8
+        and problem.q_dtype_w == torch.int8
+        and problem.gate_mode in (
+            GateMode.SEPARATED.value,
+            GateMode.INTERLEAVE.value,
+        )
+        and problem.w1_preshuffled == problem.w2_preshuffled
+        and problem.has_weight_scales
+        and (problem.input_dtype != torch.int8 or problem.has_a1_scale)
+        and activation_supported
+        and problem.model_dim % 16 == 0
+        and problem.inter_dim % 16 == 0
+        and problem.hidden_pad == 0
+        and problem.intermediate_pad == 0
+    )
+    return ret
+
+
+def gfx1100_auto_prefers_ck(problem: Gfx1100Quant2Problem) -> bool:
+    ret = False
+    simple = (
+        problem.is_gated
+        and problem.gate_mode == GateMode.SEPARATED.value
+        and problem.activation == ActivationType.Silu.value
+        and not problem.doweight_stage1
+        and problem.w1_preshuffled
+        and not problem.has_bias
+        and not problem.expert_parallel
+        and not problem.has_num_local_tokens
+        and not problem.stage2_scatter
+        and not problem.has_a1_scale
+        and not problem.has_a2_scale
+    )
+    if simple:
+        shape = (
+            problem.token_count,
+            problem.model_dim,
+            problem.inter_dim,
+            problem.expert_count,
+            problem.topk,
+        )
+        ret = shape in (
+            (1, 256, 512, 4, 1),
+            (7, 256, 512, 4, 1),
+            (16, 256, 512, 4, 2),
+            (16, 288, 544, 4, 2),
+            (17, 256, 512, 4, 1),
+            (33, 256, 512, 4, 1),
+            (1, 2048, 1024, 8, 2),
+            (16, 2048, 1024, 8, 2),
+            (64, 2048, 1024, 8, 2),
+        )
+    return ret
+
+
+def gfx1100_backend(problem: Gfx1100Quant2Problem) -> str:
+    requested = os.environ.get(_BACKEND_ENV, "auto").lower()
+    if requested not in ("auto", "ck", "triton"):
+        raise ValueError(
+            f"{_BACKEND_ENV} must be auto, ck, or triton; got {requested!r}"
+        )
+    if requested == "ck" and not problem.has_weight_scales:
+        raise ValueError("gfx1100 dynamic INT8 MoE requires weight scales")
+    if (
+        requested == "ck"
+        and not problem.is_gated
+        and problem.activation
+        in (ActivationType.Swiglu.value, ActivationType.Situv2.value)
+    ):
+        activation = ActivationType(problem.activation)
+        raise ValueError(f"{activation.name} requires gated MoE weights")
+    supported = gfx1100_ck_supports(problem)
+    if requested == "ck" and not supported:
+        raise ValueError("forced gfx1100 CK Quant2 does not support this problem")
+    if requested == "auto":
+        ret = "ck" if supported and gfx1100_auto_prefers_ck(problem) else "triton"
+    else:
+        ret = requested
+    return ret
+
+
+def _apply_activation(
+    values: torch.Tensor,
+    activation: ActivationType,
+    is_gated: bool,
+    gate_mode: GateMode,
+    swiglu_limit: float | None,
+    situ_beta: float,
+    situ_linear_beta: float,
+) -> torch.Tensor:
+    if is_gated:
+        if gate_mode == GateMode.SEPARATED:
+            gate, up = values.chunk(2, dim=-1)
+        else:
+            gate, up = values[..., ::2], values[..., 1::2]
+        if activation == ActivationType.Silu:
+            ret = torch.nn.functional.silu(gate) * up
+        elif activation == ActivationType.Swiglu:
+            limit = 7.0 if swiglu_limit is None else swiglu_limit
+            gate = gate.clamp(max=limit)
+            up = up.clamp(min=-limit, max=limit)
+            ret = gate * torch.sigmoid(1.702 * gate) * (up + 1)
+        elif activation == ActivationType.Gelu:
+            ret = torch.nn.functional.gelu(gate) * up
+        elif activation == ActivationType.GeluTanh:
+            ret = torch.nn.functional.gelu(gate, approximate="tanh") * up
+        elif activation == ActivationType.Situv2:
+            situ_gate = situ_beta * torch.tanh(gate / situ_beta) * torch.sigmoid(gate)
+            up_scaled = situ_linear_beta * torch.tanh(up / situ_linear_beta)
+            ret = situ_gate * up_scaled
+        elif activation == ActivationType.No:
+            ret = gate * up
+        else:
+            raise ValueError(f"unsupported gated activation: {activation}")
+    else:
+        if activation == ActivationType.Silu:
+            ret = torch.nn.functional.silu(values)
+        elif activation == ActivationType.Gelu:
+            ret = torch.nn.functional.gelu(values)
+        elif activation == ActivationType.GeluTanh:
+            ret = torch.nn.functional.gelu(values, approximate="tanh")
+        elif activation == ActivationType.No:
+            ret = values
+        else:
+            raise ValueError(f"unsupported nongated activation: {activation}")
+    return ret
+
+
+def gfx1100_moe_stage1(
+    hidden_states,
+    w1,
+    w2,
+    sorted_token_ids,
+    sorted_expert_ids,
+    num_valid_ids,
+    out,
+    topk,
+    block_m,
+    a1_scale,
+    w1_scale,
+    sorted_weights=None,
+    n_pad_zeros=0,
+    k_pad_zeros=0,
+    bias1=None,
+    topk_ids=None,
+    activation=ActivationType.Silu,
+    split_k=1,
+    dtype=torch.bfloat16,
+    kernel_name="",
+    is_gated=True,
+    gate_mode=GateMode.SEPARATED.value,
+    swiglu_limit=None,
+    situ_beta=1.0,
+    situ_linear_beta=1.0,
+    use_fused_core=False,
+):
+    import aiter
+
+    token_count = hidden_states.shape[0]
+    inter_dim = w2.shape[-1]
+    expected_shape = (token_count, topk, inter_dim)
+    if out is None or tuple(out.shape) != expected_shape or out.dtype != dtype:
+        out = torch.empty(expected_shape, dtype=dtype, device=hidden_states.device)
+    if use_fused_core:
+        aiter.moe_cktile2stages_gemm1(
+            hidden_states,
+            w1,
+            out,
+            sorted_token_ids,
+            sorted_expert_ids,
+            num_valid_ids,
+            topk,
+            n_pad_zeros,
+            k_pad_zeros,
+            sorted_weights,
+            a1_scale,
+            w1_scale,
+            bias1,
+            activation,
+            block_m,
+            split_k,
+            GFX1100_STAGE1_KERNEL,
+        )
+    else:
+        raw = torch.zeros(
+            (token_count, topk, w1.shape[1]),
+            dtype=torch.float32,
+            device=hidden_states.device,
+        )
+        preshuffled = getattr(w1, "is_shuffled", False)
+        kernel = (
+            GFX1100_STAGE1_LINEAR_SHUFFLED_KERNEL
+            if preshuffled
+            else GFX1100_STAGE1_LINEAR_RAW_KERNEL
+        )
+        aiter.moe_cktile2stages_gemm1(
+            hidden_states,
+            w1,
+            raw,
+            sorted_token_ids,
+            sorted_expert_ids,
+            num_valid_ids,
+            topk,
+            n_pad_zeros,
+            k_pad_zeros,
+            sorted_weights,
+            a1_scale,
+            w1_scale,
+            bias1,
+            activation,
+            block_m,
+            split_k,
+            kernel,
+        )
+        activated = _apply_activation(
+            raw,
+            ActivationType(activation),
+            is_gated,
+            GateMode(gate_mode),
+            swiglu_limit,
+            situ_beta,
+            situ_linear_beta,
+        )
+        out.copy_(activated.to(dtype))
+    return out
+
+
+def gfx1100_moe_stage2(
+    a2,
+    w1,
+    w2,
+    sorted_token_ids,
+    sorted_expert_ids,
+    num_valid_ids,
+    out,
+    topk,
+    w2_scale,
+    a2_scale,
+    block_m,
+    activation=ActivationType.Silu,
+    sorted_weights=None,
+    zeros_out=False,
+    n_pad_zeros=0,
+    k_pad_zeros=0,
+    bias2=None,
+    kernel_name="",
+    stage2_scatter=None,
+):
+    import aiter
+
+    route_output = torch.zeros(
+        (a2.shape[0] * topk, w2.shape[1]),
+        dtype=torch.bfloat16,
+        device=out.device,
+    )
+    preshuffled = getattr(w2, "is_shuffled", False)
+    kernel = GFX1100_STAGE2_KERNEL if preshuffled else GFX1100_STAGE2_RAW_KERNEL
+    aiter.moe_cktile2stages_gemm2(
+        a2,
+        w2,
+        route_output,
+        sorted_token_ids,
+        sorted_expert_ids,
+        num_valid_ids,
+        topk,
+        n_pad_zeros,
+        k_pad_zeros,
+        sorted_weights,
+        a2_scale,
+        w2_scale,
+        bias2,
+        activation,
+        block_m,
+        kernel_name=kernel,
+    )
+    routes = route_output.view(a2.shape[0], topk, w2.shape[1])
+    if stage2_scatter is None:
+        out.copy_(routes.sum(dim=1))
+    else:
+        from aiter.ops.flydsl.kernels.moe_stage2_scatter import (
+            scatter_stage2_output,
+        )
+
+        scatter_stage2_output(route_output, stage2_scatter, topk)
+    return out
