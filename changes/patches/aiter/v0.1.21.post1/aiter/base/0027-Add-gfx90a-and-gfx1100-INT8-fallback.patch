From 9101aaeb17a7fc6af53b556bf2ea185534c67ff4 Mon Sep 17 00:00:00 2001
From: Mika Laitio <mika.laitio@amd.com>
Date: Sat, 12 Sep 2026 22:27:08 -0700
Subject: [PATCH] Add gfx90a and gfx1100 INT8 fallback

- Add tuned Triton A8W8 defaults for both GPUs.
- Fall back when gfx90a CK rejects a shape.
- Preserve CK failures unrelated to kernel support.
- Make the backend comparison architecture-aware.

Tools used:
- GPT-5.6 Sol: gpt-5.6-sol-high

Signed-off-by: Mika Laitio <mika.laitio@amd.com>
---
 aiter/ops/gemm_op_a8w8.py                     | 10 ++++-
 .../triton/gemm/gemm_a8w8/DEFAULT.json        | 28 +++++++++++++
 .../gemm_a8w8/GEMM-A8W8-N=8192-K=1024.json    | 41 +++++++++++++++++++
 .../gfx90a/triton/gemm/gemm_a8w8/DEFAULT.json | 41 +++++++++++++++++++
 .../gemm_a8w8/GEMM-A8W8-N=8192-K=1024.json    | 28 +++++++++++++
 op_tests/test_gemm_a8w8_backends.py           |  7 +++-
 6 files changed, 152 insertions(+), 3 deletions(-)
 create mode 100644 aiter/ops/triton/configs/gfx1100/triton/gemm/gemm_a8w8/DEFAULT.json
 create mode 100644 aiter/ops/triton/configs/gfx1100/triton/gemm/gemm_a8w8/GEMM-A8W8-N=8192-K=1024.json
 create mode 100644 aiter/ops/triton/configs/gfx90a/triton/gemm/gemm_a8w8/DEFAULT.json
 create mode 100644 aiter/ops/triton/configs/gfx90a/triton/gemm/gemm_a8w8/GEMM-A8W8-N=8192-K=1024.json

diff --git a/aiter/ops/gemm_op_a8w8.py b/aiter/ops/gemm_op_a8w8.py
index a4e03457..ea633d20 100644
--- a/aiter/ops/gemm_op_a8w8.py
+++ b/aiter/ops/gemm_op_a8w8.py
@@ -720,7 +720,15 @@ def gemm_a8w8(
         # so callers stay torch.compile- and graph-capture-safe.
         ret = gemm_a8w8_Triton(XQ, WQ, x_scale, w_scale, bias, dtype)
     else:
-        ret = gemm_a8w8_CK(XQ, WQ, x_scale, w_scale, bias, dtype, splitK)
+        try:
+            ret = gemm_a8w8_CK(XQ, WQ, x_scale, w_scale, bias, dtype, splitK)
+        except RuntimeError as error:
+            if "This GEMM is not supported!" not in str(error):
+                raise
+            logger.info(
+                "CK INT8 A8W8 does not support this shape; falling back to Triton"
+            )
+            ret = gemm_a8w8_Triton(XQ, WQ, x_scale, w_scale, bias, dtype)
     return ret


