+def _quantize_rows(tensor):
+    shape = tensor.shape
+    quantized, scale = aiter.pertoken_quant(
+        tensor.reshape(-1, shape[-1]),
+        quant_dtype=dtypes.i8,
+    )
+    return quantized.view(shape), scale.view(*shape[:-1], 1)
+
+
+def _activate(values, activation, is_gated, gate_mode):
+    if is_gated:
+        if gate_mode == GateMode.SEPARATED:
+            gate, up = values.chunk(2, dim=-1)
+        else:
+            gate, up = values[..., ::2], values[..., 1::2]
+        if activation == aiter.ActivationType.Silu:
+            ret = torch.nn.functional.silu(gate) * up
+        elif activation == aiter.ActivationType.Swiglu:
+            gate = gate.clamp(max=7.0)
+            up = up.clamp(min=-7.0, max=7.0)
+            ret = gate * torch.sigmoid(1.702 * gate) * (up + 1)
+        elif activation == aiter.ActivationType.Gelu:
+            ret = torch.nn.functional.gelu(gate) * up
+        elif activation == aiter.ActivationType.GeluTanh:
+            ret = torch.nn.functional.gelu(gate, approximate="tanh") * up
+        elif activation == aiter.ActivationType.Situv2:
+            ret = torch.tanh(gate) * torch.sigmoid(gate) * torch.tanh(up)
+        elif activation == aiter.ActivationType.No:
+            ret = gate * up
+        else:
+            raise ValueError(f"unsupported test activation: {activation}")
+    else:
+        if activation == aiter.ActivationType.Silu:
+            ret = torch.nn.functional.silu(values)
+        elif activation == aiter.ActivationType.Gelu:
+            ret = torch.nn.functional.gelu(values)
+        elif activation == aiter.ActivationType.GeluTanh:
+            ret = torch.nn.functional.gelu(values, approximate="tanh")
+        elif activation == aiter.ActivationType.No:
+            ret = values
+        else:
+            raise ValueError(f"unsupported test activation: {activation}")
+    return ret
+
+
+def _reference(
+    hidden_q,
+    hidden_scale,
+    w1_q,
+    w1_scale,
+    w2_q,
+    w2_scale,
+    topk_weights,
+    topk_ids,
+    activation,
+    gate_mode,
+    bias1,
+    bias2,
+    doweight_stage1,
+    expert_mask,
+    num_local_tokens,
+    a2_scale=None,
+    return_routes=False,
+):
+    token_count, topk = topk_ids.shape
+    is_gated = w1_q.shape[1] == 2 * w2_q.shape[2]
+    inter_dim = w2_q.shape[2]
+    model_dim = w2_q.shape[1]
+    stage1 = torch.zeros(
+        (token_count, topk, inter_dim),
+        device=hidden_q.device,
+        dtype=torch.float32,
+    )
+    valid = torch.zeros((token_count, topk), device=hidden_q.device, dtype=torch.bool)
+    if expert_mask is None:
+        local_expert_ids = torch.arange(w1_q.shape[0], device=hidden_q.device)
+    else:
+        local_expert_ids = torch.cumsum(expert_mask.to(torch.int32), dim=0) - 1
+
+    hidden = hidden_q.float() * hidden_scale.float()
+    w1 = w1_q.float() * w1_scale.float()
+    for token in range(num_local_tokens):
+        for slot in range(topk):
+            global_expert = int(topk_ids[token, slot])
+            if expert_mask is not None and not bool(expert_mask[global_expert]):
+                continue
+            local_expert = int(local_expert_ids[global_expert])
+            linear = hidden[token] @ w1[local_expert].transpose(0, 1)
+            if doweight_stage1:
+                linear = linear * topk_weights[token, slot]
+            if bias1 is not None:
+                linear = linear + bias1[local_expert]
+            stage1[token, slot] = _activate(
+                linear,
+                activation,
+                is_gated,
+                gate_mode,
+            )
+            valid[token, slot] = True
+
+    if a2_scale is None:
+        stage1_q, stage1_scale = _quantize_rows(stage1.to(torch.bfloat16))
+    else:
+        stage1_scale = a2_scale
+        stage1_q = torch.round(stage1 / stage1_scale).to(torch.int8)
+    stage1 = stage1_q.float() * stage1_scale.float()
+    w2 = w2_q.float() * w2_scale.float()
+    ret = torch.zeros(
+        (token_count, model_dim),
+        device=hidden_q.device,
+        dtype=torch.float32,
+    )
+    routes = torch.zeros(
+        (token_count, topk, model_dim),
+        device=hidden_q.device,
+        dtype=torch.float32,
+    )
+    for token in range(num_local_tokens):
+        for slot in range(topk):
+            if not bool(valid[token, slot]):
+                continue
+            global_expert = int(topk_ids[token, slot])
+            local_expert = int(local_expert_ids[global_expert])
+            route = stage1[token, slot] @ w2[local_expert].transpose(0, 1)
+            if bias2 is not None:
+                route = route + bias2[local_expert]
+            if not doweight_stage1:
+                route = route * topk_weights[token, slot]
+            routes[token, slot] = route
+            ret[token] += route
+    ret = ret.to(torch.bfloat16)
+    if return_routes:
+        ret = (ret, routes.to(torch.bfloat16))
+    return ret
+
+
+def _make_case(is_gated, gate_mode, with_bias, expert_parallel):
+    torch.manual_seed(7)
+    token_count, model_dim, inter_dim = 8, 64, 32
+    global_experts = 6 if expert_parallel else 4
+    expert_mask = None
+    if expert_parallel:
+        expert_mask = torch.tensor(
+            [0, 1, 0, 1, 1, 0],
+            device="cuda",
+            dtype=torch.int32,
+        )
+        local_experts = 3
+    else:
+        local_experts = global_experts
+
+    hidden = torch.randn(
