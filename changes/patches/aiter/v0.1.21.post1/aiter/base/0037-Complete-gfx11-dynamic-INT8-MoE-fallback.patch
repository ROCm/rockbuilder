diff --git a/aiter/fused_moe.py b/aiter/fused_moe.py
index 09c6d36fe..22f242626 100644
--- a/aiter/fused_moe.py
+++ b/aiter/fused_moe.py
@@ -1012,6 +1012,93 @@ def _fused_moe_impl(
                     f"a16w4 (bf16 A x MXFP4 W) SiTUv2 is not supported: {_why}."
                 )

+    use_gfx11_int8_triton = (
+        get_gfx().startswith("gfx11")
+        and quant_type == QuantType.per_Token
+        and q_dtype_a == dtypes.i8
+        and q_dtype_w == dtypes.i8
+    )
+    if use_gfx11_int8_triton:
+        if w1_scale is None or w2_scale is None:
+            raise ValueError("gfx11 dynamic INT8 MoE requires weight scales")
+        if getattr(w1, "is_shuffled", False) != getattr(w2, "is_shuffled", False):
+            raise ValueError("gfx11 dynamic INT8 MoE weights must use the same layout")
+
+        preshuffled = getattr(w1, "is_shuffled", False)
+        if preshuffled:
+            if w1.shape[1] % 16 or model_dim % 16:
+                raise ValueError("preshuffled gfx11 stage-one dimensions must be divisible by 16")
+            if model_dim % 16 or inter_dim % 16:
+                raise ValueError("preshuffled gfx11 stage-two dimensions must be divisible by 16")
+            w1_triton = w1.view(E, w1.shape[1] // 16, model_dim * 16).transpose(-1, -2)
+            w2_triton = w2.view(E, model_dim // 16, inter_dim * 16).transpose(-1, -2)
+        else:
+            w1_triton = w1.transpose(-1, -2)
+            w2_triton = w2.transpose(-1, -2)
+
+        route_valid = None
+        local_topk_ids = topk_ids
+        if expert_mask is not None:
+            safe_topk_ids = topk_ids
+            active_rows = None
+            if num_local_tokens is not None:
+                active_rows = (
+                    torch.arange(M, device=topk_ids.device) < num_local_tokens
+                )
+                safe_topk_ids = torch.where(active_rows[:, None], topk_ids, 0)
+            local_expert_mask = expert_mask.to(dtype=torch.bool, device=topk_ids.device)
+            route_valid = local_expert_mask[safe_topk_ids]
+            if active_rows is not None:
+                route_valid = route_valid & active_rows[:, None]
+            local_expert_ids = torch.cumsum(local_expert_mask.to(dtypes.i32), dim=0) - 1
+            local_topk_ids = torch.where(
+                route_valid,
+                local_expert_ids[safe_topk_ids],
+                0,
+            )
+
+        from aiter.ops.triton.moe.moe_op_gemm_int8_smoothquant import (
+            fused_moe_int8_smoothquant_from_topk,
+        )
+
+        ret = fused_moe_int8_smoothquant_from_topk(
+            hidden_states,
+            w1_triton,
+            w2_triton,
+            w1_scale.view(E, -1),
+            w2_scale.view(E, -1),
+            topk_weight,
+            local_topk_ids,
+            dtype=dtype,
+            preshuffled=preshuffled,
+            gate_separated=gate_mode == GateMode.SEPARATED,
+            bias1=bias1,
+            bias2=bias2,
+            activation=activation,
+            is_gated=isG1U1,
+            doweight_stage1=doweight_stage1,
+            route_valid=route_valid,
+            num_local_tokens=num_local_tokens,
+            a1_scale=a1_scale,
+            a2_scale=a2_scale,
+            swiglu_limit=swiglu_limit,
+            situ_beta=1.0 if beta is None else float(beta),
+            situ_linear_beta=1.0 if linear_beta is None else float(linear_beta),
+            return_route_output=stage2_scatter is not None,
+        )
+        if stage2_scatter is not None:
+            from aiter.ops.flydsl.kernels.moe_stage2_scatter import (
+                scatter_stage2_output,
+            )
+
+            scatter_stage2_output(ret, stage2_scatter, topk)
+            ret = torch.empty(
+                (M, model_dim),
+                dtype=dtype,
+                device=hidden_states.device,
+            )
+        return _return_output(ret, output)
+
     metadata = get_2stage_cfgs(
         get_padded_M(M),  # consider token_num > 1024 as prefill
         model_dim,
diff --git a/aiter/ops/flydsl/kernels/moe_stage2_scatter.py b/aiter/ops/flydsl/kernels/moe_stage2_scatter.py
new file mode 100644
index 000000000..2e391385a
--- /dev/null
+++ b/aiter/ops/flydsl/kernels/moe_stage2_scatter.py
@@ -0,0 +1,135 @@
+# SPDX-License-Identifier: MIT
+# Copyright (C) 2026, Advanced Micro Devices, Inc. All rights reserved.
+
+from functools import lru_cache
+
+import flydsl.compiler as flyc
+import flydsl.expr as fx
+import torch
+from flydsl.expr import range_constexpr
+from flydsl.expr.typing import Int32, Int64, T
+
+from aiter.ops.flydsl.kernels import communication_ops_utils as comm_ops
+from aiter.ops.flydsl.kernels.buffer_ops import (
+    buffer_load,
+    create_buffer_resource_from_addr,
+)
+
+
+_BLOCK_SIZE = 256
+
+
+@lru_cache(maxsize=None)
+def _make_stage2_scatter(
+    hidden_dim,
+    combine_input_offset,
+    slot_stride_bytes,
+    max_tokens_per_rank,
+    topk,
+    world_size,
+):
+    import mori.cco.device.flydsl as cco
+
+    if hidden_dim % 2:
+        raise ValueError("stage-two scatter requires an even hidden dimension")
+    destination_stride = max_tokens_per_rank * topk
+    n_i32 = hidden_dim // 2
+
+    @flyc.kernel(known_block_size=[_BLOCK_SIZE, 1, 1])
+    def stage2_scatter(
+        arena: Int64,
+        addr_route_output: Int64,
+        addr_source_token_map: Int64,
+        num_routes: Int32,
+    ):
+        route = fx.Uint32(fx.block_idx.x)
+        tid = fx.Uint32(fx.thread_idx.x)
+        route_output = create_buffer_resource_from_addr(addr_route_output)
+        source_token_map = create_buffer_resource_from_addr(addr_source_token_map)
+        window = cco.Window(arena)
+
+        if route < fx.Uint32(num_routes):
+            destination = buffer_load(
+                source_token_map,
+                route,
+                vec_width=1,
+                dtype=T.i32,
+            )
+            peer = destination // fx.Int32(destination_stride)
+            slot = destination % fx.Int32(destination_stride)
+            valid = (
+                (destination >= fx.Int32(0))
+                & (peer < fx.Int32(world_size))
+                & (slot < fx.Int32(destination_stride))
+            )
+            if valid:
+                destination_base = fx.Int64(
+                    window.lsa_ptr(peer, combine_input_offset)
+                ) + fx.Int64(slot) * fx.Int64(slot_stride_bytes)
+                source_base = route * n_i32
+                for iteration in range_constexpr(
+                    (n_i32 + _BLOCK_SIZE - 1) // _BLOCK_SIZE
+                ):
+                    column = tid + iteration * _BLOCK_SIZE
+                    if column < fx.Uint32(n_i32):
+                        value = buffer_load(
+                            route_output,
+                            source_base + column,
+                            vec_width=1,
+                            dtype=T.i32,
+                        )
+                        comm_ops.store_i32_system(destination_base, column, value)
+
+    @flyc.jit
+    def run(
+        arena: Int64,
+        addr_route_output: Int64,
+        addr_source_token_map: Int64,
+        num_routes: Int32,
+        stream=fx.Stream(None),  # noqa: B008
+    ):
+        stage2_scatter(
+            arena,
+            addr_route_output,
+            addr_source_token_map,
+            num_routes,
+        ).launch(
+            grid=(fx.Int64(num_routes), 1, 1),
+            block=[_BLOCK_SIZE, 1, 1],
+            stream=stream,
+        )
+
+    return run
+
+
+def scatter_stage2_output(route_output, context, topk):
+    if route_output.dtype not in (torch.bfloat16, torch.float16):
+        raise ValueError(f"unsupported stage-two scatter dtype: {route_output.dtype}")
+    route_output = route_output.contiguous()
+    source_token_map = context.source_token_map.view(-1)
+    if source_token_map.numel() != route_output.shape[0]:
+        raise ValueError(
+            "stage-two scatter source map and route output sizes differ: "
+            f"{source_token_map.numel()} != {route_output.shape[0]}"
+        )
+    try:
+        run = _make_stage2_scatter(
+            route_output.shape[1],
+            int(context.combine_input_offset),
+            int(context.slot_stride_bytes),
+            int(context.max_tokens_per_rank),
+            int(topk),
+            int(context.world_size),
+        )
+    except ModuleNotFoundError as error:
+        missing_name = error.name or ""
+        if missing_name != "mori" and not missing_name.startswith("mori."):
+            raise
+        raise RuntimeError("stage-two peer scatter requires Mori CCO") from error
+    run(
+        int(context.arena_handle),
+        route_output.data_ptr(),
+        source_token_map.data_ptr(),
+        route_output.shape[0],
+        fx.Stream(torch.cuda.current_stream()),
+    )
diff --git a/aiter/ops/triton/_triton_kernels/moe/activations.py b/aiter/ops/triton/_triton_kernels/moe/activations.py
index fd2c30587..36596ac9e 100644
--- a/aiter/ops/triton/_triton_kernels/moe/activations.py
+++ b/aiter/ops/triton/_triton_kernels/moe/activations.py
@@ -31,3 +31,19 @@ def _swiglu(input, alpha, limit, ADD_RESIDUAL: tl.constexpr):
         return tl.fma(s, linear, s)  # s * (linear + 1)
     else:
         return s * linear
+
+
+@triton.jit
+def _swiglu_separated(gelu, linear, alpha, limit, ADD_RESIDUAL: tl.constexpr):
+    gelu = gelu.to(tl.float32)
+    if limit is not None:
+        gelu = clip(gelu, limit, clip_lower=False)
+    linear = linear.to(tl.float32)
+    if limit is not None:
+        linear = clip(linear, limit, clip_lower=True)
+    s = fast_dividef(gelu, 1 + tl.exp2(-1.44269504089 * alpha * gelu))
+    if ADD_RESIDUAL:
+        ret = tl.fma(s, linear, s)
+    else:
+        ret = s * linear
+    return ret
