+    stage1_dim = inter_dim * 2 if is_gated else inter_dim
+    w1 = torch.randn(
+        (local_experts, stage1_dim, model_dim),
+        device="cuda",
+        dtype=torch.bfloat16,
+    )
+    bias1 = torch.randn(
+        (local_experts, stage1_dim),
+        device="cuda",
+        dtype=torch.bfloat16,
+    )
+    if is_gated and gate_mode == GateMode.INTERLEAVE:
+        w1 = torch.stack(
+            (w1[:, :inter_dim], w1[:, inter_dim:]),
+            dim=2,
+        ).flatten(1, 2)
+        bias1 = torch.stack(
+            (bias1[:, :inter_dim], bias1[:, inter_dim:]),
+            dim=2,
+        ).flatten(1, 2)
+    w2 = torch.randn(
+        (local_experts, model_dim, inter_dim),
+        device="cuda",
+        dtype=torch.bfloat16,
+    )
+    bias2 = torch.randn(
