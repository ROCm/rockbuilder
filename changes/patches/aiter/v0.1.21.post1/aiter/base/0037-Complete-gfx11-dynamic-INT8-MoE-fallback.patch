+def test_gfx11_dynamic_int8_stage2_scatter():
+    if not get_gfx().startswith("gfx11"):
+        pytest.skip("gfx11-only dynamic INT8 MoE fallback")
+    try:
+        from mori.cco import Communicator
+    except ImportError:
+        pytest.skip("Mori communicator is unavailable")
+
+    from aiter.ops.flydsl.kernels.mega_moe_gfx1250.mega_moe import SymmetricArena
+    from aiter.ops.flydsl.kernels.mega_moe_gfx1250.types import (
+        Stage2ScatterContext,
+        _from_gpu_ptr,
+    )
+
+    case = _make_case(True, GateMode.SEPARATED, True, False)
+    w1 = shuffle_weight(case["w1_q"], layout=(16, 16))
+    w2 = shuffle_weight(case["w2_q"], layout=(16, 16))
+    _, expected_routes = _reference(
+        case["hidden_q"],
+        case["hidden_scale"],
+        case["w1_q"],
+        case["w1_scale"],
+        case["w2_q"],
+        case["w2_scale"],
+        case["topk_weights"],
+        case["topk_ids"],
+        aiter.ActivationType.Silu,
+        GateMode.SEPARATED,
+        case["bias1"],
+        case["bias2"],
+        False,
+        None,
+        case["hidden"].shape[0],
+        return_routes=True,
+    )
+    route_count = case["topk_ids"].numel()
+    hidden_dim = case["hidden"].shape[1]
+    slot_stride_bytes = hidden_dim * 2
+    uid = Communicator.get_unique_id()
+    communicator = Communicator.init(1, 0, uid, per_rank_vmm=1024**3)
+    arena = SymmetricArena(
+        communicator,
+        [("combine", route_count * slot_stride_bytes)],
+    )
+    try:
+        source_token_map = torch.arange(
+            route_count,
+            device="cuda",
+            dtype=torch.int32,
+        ).view_as(case["topk_ids"])
+        context = Stage2ScatterContext(
+            arena_handle=arena.handle,
+            combine_input_offset=arena.offset("combine"),
+            slot_stride_bytes=slot_stride_bytes,
+            max_tokens_per_rank=case["hidden"].shape[0],
+            world_size=1,
+            source_token_map=source_token_map,
+        )
+        fused_moe(
+            case["hidden"],
+            w1,
+            w2,
+            case["topk_weights"],
+            case["topk_ids"],
+            activation=aiter.ActivationType.Silu,
+            quant_type=aiter.QuantType.per_Token,
+            w1_scale=case["w1_scale"],
+            w2_scale=case["w2_scale"],
+            bias1=case["bias1"],
+            bias2=case["bias2"],
+            gate_mode=GateMode.SEPARATED.value,
+            stage2_scatter=context,
+        )
+        torch.cuda.synchronize()
+        actual_routes = _from_gpu_ptr(
+            arena.local_ptr("combine"),
+            (route_count, hidden_dim),
+            torch.bfloat16,
+        )
+        torch.testing.assert_close(
+            actual_routes,
+            expected_routes.view(route_count, hidden_dim),
+            rtol=0.08,
+            atol=24,
+        )
+    finally:
+        arena.close()
+        communicator.destroy()
