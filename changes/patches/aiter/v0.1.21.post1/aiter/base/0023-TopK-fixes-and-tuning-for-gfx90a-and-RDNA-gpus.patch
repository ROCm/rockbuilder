-inline int get_runtime_warp_size()
+// Restrict measured TopK policy changes to these exact targets. gfx942,
+// gfx950, gfx1250, and unknown architectures intentionally remain untuned.
+struct RuntimeGpuInfo
+{
+    int warp_size;
+    bool use_topk_tuning;
+    bool is_gfx90a;
+};
+
+inline bool gpu_arch_matches(const char* arch_name, const char* expected)
+{
+    const size_t expected_length = std::strlen(expected);
+    bool ret = std::strncmp(arch_name, expected, expected_length) == 0 &&
+               (arch_name[expected_length] == '\0' || arch_name[expected_length] == ':');
+    return ret;
+}
+
+inline RuntimeGpuInfo get_runtime_gpu_info()
 {
     int device = 0;
     HIP_CHECK(hipGetDevice(&device));
-    hipDeviceProp_t properties{};
-    HIP_CHECK(hipGetDeviceProperties(&properties, device));
-    int ret = properties.warpSize;
+
+    // The dispatcher needs both wave size and architecture. Cache the
+    // properties per host thread so tuning checks do not add a property
+    // query to every TopK launch.
+    static thread_local int cached_device = -1;
+    static thread_local RuntimeGpuInfo cached_info{};
+    if(device != cached_device)
+    {
+        hipDeviceProp_t properties{};
+        HIP_CHECK(hipGetDeviceProperties(&properties, device));
+        const bool is_gfx90a = gpu_arch_matches(properties.gcnArchName, "gfx90a");
+        const bool is_rdna_tuned = gpu_arch_matches(properties.gcnArchName, "gfx1100") ||
+                                   gpu_arch_matches(properties.gcnArchName, "gfx1200") ||
+                                   gpu_arch_matches(properties.gcnArchName, "gfx1201");
+        cached_device          = device;
+        cached_info.warp_size  = properties.warpSize;
+        cached_info.is_gfx90a  = is_gfx90a;
+        cached_info.use_topk_tuning = is_gfx90a || is_rdna_tuned;
+    }
+    RuntimeGpuInfo ret = cached_info;
+    return ret;
+}
+
+inline int get_runtime_warp_size()
+{
+    int ret = get_runtime_gpu_info().warp_size;
     return ret;
 }

