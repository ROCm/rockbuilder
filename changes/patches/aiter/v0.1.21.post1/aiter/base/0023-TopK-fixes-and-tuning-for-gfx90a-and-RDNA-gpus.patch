+    int batch_size, IdxT len, IdxT k, int warp_size, bool use_arch_tuning)
 {
     const double n = static_cast<double>(len);
     const double K = static_cast<double>(k);
+    bool ret       = false;

-    if(K <= 1.0)
+    if(K > 1.0)
     {
-        return false;
-    }
-
-    const double log_n = std::log2(n);
-
-    const double denom = std::max(0.0001, log_n - 9.5);
+        const double log_n = std::log2(n);
+        const double denom = std::max(0.0001, log_n - 9.5);
+        const double rhs   = (4.8 * n) / denom;

-    const double rhs = (4.8 * n) / denom;
+        const double log_k = std::log2(K);
+        const double lhs   = K * log_k * log_k;
+        ret                = lhs >= rhs;

-    const double log_k = std::log2(K);
-    const double lhs   = K * log_k * log_k;
-
-    return lhs >= rhs;
+        // This measured crossover is allowlisted for gfx90a, gfx1100,
+        // gfx1200, and gfx1201. Other GPUs retain the original cost model
+        // because this tuning has not been benchmarked on them.
+        const int small_batch_limit = warp_size == 64 ? 128 : 64;
+        const bool use_small_batch_radix =
+            use_arch_tuning && len == 4096 && k <= 128 && batch_size <= small_batch_limit;
+        ret = ret || use_small_batch_radix;
+    }
+    return ret;
