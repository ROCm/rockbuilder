+def _uses_mxfp4_weights(quant_type, w1, w2) -> bool:
+    has_distinct_fp4_dtype = dtypes.fp4x2 != dtypes.i4x2
+    ret = (
+        has_distinct_fp4_dtype
+        and quant_type == QuantType.per_1x32
+        and (w1.dtype == dtypes.fp4x2 or w2.dtype == dtypes.fp4x2)
+    )
+    return ret
+
+
 def fused_moe(
     hidden_states,
     w1,  # [expert(local_expert:EP), inter_dim*2, dim] N,K
@@ -575,6 +585,9 @@ def fused_moe(
     # hidden_states, or the call raises; when given it is what gets returned.
     output: torch.Tensor | None = None,
 ):
+    gfx = get_gfx()
+    if gfx == "gfx90a" and _uses_mxfp4_weights(quant_type, w1, w2):
+        raise RuntimeError("MXFP4 fused MoE is unsupported on gfx90a")
     if (
         any(
             tensor is not None
