--- a/aiter/jit/utils/moe_recipes.py
+++ b/aiter/jit/utils/moe_recipes.py
@@ -16,6 +16,15 @@ _DTYPE_MAP = {
 }

 _QUANT_ALIAS = {"per_128x128": "per_1x128"}
+_MXFP4_CK2STAGES_SUPPORTED_GPU_ARCHS = ("gfx950",)
