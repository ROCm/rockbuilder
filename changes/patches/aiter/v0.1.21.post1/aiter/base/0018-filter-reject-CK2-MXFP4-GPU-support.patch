diff --git a/op_tests/test_gfx90a_mxfp4_guards.py b/op_tests/test_gfx90a_mxfp4_guards.py
new file mode 100644
index 00000000..5a181fc3
--- /dev/null
+++ b/op_tests/test_gfx90a_mxfp4_guards.py
@@ -0,0 +1,108 @@
+# SPDX-License-Identifier: MIT
+# Copyright (C) 2026, Advanced Micro Devices, Inc. All rights reserved.
+
+import importlib
+from types import SimpleNamespace
+from unittest.mock import Mock
+
+import pytest
+
+from aiter import ActivationType, QuantType
+from aiter.jit.utils import moe_recipes
+
+fused_moe_module = importlib.import_module("aiter.fused_moe")
+
+
+def test_ck2stages_mxfp4_variants_only_target_gfx950(monkeypatch):
+    rows = [
+        {
+            "dtype": "torch.bfloat16",
+            "q_dtype_a": "torch.float8_e4m3fn",
+            "q_dtype_w": "torch.float4_e2m1fn_x2",
+            "q_type": "per_1x32",
+            "act_type": "silu",
+            "doweight_stage1": "0",
+        },
+        {
+            "dtype": "torch.bfloat16",
+            "q_dtype_a": "torch.float4_e2m1fn_x2",
+            "q_dtype_w": "torch.float4_e2m1fn_x2",
+            "q_type": "per_1x32",
+            "act_type": "silu",
+            "doweight_stage1": "0",
+        },
+        {
+            "dtype": "torch.bfloat16",
+            "q_dtype_a": "torch.float8_e4m3fn",
+            "q_dtype_w": "torch.float8_e4m3fn",
+            "q_type": "per_token",
+            "act_type": "silu",
+            "doweight_stage1": "0",
+        },
+    ]
+    monkeypatch.setattr(moe_recipes, "_get_tuned_fmoe_rows", lambda: rows)
+
+    variants = moe_recipes.get_moe_ck2stages_prebuild_variants("/csrc")
+    mxfp4_variants = [variant for variant in variants if "_fp4x2_" in variant["md_name"]]
+    non_mxfp4_variants = [variant for variant in variants if "_fp4x2_" not in variant["md_name"]]
+
+    assert any("_f8_fp4x2_" in variant["md_name"] for variant in mxfp4_variants)
+    assert any("_fp4x2_fp4x2_" in variant["md_name"] for variant in mxfp4_variants)
+    assert non_mxfp4_variants
+    for variant in mxfp4_variants:
+        assert variant["supported_gpu_archs"] == ("gfx950",)
+        assert moe_recipes._filter_moe_variant_gpu_archs(variant, ["gfx90a"]) == []
+        assert moe_recipes._filter_moe_variant_gpu_archs(
+            variant, ["gfx90a", "gfx950"]
+        ) == ["gfx950"]
+    for variant in non_mxfp4_variants:
+        assert "supported_gpu_archs" not in variant
+        assert moe_recipes._filter_moe_variant_gpu_archs(
+            variant, ["gfx90a", "gfx950"]
+        ) == ["gfx90a", "gfx950"]
+
+
+def _mock_low_bit_dtypes(monkeypatch):
+    fp4_dtype = object()
+    int4_dtype = object()
+    monkeypatch.setattr(fused_moe_module.dtypes, "fp4x2", fp4_dtype)
+    monkeypatch.setattr(fused_moe_module.dtypes, "i4x2", int4_dtype)
+    return fp4_dtype, int4_dtype
+
+
+def _call_public_fused_moe(weight_dtype):
+    weight = SimpleNamespace(dtype=weight_dtype)
+    ret = fused_moe_module.fused_moe(
+        hidden_states=None,
+        w1=weight,
+        w2=weight,
+        topk_weight=None,
+        topk_ids=None,
+        activation=ActivationType.Silu,
+        quant_type=QuantType.per_1x32,
+    )
+    return ret
+
+
+def test_public_fused_moe_rejects_mxfp4_on_gfx90a(monkeypatch):
+    fp4_dtype, _ = _mock_low_bit_dtypes(monkeypatch)
+    backend = Mock()
+    monkeypatch.setattr(fused_moe_module, "get_gfx", lambda: "gfx90a")
+    monkeypatch.setattr(fused_moe_module, "fused_moe_", backend)
+
+    with pytest.raises(RuntimeError, match=r"MXFP4.*gfx90a"):
+        _call_public_fused_moe(fp4_dtype)
+
+    backend.assert_not_called()
+
+
+def test_public_fused_moe_preserves_int4_on_gfx90a(monkeypatch):
+    _, int4_dtype = _mock_low_bit_dtypes(monkeypatch)
+    backend = Mock(return_value="int4-result")
+    monkeypatch.setattr(fused_moe_module, "get_gfx", lambda: "gfx90a")
+    monkeypatch.setattr(fused_moe_module, "fused_moe_", backend)
+
+    ret = _call_public_fused_moe(int4_dtype)
+
+    assert ret == "int4-result"
+    backend.assert_called_once()
