+++ b/op_tests/test_gated_delta_rule.py
@@ -1875,11 +1875,12 @@ def test_chunk_opt_vk_hip_downgrade_preserves_indexed_state_args(monkeypatch):
     assert captured["inplace_final_state"] is True


-def test_chunk_opt_vk_unsupported_gfx12_downgrades_to_triton(monkeypatch):
+@pytest.mark.parametrize("gfx", ["gfx1100", "gfx1250"])
+def test_chunk_opt_vk_unsupported_hip_arch_downgrades_to_triton(monkeypatch, gfx):
     chunk_module = importlib.import_module(
         "aiter.ops.triton._triton_kernels.gated_delta_rule.prefill.chunk"
     )
-    props = type("DeviceProperties", (), {"gcnArchName": "gfx1250"})()
+    props = type("DeviceProperties", (), {"gcnArchName": gfx})()
     monkeypatch.setattr(torch.cuda, "get_device_properties", lambda device: props)
     monkeypatch.setattr(
         chunk_module,
diff --git a/op_tests/test_jit_module_archs.py b/op_tests/test_jit_module_archs.py
index e4abefef..d8f1eede 100644
--- a/op_tests/test_jit_module_archs.py
+++ b/op_tests/test_jit_module_archs.py
@@ -133,3 +133,15 @@ def test_vsa_sparse_attention_rejects_gfx1100(monkeypatch):
         match=r"module_vsa_sparse_attention.*gfx1100",
     ):
         core.get_args_of_build("module_vsa_sparse_attention")
+
+
+def test_chunk_gdr_filters_gfx1100_from_mixed_build(monkeypatch):
+    monkeypatch.setattr(
+        core,
+        "get_gfx_list",
+        lambda: ["gfx1100", "gfx1201", "gfx90a"],
+    )
+
+    args = core.get_args_of_build("module_chunk_gdr_fwd_h")
+
+    assert args["gpu_archs"] == ["gfx1201", "gfx90a"]
