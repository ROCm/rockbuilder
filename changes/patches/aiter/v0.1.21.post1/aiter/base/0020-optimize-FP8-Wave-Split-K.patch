+constexpr int WVSPLITKQ_MAX_SPLITS = 16;
+
+int wvSplitKQGetSplitCount(
+    const int M, const int K, const int N, const int CuCount, const int warp_size)
+{
+    int ret = 1;
+    if(M > 0 && K >= 512 && N >= 1 && N <= 4 && CuCount > 0)
+    {
+        const bool large_gfx90a = warp_size == 64 && M >= 128 && K >= 8192;
+        const int waves_per_cu = large_gfx90a ? 32 : (N <= 2 ? 8 : 4);
+        const int target_waves = CuCount * waves_per_cu;
+        const int needed       = (target_waves + M - 1) / M;
+        const int k_limit      = std::max(1, K / 256);
+        while(ret < needed && ret < WVSPLITKQ_MAX_SPLITS && ret * 2 <= k_limit)
+        {
+            ret *= 2;
+        }
+    }
+    return ret;
+}
+
+template <typename fp8_t, int N, int WAVE_SIZE, int BLOCK_SIZE>
+__global__ void __launch_bounds__(BLOCK_SIZE) wvSplitKQ_partial_(const int K,
+                                                                const int Kp,
+                                                                const int M,
+                                                                const fp8_t* B,
+                                                                const fp8_t* __restrict__ A,
+                                                                float* workspace,
+                                                                const int split_count)
+{
+#if defined(__gfx90a__) || defined(AITER_WVSPLITKQ_RDNA_WAVE32)
+#if defined(__gfx90a__)
+    using input_t = __hip_fp8_e4m3_fnuz;
+#else
+    using input_t = rocwmma::float8_t;
+#endif
+    const int waves_per_block = blockDim.x / WAVE_SIZE;
+    const int lane            = threadIdx.x % WAVE_SIZE;
+    const int wave            = threadIdx.x / WAVE_SIZE;
+    const int column          = blockIdx.x * waves_per_block + wave;
+    const int split           = blockIdx.y;
+    const auto* weights       = reinterpret_cast<const input_t*>(B);
+    const auto* activations   = reinterpret_cast<const input_t*>(A);
+
+    const int unaligned_chunk = (K + split_count - 1) / split_count;
+    const int chunk           = (unaligned_chunk + 15) & ~15;
+    const int k_begin         = split * chunk;
+    const int k_end           = min(K, k_begin + chunk);
+    float sums[N]             = {};
+
+#if defined(__gfx1200__) || defined(__gfx1201__)
+    if(column < M)
+    {
+        for(int k = k_begin + lane; k < k_end; k += WAVE_SIZE)
+        {
+            const float weight = static_cast<float>(weights[column * Kp + k]);
+#pragma unroll
+            for(int row = 0; row < N; ++row)
+            {
+                sums[row] =
+                    fmaf(static_cast<float>(activations[row * K + k]), weight, sums[row]);
+            }
+        }
+    }
+#else
+    constexpr int k_tile = 256;
+    __shared__ float activation_tile[N * k_tile];
+    for(int tile_begin = k_begin; tile_begin < k_end; tile_begin += k_tile)
+    {
+        const int tile_size = min(k_tile, k_end - tile_begin);
+#if defined(__gfx90a__)
+        constexpr int pairs_per_tile = k_tile / 2;
+        for(int pair_index = threadIdx.x; pair_index < N * pairs_per_tile;
+            pair_index += blockDim.x)
+        {
+            const int row         = pair_index / pairs_per_tile;
+            const int pair_offset = (pair_index % pairs_per_tile) * 2;
+            if(pair_offset < tile_size)
+            {
+                const auto* packed = reinterpret_cast<const uint16_t*>(
+                    &A[row * K + tile_begin + pair_offset]);
+                const float2 values = wv_split_kq_unpack_fp8x2(*packed);
+                activation_tile[row * k_tile + pair_offset]     = values.x;
+                activation_tile[row * k_tile + pair_offset + 1] = values.y;
+            }
+        }
+#else
+        for(int index = threadIdx.x; index < N * k_tile; index += blockDim.x)
+        {
+            const int row    = index / k_tile;
+            const int offset = index % k_tile;
+            if(offset < tile_size)
+            {
+                activation_tile[index] =
+                    static_cast<float>(activations[row * K + tile_begin + offset]);
+            }
+        }
+#endif
+        __syncthreads();
+
+        if(column < M)
+        {
+#if defined(__gfx90a__)
+            for(int offset = lane * 2; offset < tile_size; offset += WAVE_SIZE * 2)
+            {
+                const auto* packed = reinterpret_cast<const uint16_t*>(
+                    &B[column * Kp + tile_begin + offset]);
+                const float2 weights_pair = wv_split_kq_unpack_fp8x2(*packed);
+#pragma unroll
+                for(int row = 0; row < N; ++row)
+                {
+                    sums[row] =
+                        fmaf(activation_tile[row * k_tile + offset], weights_pair.x, sums[row]);
+                    sums[row] = fmaf(
+                        activation_tile[row * k_tile + offset + 1], weights_pair.y, sums[row]);
+                }
+            }
+#else
+            for(int offset = lane; offset < tile_size; offset += WAVE_SIZE)
+            {
+                const float weight =
+                    static_cast<float>(weights[column * Kp + tile_begin + offset]);
+#pragma unroll
+                for(int row = 0; row < N; ++row)
+                {
+                    sums[row] =
+                        fmaf(activation_tile[row * k_tile + offset], weight, sums[row]);
+                }
+            }
+#endif
+        }
+        __syncthreads();
+    }
+#endif
+
+    if(column < M)
+    {
+#pragma unroll
+        for(int offset = WAVE_SIZE / 2; offset > 0; offset /= 2)
+        {
+#pragma unroll
+            for(int row = 0; row < N; ++row)
+            {
+                sums[row] += __shfl_down(sums[row], offset, WAVE_SIZE);
+            }
+        }
+
+        if(lane == 0)
+        {
+#pragma unroll
+            for(int row = 0; row < N; ++row)
+            {
+                workspace[split * N * M + row * M + column] = sums[row];
+            }
+        }
+    }
+#else
+    UNREACHABLE_CODE
+#endif
+}
+
+template <typename scalar_t, int N>
+__global__ void wvSplitKQ_reduce_(const int M,
+                                  const float* __restrict__ workspace,
+                                  scalar_t* C,
+                                  const float* __restrict__ s_A,
+                                  const float* __restrict__ s_B,
+                                  const int split_count)
+{
+    const int output = blockIdx.x * blockDim.x + threadIdx.x;
+    if(output < N * M)
+    {
+        float sum = 0.0f;
+#pragma unroll
+        for(int split = 0; split < WVSPLITKQ_MAX_SPLITS; ++split)
+        {
+            if(split < split_count)
+            {
+                sum += workspace[split * N * M + output];
+            }
+        }
+        C[output] = __float2s<scalar_t>(sum * *s_A * *s_B);
+    }
+}
+
+template <typename scalar_t, int N>
+__global__ void wvSplitKQ_reduce_16_(const int M,
+                                     const float* __restrict__ workspace,
+                                     scalar_t* C,
+                                     const float* __restrict__ s_A,
+                                     const float* __restrict__ s_B)
+{
+    const int output = blockIdx.x * blockDim.x + threadIdx.x;
+    if(output < N * M)
+    {
+        float sum = 0.0f;
+#pragma unroll
+        for(int split = 0; split < WVSPLITKQ_MAX_SPLITS; ++split)
+        {
+            sum += workspace[split * N * M + output];
+        }
+        C[output] = __float2s<scalar_t>(sum * *s_A * *s_B);
+    }
+}
+
+void wvSplitKQSplitK_(void* in_a,
+                      void* in_b,
+                      void* out_c,
+                      const float* scale_a,
+                      const float* scale_b,
+                      float* workspace,
+                      const int M_in,
+                      const int K_in,
+                      const int Kp_in,
+                      const int N_in,
+                      hipStream_t stream,
+                      const int CuCount,
+                      const int warp_size,
+                      int split_count,
+                      const AiterDtype a_scalar_type,
+                      const AiterDtype c_scalar_type)
+{
+    if(split_count == 0)
+    {
+        split_count = wvSplitKQGetSplitCount(M_in, K_in, N_in, CuCount, warp_size);
+    }
+    if(split_count < 1 || split_count > WVSPLITKQ_MAX_SPLITS ||
+       (split_count & (split_count - 1)) != 0)
+    {
+        throw std::runtime_error("wvSplitKQ split count must be one of 1, 2, 4, 8, or 16");
+    }
+
+#define WVSPLITKQ_SPLIT(_N)                                                                    \
+    {                                                                                           \
+        const int threads = warp_size == 64 && M_in >= 128 && K_in >= 8192 ? 512 : 256;         \
+        const int waves_per_block = threads / warp_size;                                       \
+        dim3 partial_grid((M_in + waves_per_block - 1) / waves_per_block, split_count);         \
+        dim3 partial_block(threads);                                                            \
+        if(warp_size == 32)                                                                    \
+        {                                                                                       \
+            wvSplitKQ_partial_<fp8_t, _N, 32, 256><<<partial_grid, partial_block, 0, stream>>>(  \
+                K_in, Kp_in, M_in, a_ptr, b_ptr, workspace, split_count);                       \
+        }                                                                                       \
+        else if(threads == 512)                                                                 \
+        {                                                                                       \
+            wvSplitKQ_partial_<fp8_t, _N, 64, 512><<<partial_grid, partial_block, 0, stream>>>(  \
+                K_in, Kp_in, M_in, a_ptr, b_ptr, workspace, split_count);                       \
+        }                                                                                       \
+        else                                                                                    \
+        {                                                                                       \
+            wvSplitKQ_partial_<fp8_t, _N, 64, 256><<<partial_grid, partial_block, 0, stream>>>(  \
+                K_in, Kp_in, M_in, a_ptr, b_ptr, workspace, split_count);                       \
+        }                                                                                       \
+        dim3 reduce_block(256);                                                                 \
+        dim3 reduce_grid((M_in * _N + reduce_block.x - 1) / reduce_block.x);                    \
+        if(split_count == WVSPLITKQ_MAX_SPLITS)                                                 \
+        {                                                                                       \
+            wvSplitKQ_reduce_16_<fptype, _N><<<reduce_grid, reduce_block, 0, stream>>>(          \
+                M_in, workspace, c_ptr, scale_a, scale_b);                                      \
+        }                                                                                       \
+        else                                                                                    \
+        {                                                                                       \
+            wvSplitKQ_reduce_<fptype, _N><<<reduce_grid, reduce_block, 0, stream>>>(             \
+                M_in, workspace, c_ptr, scale_a, scale_b, split_count);                         \
+        }                                                                                       \
+    }
+
+    AITER_DISPATCH_FLOATING16_TYPES_rmTorch(c_scalar_type, "wvSplitKQSplitK", [&] {
+        using fptype = typename scalar<scalar_t>::type;
+        auto c_ptr   = reinterpret_cast<fptype*>(out_c);
+        AITER_DISPATCH_FP8_TYPES_rmTorch(a_scalar_type, "wvSplitKQSplitK", [&] {
+            auto a_ptr = reinterpret_cast<fp8_t*>(in_a);
+            auto b_ptr = reinterpret_cast<fp8_t*>(in_b);
+            switch(N_in)
+            {
+            case 1: WVSPLITKQ_SPLIT(1) break;
+            case 2: WVSPLITKQ_SPLIT(2) break;
+            case 3: WVSPLITKQ_SPLIT(3) break;
+            case 4: WVSPLITKQ_SPLIT(4) break;
+            default:
+                throw std::runtime_error("Unsupported N value: " + std::to_string(M_in) + "," +
+                                         std::to_string(K_in) + "," + std::to_string(N_in));
+            }
+        });
+    });
+}
+
 void wvSplitKQ_(void* in_a,
                 void* in_b,
                 void* out_c,
diff --git a/csrc/py_itfs_cu/custom.cu b/csrc/py_itfs_cu/custom.cu
index 0cb7b46c..dcf44966 100644
--- a/csrc/py_itfs_cu/custom.cu
+++ b/csrc/py_itfs_cu/custom.cu
@@ -191,6 +191,94 @@ void wvSplitKQ(aiter_tensor_t& in_a,
                out_c.dtype());
 }

+int wvSplitKQGetSplitCount(
+    const int M, const int K, const int N, const int CuCount, const int warp_size);
+void wvSplitKQSplitK_(void* in_a,
+                      void* in_b,
+                      void* out_c,
+                      const float* scale_a,
+                      const float* scale_b,
+                      float* workspace,
+                      const int M,
+                      const int K,
+                      const int Kp,
+                      const int N,
+                      hipStream_t stream,
+                      const int CuCount,
+                      const int warp_size,
+                      const int split_count,
+                      const AiterDtype a_scalar_type,
+                      const AiterDtype c_scalar_type);
+void wvSplitKQSplitK(aiter_tensor_t& in_a,
+                     aiter_tensor_t& in_b,
+                     aiter_tensor_t& out_c,
+                     aiter_tensor_t& scale_a,
+                     aiter_tensor_t& scale_b,
+                     aiter_tensor_t& workspace,
+                     const int64_t CuCount,
+                     const int64_t requested_split_count)
+{
+    const auto M  = in_a.size(0);
+    const auto K  = in_a.size(1);
+    const auto N  = in_b.size(0);
+    const auto Kp = in_a.stride(0);
+    AITER_CHECK(K % 16 == 0, "k % 16 == 0");
+    AITER_CHECK(N >= 1 && N <= 4, "wvSplitKQSplitK supports N=1 through N=4");
+    AITER_CHECK(in_a.dtype() == in_b.dtype() && in_a.dtype() == AITER_DTYPE_fp8);
+    AITER_CHECK(out_c.dtype() == AITER_DTYPE_fp16 || out_c.dtype() == AITER_DTYPE_bf16);
+    AITER_CHECK(workspace.dtype() == AITER_DTYPE_fp32, "workspace must use float32");
+    AITER_CHECK(workspace.device_id == in_a.device_id, "workspace must be on the input device");
+    AITER_CHECK(requested_split_count == 0 || requested_split_count == 1 ||
+                    requested_split_count == 2 || requested_split_count == 4 ||
+                    requested_split_count == 8 || requested_split_count == 16,
+                "split_count must be one of 0, 1, 2, 4, 8, or 16");
+
+    HipDeviceGuard device_guard(in_a.device_id);
+    int warp_size = 0;
+    hipError_t status =
+        hipDeviceGetAttribute(&warp_size, hipDeviceAttributeWarpSize, in_a.device_id);
+    AITER_CHECK(status == hipSuccess, "Could not query GPU wave size: ", hipGetErrorString(status));
+
+    hipDeviceProp_t properties;
+    status = hipGetDeviceProperties(&properties, in_a.device_id);
+    AITER_CHECK(status == hipSuccess, "Could not query GPU properties: ", hipGetErrorString(status));
+    const std::string architecture(properties.gcnArchName);
+    const bool supported = architecture.rfind("gfx90a", 0) == 0 ||
+                           architecture.rfind("gfx1100", 0) == 0 ||
+                           architecture.rfind("gfx1200", 0) == 0 ||
+                           architecture.rfind("gfx1201", 0) == 0;
+    AITER_CHECK(supported, "wvSplitKQSplitK is unsupported on ", architecture);
+
+    int split_count = static_cast<int>(requested_split_count);
+    if(split_count == 0)
+    {
+        split_count = wvSplitKQGetSplitCount(M, K, N, CuCount, warp_size);
+    }
+    const int64_t required_workspace = static_cast<int64_t>(split_count) * N * M;
+    AITER_CHECK(workspace.numel() >= required_workspace,
+                "workspace requires ",
+                required_workspace,
+                " float32 elements but has ",
+                workspace.numel());
+
+    wvSplitKQSplitK_(in_a.data_ptr(),
+                     in_b.data_ptr(),
+                     out_c.data_ptr(),
