+__device__ __forceinline__ float2 wv_split_kq_unpack_fp8x2(uint16_t packed)
+{
+    __hip_fp8x2_e4m3_fnuz value;
+    value.__x = static_cast<__hip_fp8x2_storage_t>(packed);
+    float2 ret = static_cast<float2>(value);
+    return ret;
+}
