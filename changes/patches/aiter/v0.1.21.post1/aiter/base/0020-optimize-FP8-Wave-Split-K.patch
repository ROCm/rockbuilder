+def wvSplitKQ(
+    in_a: Tensor,
+    in_b: Tensor,
+    out_c: Tensor,
+    scale_a: Tensor,
+    scale_b: Tensor,
+    CuCount: int,
+    workspace: Tensor | None = None,
+    implementation: str | None = None,
+    split_count: int = 0,
+) -> None:
+    """Run the FP8 Wave Split-K kernel.
+
+    ``implementation`` accepts ``"auto"``, ``"legacy"``, or ``"splitk"``.
+    ``AITER_WVSPLITKQ_IMPL`` provides the process-wide default. Callers that
+    capture graphs can provide a reusable float32 ``workspace``.
+    """
+    mode = (implementation or os.getenv("AITER_WVSPLITKQ_IMPL", "auto")).lower()
+    if mode not in {"auto", "legacy", "splitk"}:
+        raise ValueError(
+            "implementation must be 'auto', 'legacy', or 'splitk', "
+            f"but received {mode!r}"
+        )
+    if split_count not in {0, 1, 2, 4, 8, 16}:
+        raise ValueError(
+            "split_count must be one of 0, 1, 2, 4, 8, or 16, "
+            f"but received {split_count}"
+        )
+
+    properties = torch.cuda.get_device_properties(in_a.device)
+    architecture = properties.gcnArchName.split(":", maxsplit=1)[0]
+    splitk_architectures = {"gfx90a", "gfx1100", "gfx1200", "gfx1201"}
+    problem_size = in_b.size(0) * in_a.size(0) * in_a.size(1)
+    auto_splitk = (
+        architecture in splitk_architectures
+        and 1 <= in_b.size(0) <= 4
+        and (architecture == "gfx90a" or problem_size >= 8192)
+        and in_a.size(0) <= 512
+    )
+    use_splitk = mode == "splitk" or (mode == "auto" and auto_splitk)
+
+    if use_splitk:
+        if architecture not in splitk_architectures:
+            raise RuntimeError(
+                f"Wave Split-K is unsupported on architecture {architecture}"
+            )
+        if workspace is None:
+            workspace = torch.empty(
+                (16, in_b.size(0), in_a.size(0)),
+                dtype=torch.float32,
+                device=in_a.device,
+            )
+        _wvSplitKQSplitK(
+            in_a,
+            in_b,
+            out_c,
+            scale_a,
+            scale_b,
+            workspace,
+            CuCount,
+            split_count,
+        )
+    else:
+        _wvSplitKQLegacy(in_a, in_b, out_c, scale_a, scale_b, CuCount)
