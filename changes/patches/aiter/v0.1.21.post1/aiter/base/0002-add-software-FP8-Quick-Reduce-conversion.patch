+
+
+def validate_exact_values(
+    pointer: int,
+    device: torch.device,
+    dtype: torch.dtype,
+    elements: int,
+    rank: int,
+) -> None:
+    input_tensor = torch.ones(elements, dtype=dtype, device=device)
+    output = torch.empty_like(input_tensor)
+    ops.qr_all_reduce(
+        pointer,
+        input_tensor,
+        output,
+        FP8_QUANT_LEVEL,
+        cast_bf2half=dtype == torch.bfloat16,
+    )
+    torch.cuda.synchronize(device)
+
+    expected = torch.full_like(output, dist.get_world_size())
+    maximum = torch.max(torch.abs(output.float() - expected.float()))
+    failed = torch.tensor(
+        [int(not torch.isfinite(output).all().item() or maximum.item() > 0.05)],
+        dtype=torch.int32,
+        device=device,
+    )
+    dist.all_reduce(failed, op=dist.ReduceOp.MAX)
+    if rank == 0:
+        print(f"ones dtype={dtype} max_abs={maximum.item():.6f}")
+    if failed.item() != 0:
+        raise AssertionError(
+            f"FP8 Quick Reduce exact-value test failed: dtype={dtype}, "
+            f"max_abs={maximum.item():.6f}"
+        )
+
+
+def main() -> None:
+    args = parse_args()
+    local_rank = int(os.environ["LOCAL_RANK"])
+    rank = int(os.environ["RANK"])
+    world_size = int(os.environ["WORLD_SIZE"])
