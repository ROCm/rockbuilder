@@ -0,0 +1,177 @@
+# SPDX-License-Identifier: MIT
+# Copyright (C) 2026, Advanced Micro Devices, Inc. All rights reserved.
+
+import argparse
+import os
+
+import torch
+import torch.distributed as dist
+
+import aiter as ops
+from aiter.dist.device_communicators.quick_all_reduce import qr_exchange_handles
+
+
+FP8_QUANT_LEVEL = 1
+
+
+def parse_args() -> argparse.Namespace:
+    parser = argparse.ArgumentParser(
+        description="Validate FP8 Quick Reduce correctness on a multi-GPU gfx1100 node."
+    )
+    parser.add_argument(
+        "--elements",
+        type=int,
+        default=8 * 1024 * 1024,
+        help="Number of elements per rank; must produce a byte count divisible by 16.",
+    )
+    parser.add_argument(
+        "--dtypes",
+        nargs="+",
+        choices=("fp16", "bf16"),
+        default=("fp16", "bf16"),
+    )
+    parser.add_argument("--max-nrmse", type=float, default=0.08)
+    parser.add_argument("--max-absolute-error", type=float, default=2.0)
+    ret = parser.parse_args()
+    return ret
+
+
+def check_architecture(device: torch.device) -> None:
+    architecture = torch.cuda.get_device_properties(device).gcnArchName
+    if not architecture.startswith("gfx1100"):
+        raise RuntimeError(f"expected gfx1100, found {architecture}")
+
+
+def validate_case(
+    pointer: int,
+    device: torch.device,
+    dtype: torch.dtype,
+    elements: int,
+    rank: int,
+    max_nrmse: float,
+    max_absolute_error: float,
+) -> None:
+    generator = torch.Generator(device=device)
+    generator.manual_seed(0xA17E0000 + rank)
+    input_tensor = torch.randn(elements, dtype=dtype, device=device, generator=generator)
+    reference = input_tensor.clone()
+    dist.all_reduce(reference)
+
+    output = torch.empty_like(input_tensor)
+    ops.qr_all_reduce(
+        pointer,
+        input_tensor,
+        output,
+        FP8_QUANT_LEVEL,
+        cast_bf2half=dtype == torch.bfloat16,
+    )
+    torch.cuda.synchronize(device)
+
+    difference = output.float() - reference.float()
+    rmse = torch.sqrt(torch.mean(torch.square(difference)))
+    reference_rms = torch.sqrt(torch.mean(torch.square(reference.float())))
+    nrmse = rmse / torch.clamp(reference_rms, min=torch.finfo(torch.float32).tiny)
+    maximum = torch.max(torch.abs(difference))
+    finite = torch.isfinite(output).all()
+
+    failed = torch.tensor(
+        [
+            int(
+                not finite.item()
+                or nrmse.item() > max_nrmse
+                or maximum.item() > max_absolute_error
+            )
+        ],
+        dtype=torch.int32,
+        device=device,
+    )
+    dist.all_reduce(failed, op=dist.ReduceOp.MAX)
+    if rank == 0:
+        print(
+            f"random dtype={dtype} nrmse={nrmse.item():.6f} "
+            f"max_abs={maximum.item():.6f}"
+        )
+    if failed.item() != 0:
+        raise AssertionError(
+            f"FP8 Quick Reduce random test failed: dtype={dtype}, "
+            f"nrmse={nrmse.item():.6f}, max_abs={maximum.item():.6f}"
