+// The HIP API uses native E4M3-FNUZ conversion on gfx942 and its software
+// implementation on targets without FP8 conversion instructions. OCP-only
+// targets retain the existing native conversion behavior.
+#if defined(__HIP_DEVICE_COMPILE__) && \
+    !(defined(__gfx950__) || defined(__gfx1200__) || defined(__gfx1201__) || \
+      defined(__gfx1250__))
+#define AITER_QUICK_REDUCE_USE_HIP_FNUZ_CONVERSION 1
+#else
+#define AITER_QUICK_REDUCE_USE_HIP_FNUZ_CONVERSION 0
+#endif
+
+__quickreduce_device_inline__ uint16_t quickreduce_fp32x2_to_fp8_fnuz(float x, float y)
+{
+#if AITER_QUICK_REDUCE_USE_HIP_FNUZ_CONVERSION
+    return static_cast<uint16_t>(
+        __hip_cvt_float2_to_fp8x2(float2{x, y}, __HIP_SATFINITE, __HIP_E4M3_FNUZ));
+#else
+    int packed = __builtin_amdgcn_cvt_pk_fp8_f32(x, y, 0, 0);
+    return static_cast<uint16_t>(packed);
+#endif
+}
+
+__quickreduce_device_inline__ fp32x2_t quickreduce_fp8x2_fnuz_to_fp32(uint16_t packed)
+{
+#if AITER_QUICK_REDUCE_USE_HIP_FNUZ_CONVERSION
+    __hip_fp8x2_e4m3_fnuz value;
+    value.__x            = static_cast<__hip_fp8x2_storage_t>(packed);
+    const float2 decoded = static_cast<float2>(value);
+    return fp32x2_t{decoded.x, decoded.y};
+#else
+    return __builtin_amdgcn_cvt_pk_f32_fp8(static_cast<uint32_t>(packed), 0);
+#endif
+}
+#undef AITER_QUICK_REDUCE_USE_HIP_FNUZ_CONVERSION
+
