+        "E",
+        "BLOCK_M",
+        "BLOCK_E",
+    ],
+)
+
+_fused_routing_from_topk_block_map_kernel_repr = make_kernel_repr(
+    "_fused_routing_from_topk_block_map_kernel",
+    [
+        "E",
+        "MAX_TILES_PER_EXPERT",
+    ],
+)
+

 @triton.jit(repr=_fused_routing_from_topk_hist_kernel_repr)
 def _fused_routing_from_topk_hist_kernel(
@@ -174,3 +191,53 @@ def _fused_routing_from_topk_place_kernel(
     tl.store(topk_indx_ptr + safe_pos, item_offs.to(tl.int32), mask=item_mask)
     # gate_scal[pos] = weight at the original flat item
     tl.store(gate_scal_ptr + safe_pos, weights, mask=item_mask)
+
+
+@triton.jit(repr=_fused_routing_from_topk_metadata_kernel_repr)
+def _fused_routing_from_topk_metadata_kernel(
+    hist_ptr,
+    token_offs_raw_ptr,
+    token_offs_pad_ptr,
+    E: tl.constexpr,
+    BLOCK_M: tl.constexpr,
+    BLOCK_E: tl.constexpr,
+):
+    e_offs = tl.arange(0, BLOCK_E)
+    e_mask = e_offs < E
+    hist = tl.load(hist_ptr + e_offs, mask=e_mask, other=0).to(tl.int32)
+    raw_inclusive = tl.cumsum(hist, axis=0)
+    tiles = tl.cdiv(hist, BLOCK_M)
+    padded_inclusive = tl.cumsum(tiles, axis=0)
+
+    tl.store(token_offs_raw_ptr, 0)
+    tl.store(token_offs_pad_ptr, 0)
+    tl.store(
+        token_offs_raw_ptr + e_offs + 1,
+        raw_inclusive,
+        mask=e_mask,
+    )
+    tl.store(
+        token_offs_pad_ptr + e_offs + 1,
+        padded_inclusive,
+        mask=e_mask,
+    )
+
+
+@triton.jit(repr=_fused_routing_from_topk_block_map_kernel_repr)
+def _fused_routing_from_topk_block_map_kernel(
+    token_offs_pad_ptr,
+    block_pid_map_ptr,
+    E: tl.constexpr,
+    MAX_TILES_PER_EXPERT: tl.constexpr,
+):
+    expert = tl.program_id(0)
+    tile_offs = tl.arange(0, MAX_TILES_PER_EXPERT)
+    tile_start = tl.load(token_offs_pad_ptr + expert)
+    tile_end = tl.load(token_offs_pad_ptr + expert + 1)
+    tile_count = tile_end - tile_start
+    packed = (tile_offs << 16) | expert
+    tl.store(
+        block_pid_map_ptr + tile_start + tile_offs,
+        packed,
+        mask=(expert < E) & (tile_offs < tile_count),
+    )
diff --git a/aiter/ops/triton/fusions/fused_routing_from_topk.py b/aiter/ops/triton/fusions/fused_routing_from_topk.py
index 80a80f0ac..ea95458e8 100644
--- a/aiter/ops/triton/fusions/fused_routing_from_topk.py
+++ b/aiter/ops/triton/fusions/fused_routing_from_topk.py
@@ -9,7 +9,9 @@ import torch
 import triton

 from aiter.ops.triton._triton_kernels.fusions.fused_routing_from_topk import (
+    _fused_routing_from_topk_block_map_kernel,
     _fused_routing_from_topk_hist_kernel,
+    _fused_routing_from_topk_metadata_kernel,
     _fused_routing_from_topk_offset_kernel,
     _fused_routing_from_topk_place_kernel,
 )
@@ -164,3 +166,79 @@ def fused_routing_from_topk(
     )

     return hist, topk_indx, gate_indx, gate_scal
+
+
+def fused_routing_data_from_topk(
+    topk_weights: torch.Tensor,
+    topk_ids: torch.Tensor,
+    n_expts_tot: int,
+    block_m: int,
+    expert_map: torch.Tensor | None = None,
+) -> tuple[
+    torch.Tensor,
+    torch.Tensor,
+    torch.Tensor,
+    torch.Tensor,
+    torch.Tensor,
+    torch.Tensor,
+    torch.Tensor,
+]:
+    """Build sorted routing indices and grouped-GEMM expert metadata."""
+    hist, topk_indx, gate_indx, gate_scal = fused_routing_from_topk(
+        topk_weights,
+        topk_ids,
+        n_expts_tot,
+        expert_map,
+    )
+    n_gates = topk_ids.numel()
+    if n_gates <= n_expts_tot:
+        max_n_tiles = n_gates
+    else:
+        max_n_tiles = (
+            n_expts_tot
+            - 1
+            - ((n_expts_tot - n_gates - 1) // block_m)
+        )
+
+    token_offs_raw = torch.empty(
+        n_expts_tot + 1,
+        dtype=torch.int32,
+        device=topk_ids.device,
+    )
+    token_offs_pad = torch.empty_like(token_offs_raw)
+    block_pid_map = torch.full(
+        (max_n_tiles,),
+        -1,
+        dtype=torch.int32,
+        device=topk_ids.device,
+    )
+    block_e = max(triton.next_power_of_2(n_expts_tot), 32)
+    _fused_routing_from_topk_metadata_kernel[(1,)](
+        hist,
+        token_offs_raw,
+        token_offs_pad,
+        E=n_expts_tot,
+        BLOCK_M=block_m,
+        BLOCK_E=block_e,
+        num_warps=1,
+    )
+    max_tiles_per_expert = max(
+        triton.next_power_of_2(triton.cdiv(n_gates, block_m)),
+        1,
+    )
+    _fused_routing_from_topk_block_map_kernel[(n_expts_tot,)](
+        token_offs_pad,
+        block_pid_map,
+        E=n_expts_tot,
+        MAX_TILES_PER_EXPERT=max_tiles_per_expert,
+        num_warps=1,
+    )
+    return (
+        hist,
+        topk_indx,
+        gate_indx,
+        gate_scal,
+        token_offs_raw,
+        token_offs_pad,
+        block_pid_map,
+    )
