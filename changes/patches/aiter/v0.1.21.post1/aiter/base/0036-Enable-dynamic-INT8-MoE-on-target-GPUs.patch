@@ -0,0 +1,52 @@
+# SPDX-License-Identifier: MIT
+# Copyright (C) 2026, Advanced Micro Devices, Inc. All rights reserved.
+
+import torch
+
+from aiter.jit.utils import moe_recipes
+from aiter.ops.moe_op import get_moe_stage_module
+
+
+_DYNAMIC_INT8_MODULE_PREFIX = "module_moe_ck2stages_i8_i8_preshuffle_on"
+_DYNAMIC_INT8_ARCHS = ("gfx90a", "gfx1201")
+
+
+def test_dynamic_int8_moe_variants_are_prebuilt(monkeypatch):
+    monkeypatch.setattr(moe_recipes, "_get_tuned_fmoe_rows", lambda: [])
+
+    variants = moe_recipes.get_moe_ck2stages_prebuild_variants("/csrc")
+    dynamic_int8 = [
+        variant
+        for variant in variants
+        if variant["md_name"].startswith(_DYNAMIC_INT8_MODULE_PREFIX)
+    ]
+
+    assert len(dynamic_int8) == 2
+    assert any("_b16_" in variant["md_name"] for variant in dynamic_int8)
+    assert any("_f32_" in variant["md_name"] for variant in dynamic_int8)
+    for variant in dynamic_int8:
+        assert variant["supported_gpu_archs"] == _DYNAMIC_INT8_ARCHS
+        assert "-a i8 -b i8" in variant["blob_gen_cmd"][0]
+        assert "-q per_token" in variant["blob_gen_cmd"][0]
+        assert "--preshuffle" in variant["blob_gen_cmd"][0]
+        assert moe_recipes._filter_moe_variant_gpu_archs(
+            variant,
+            ["gfx90a", "gfx1100", "gfx1201"],
+        ) == list(_DYNAMIC_INT8_ARCHS)
+
+
+def test_dynamic_int8_jit_module_supports_fp32_output():
+    md_name, blob_gen_cmd = get_moe_stage_module(
+        input_dtype=torch.int8,
+        weight_dtype=torch.int8,
+        output_dtype=torch.float32,
+        activation=0,
+        quant_type=2,
+        mul_routed_weight_stage=2,
+        preshuffle_mode=True,
+    )
+
+    assert md_name.startswith(_DYNAMIC_INT8_MODULE_PREFIX)
+    assert "_f32_" in md_name
+    assert "-c f32" in blob_gen_cmd[0]
+    assert "--preshuffle" in blob_gen_cmd[0]
