+def fused_moe_int8_smoothquant_from_topk(
+    hidden_states: torch.Tensor,
+    w13: torch.Tensor,
+    w2: torch.Tensor,
+    w13_scale: torch.Tensor,
+    w2_scale: torch.Tensor,
+    topk_weights: torch.Tensor,
+    topk_ids: torch.Tensor,
+    dtype: torch.dtype = torch.bfloat16,
+) -> torch.Tensor:
+    """Run dynamic INT8 MoE from precomputed top-k routing results."""
+    num_tokens, topk = topk_ids.shape
+    num_experts = w13.shape[0]
+    num_gates = num_tokens * topk
+    tokens_per_expert = max(1, num_gates // num_experts)
+    block_m = max(16, min(triton.next_power_of_2(tokens_per_expert), 128))
+    topk_weights = topk_weights.contiguous()
+    topk_ids = topk_ids.to(torch.int32).contiguous()
+    if num_gates <= 4096:
+        (
+            hist,
+            gather_idx,
+            scatter_idx,
+            gate_scal,
+            token_offs_raw,
+            token_offs_pad,
+            block_pid_map,
+        ) = fused_routing_data_from_topk(
+            topk_weights,
+            topk_ids,
+            num_experts,
+            block_m,
+        )
+        expt_data = ExptData(
+            hist,
+            token_offs_raw,
+            token_offs_pad,
+            block_pid_map,
+        )
+    else:
+        topk_ids_flat = topk_ids.flatten()
+        gather_idx = torch.argsort(topk_ids_flat, stable=True).to(torch.int32)
+        scatter_idx = torch.argsort(gather_idx, stable=True).to(torch.int32)
+        gate_scal = topk_weights.flatten()[gather_idx.long()]
+        hist = torch.bincount(
+            topk_ids_flat.long(),
+            minlength=num_experts,
+        ).to(torch.int32)
+        expt_data = compute_expt_data_torch(
+            hist,
+            num_experts,
+            num_gates,
+            block_m,
+        )
+    routing_data = RoutingData(
+        block_m,
+        gate_scal,
+        hist,
+        num_experts,
+        topk,
+        expt_data,
+    )
+    return _fused_moe_int8_smoothquant_routed(
+        hidden_states,
+        w13,
+        w2,
+        w13_scale,
+        w2_scale,
+        routing_data,
+        gather_idx,
+        scatter_idx,
+        dtype,
+    )
+
+
+def _fused_moe_int8_smoothquant_routed(
+    hidden_states: torch.Tensor,
+    w13: torch.Tensor,
+    w2: torch.Tensor,
+    w13_scale: torch.Tensor,
+    w2_scale: torch.Tensor,
+    routing_data: RoutingData,
+    gather_idx: torch.Tensor,
+    scatter_idx: torch.Tensor,
+    dtype: torch.dtype,
+) -> torch.Tensor:
+    from aiter.ops.triton.moe.quant_moe import smoothquant_quantize

     # GEMM1 gate/up projection: per-token int8 activations, no smoothing.
+    _, H = hidden_states.shape
     no_smooth_h = torch.ones(H, device=hidden_states.device, dtype=torch.float32)
     x_int8, x_scale = smoothquant_quantize(hidden_states, no_smooth_h)
     # GEMM1 + fused gated SiLU: w13 columns are interleaved (g,u,g,u,...) at load
@@ -523,7 +628,7 @@ def fused_moe_int8_smoothquant(
         routing_data,
         None,
