--- a/aiter/ops/triton/_triton_kernels/fusions/fused_routing_from_topk.py
+++ b/aiter/ops/triton/_triton_kernels/fusions/fused_routing_from_topk.py
@@ -38,6 +38,23 @@ _fused_routing_from_topk_place_kernel_repr = make_kernel_repr(
     ],
 )

+_fused_routing_from_topk_metadata_kernel_repr = make_kernel_repr(
+    "_fused_routing_from_topk_metadata_kernel",
