 aiter/utility/dtypes.py                       |  1 +
 csrc/kernels/custom_kernels.cu                | 55 +++++++++++++--
 op_tests/validation/README.md                 | 28 ++++++++
 .../validation/validate_gfx90a_wv_split_kq.py | 70 +++++++++++++++++++
 4 files changed, 150 insertions(+), 4 deletions(-)
 create mode 100644 op_tests/validation/validate_gfx90a_wv_split_kq.py

