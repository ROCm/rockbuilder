+
+## gfx90a Wave Split-K FP8 correctness
+
+The gfx90a validator compares both Wave Split-K kernel paths against a
+dequantized FP32 matrix multiplication. It covers FP16 and BF16 output, all
+supported activation row counts, and dimensions on both sides of the small
+kernel dispatch boundary.
+
+On a homogeneous gfx90a host, run:
+
+```bash
+export PYTHONPATH="${PWD}:${PYTHONPATH:-}"
+GPU_ARCHS=gfx90a \
+  python op_tests/validation/validate_gfx90a_wv_split_kq.py
+```
+
+On a mixed-architecture host, expose only the gfx90a device to the ROCm runtime.
+For example, if gfx90a is physical device 1:
+
+```bash
+ROCR_VISIBLE_DEVICES=1 \
+  GPU_ARCHS=gfx90a \
+  python op_tests/validation/validate_gfx90a_wv_split_kq.py
+```
+
+The test requires E4M3-FNUZ input. It fails if AITER selects another FP8 format,
+the visible GPU is not gfx90a, the output is outside the existing Wave Split-K
+tolerance, or a kernel launch fails.
diff --git a/op_tests/validation/validate_gfx90a_wv_split_kq.py b/op_tests/validation/validate_gfx90a_wv_split_kq.py
new file mode 100644
index 00000000..1bef4230
--- /dev/null
+++ b/op_tests/validation/validate_gfx90a_wv_split_kq.py
@@ -0,0 +1,70 @@
+# SPDX-License-Identifier: MIT
+# Copyright (C) 2026, Advanced Micro Devices, Inc. All rights reserved.
+
+import torch
+
+import aiter
+
+
+TEST_SHAPES = (
+    (1, 4, 16),
+    (2, 60, 96),
+    (3, 17, 6192),
+    (4, 320, 16400),
+)
+
+
+def quantize_fp8(tensor):
+    scale = tensor.abs().max().float() / torch.finfo(aiter.dtypes.fp8).max
+    ret = (tensor / scale).to(aiter.dtypes.fp8), scale
+    return ret
+
+
+def validate_shape(output_dtype, rows, columns, inner, cu_count):
+    x = torch.randn((rows, inner), dtype=output_dtype, device="cuda")
+    weight = torch.randn((columns, inner), dtype=output_dtype, device="cuda")
+    x_fp8, x_scale = quantize_fp8(x)
+    weight_fp8, weight_scale = quantize_fp8(weight)
+    reference = (
+        torch.matmul(x_fp8.float(), weight_fp8.float().t()) * x_scale * weight_scale
+    ).to(output_dtype)
+    actual = torch.empty((rows, columns), dtype=output_dtype, device="cuda")
+    aiter.wvSplitKQ(
+        weight_fp8,
+        x_fp8,
+        actual,
+        weight_scale,
+        x_scale,
+        cu_count,
+    )
+    torch.cuda.synchronize()
+    torch.testing.assert_close(actual, reference, rtol=1e-2, atol=1e-2)
+    ret = (actual.float() - reference.float()).abs().max().item()
+    return ret
+
+
+def main():
+    torch.manual_seed(137)
+    properties = torch.cuda.get_device_properties("cuda")
+    if not properties.gcnArchName.startswith("gfx90a"):
+        raise RuntimeError(f"Expected gfx90a, found {properties.gcnArchName}")
+    if aiter.dtypes.fp8 != torch.float8_e4m3fnuz:
+        raise RuntimeError(f"Expected E4M3-FNUZ, found {aiter.dtypes.fp8}")
+
+    for output_dtype in (torch.float16, torch.bfloat16):
+        for rows, columns, inner in TEST_SHAPES:
+            max_error = validate_shape(
+                output_dtype,
+                rows,
+                columns,
+                inner,
+                properties.multi_processor_count,
+            )
+            print(
+                f"PASS dtype={output_dtype} shape=({rows},{columns},{inner}) "
+                f"max_abs_error={max_error:.8g}"
+            )
+
+
+if __name__ == "__main__":
+    main()
