index c4c0c2ee..3195bbb5 100644
--- a/csrc/kernels/custom_kernels.cu
+++ b/csrc/kernels/custom_kernels.cu
@@ -4,6 +4,7 @@
 #include "aiter_dispatch.h"
 #include <algorithm>
 #include <hip/hip_bf16.h>
+#include <hip/hip_fp8.h>
 #include <hip/hip_fp16.h>
 #include <hip/hip_runtime.h>
 #include <stdexcept>
@@ -1770,6 +1771,48 @@ void wvSplitK_(void* in_a,
 }

 #if defined(__HIP__MI350_MI300_MI250__) // TODO: Add NAVI support
+#if defined(__gfx90a__)
+using fp16x4 = __fp16 __attribute__((ext_vector_type(4)));
+
+__device__ __forceinline__ fp16x4 wv_split_kq_unpack_fp8x4(uint32_t packed)
+{
+    __hip_fp8x2_e4m3_fnuz low;
+    __hip_fp8x2_e4m3_fnuz high;
+    low.__x              = static_cast<__hip_fp8x2_storage_t>(packed);
+    high.__x             = static_cast<__hip_fp8x2_storage_t>(packed >> 16);
+    const float2 low_fp32  = static_cast<float2>(low);
+    const float2 high_fp32 = static_cast<float2>(high);
+    fp16x4 ret{
+        static_cast<__fp16>(low_fp32.x),
+        static_cast<__fp16>(low_fp32.y),
+        static_cast<__fp16>(high_fp32.x),
+        static_cast<__fp16>(high_fp32.y),
+    };
+    return ret;
+}
+#endif
+
+template <typename Accumulator>
+__device__ __forceinline__ Accumulator
+wv_split_kq_mfma_fp8(long packed_a, long packed_b, const Accumulator& accumulator)
+{
+    Accumulator ret;
+#if defined(__gfx90a__)
+    const uint64_t bits_a = __builtin_bit_cast(uint64_t, packed_a);
+    const uint64_t bits_b = __builtin_bit_cast(uint64_t, packed_b);
+    const fp16x4 a0       = wv_split_kq_unpack_fp8x4(static_cast<uint32_t>(bits_a));
+    const fp16x4 a1       = wv_split_kq_unpack_fp8x4(static_cast<uint32_t>(bits_a >> 32));
+    const fp16x4 b0       = wv_split_kq_unpack_fp8x4(static_cast<uint32_t>(bits_b));
+    const fp16x4 b1       = wv_split_kq_unpack_fp8x4(static_cast<uint32_t>(bits_b >> 32));
+    ret = __builtin_amdgcn_mfma_f32_32x32x8f16(a0, b0, accumulator, 0, 0, 0);
+    ret = __builtin_amdgcn_mfma_f32_32x32x8f16(a1, b1, ret, 0, 0, 0);
+#else
+    ret = __builtin_amdgcn_mfma_f32_32x32x16_fp8_fp8(
+        packed_a, packed_b, accumulator, 0, 0, 0);
+#endif
+    return ret;
+}
+
