-                                bigA[n][k2].l[i / 8], bigB[y][k2].l[i / 8], sum[n][y], 0, 0, 0);
+                            sum[n][y] = wv_split_kq_mfma_fp8(
+                                bigA[n][k2].l[i / 8],
+                                bigB[y][k2].l[i / 8],
+                                sum[n][y]);
                         }
                     }
                 }
@@ -2104,8 +2149,10 @@ __global__ void __launch_bounds__(WvPrGrp* THRDS) wvSplitKQ_hf_(const int K,
                     {
                         for(int y = 0; y < YTILE; ++y)
                         {
-                            sum[n][y] = __builtin_amdgcn_mfma_f32_32x32x16_fp8_fp8(
-                                bigA[n][k2].l[i / 8], bigB[y][k2].l[i / 8], sum[n][y], 0, 0, 0);
+                            sum[n][y] = wv_split_kq_mfma_fp8(
+                                bigA[n][k2].l[i / 8],
+                                bigB[y][k2].l[i / 8],
+                                sum[n][y]);
                         }
                     }
                 }
