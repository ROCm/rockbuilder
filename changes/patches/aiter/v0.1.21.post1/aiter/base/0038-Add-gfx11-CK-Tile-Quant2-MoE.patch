diff --git a/op_tests/test_gfx11_quant2_wmma.py b/op_tests/test_gfx11_quant2_wmma.py
new file mode 100644
index 00000000..591021a8
--- /dev/null
+++ b/op_tests/test_gfx11_quant2_wmma.py
@@ -0,0 +1,286 @@
+# SPDX-License-Identifier: MIT
+# Copyright (C) 2026, Advanced Micro Devices, Inc. All rights reserved.
+
+from dataclasses import replace
+
+import pytest
+import torch
+
+import aiter
+from aiter.fused_moe import fused_moe
+from aiter.jit.utils.chip_info import get_gfx
+from aiter.ops.flydsl.moe_common import GateMode
+from aiter.ops.gfx11_quant2 import (
+    GFX11_QUANT2_STAGE1_KERNEL,
+    GFX11_QUANT2_STAGE2_KERNEL,
+    Gfx11Quant2Problem,
+    ck_gfx11_wmma_supports,
+)
+from aiter.ops.moe_op import (
+    moe_cktile2stages_gemm1,
+    moe_cktile2stages_gemm2,
+)
+from aiter.ops.shuffle import shuffle_weight
+
+
+def _quantize_rows(tensor):
+    scale = tensor.float().abs().amax(dim=-1, keepdim=True) / 127
+    scale = torch.where(scale == 0, 1, scale)
+    quantized = torch.round(tensor.float() / scale).to(torch.int8)
+    return quantized, scale
+
+
+def _base_problem():
+    return Gfx11Quant2Problem(
+        arch="gfx1100",
+        token_count=16,
+        model_dim=256,
+        inter_dim=512,
+        expert_count=4,
+        topk=2,
+        input_dtype=torch.bfloat16,
+        output_dtype=torch.bfloat16,
+        activation=aiter.ActivationType.Silu.value,
+        quant_type=aiter.QuantType.per_Token.value,
+        q_dtype_a=torch.int8,
+        q_dtype_w=torch.int8,
+        is_gated=True,
+        gate_mode=GateMode.SEPARATED.value,
+        doweight_stage1=False,
+        w1_preshuffled=True,
+        w2_preshuffled=True,
+        has_weight_scales=True,
+        has_a1_scale=False,
+        has_a2_scale=False,
+        has_bias=False,
+        expert_parallel=False,
+        has_num_local_tokens=False,
+        stage2_scatter=False,
+        hidden_pad=0,
+        intermediate_pad=0,
+    )
+
+
+def test_gfx11_quant2_capability_is_fail_closed(monkeypatch):
+    problem = _base_problem()
+    monkeypatch.delenv("AITER_DISABLE_GFX11_CK_QUANT2", raising=False)
+    assert ck_gfx11_wmma_supports(problem)
+    assert ck_gfx11_wmma_supports(
+        replace(problem, model_dim=288, inter_dim=544)
+    )
+    assert ck_gfx11_wmma_supports(
+        replace(
+            problem,
+            model_dim=4096,
+            inter_dim=14336,
+            expert_count=8,
+        )
+    )
+
+    unsupported = (
+        replace(problem, arch="gfx1151"),
+        replace(problem, token_count=32),
+        replace(problem, expert_count=8),
+        replace(problem, topk=1),
+        replace(problem, model_dim=272),
+        replace(problem, inter_dim=528),
+        replace(problem, output_dtype=torch.float16),
+        replace(problem, activation=aiter.ActivationType.Gelu.value),
+        replace(problem, is_gated=False),
+        replace(problem, gate_mode=GateMode.INTERLEAVE.value),
+        replace(problem, doweight_stage1=True),
+        replace(problem, input_dtype=torch.int8),
+        replace(problem, w1_preshuffled=False),
+        replace(problem, w2_preshuffled=False),
+        replace(problem, has_weight_scales=False),
+        replace(problem, has_a1_scale=True),
+        replace(problem, has_a2_scale=True),
+        replace(problem, has_bias=True),
+        replace(problem, expert_parallel=True),
+        replace(problem, has_num_local_tokens=True),
+        replace(problem, stage2_scatter=True),
+        replace(problem, hidden_pad=16),
+        replace(problem, intermediate_pad=16),
+    )
+    assert all(not ck_gfx11_wmma_supports(candidate) for candidate in unsupported)
+
+    monkeypatch.setenv("AITER_DISABLE_GFX11_CK_QUANT2", "1")
+    assert not ck_gfx11_wmma_supports(problem)
+
+
+@pytest.mark.parametrize(
+    ("launcher", "kernel_name"),
+    [
+        (moe_cktile2stages_gemm1, GFX11_QUANT2_STAGE1_KERNEL),
+        (moe_cktile2stages_gemm2, GFX11_QUANT2_STAGE2_KERNEL),
+    ],
+)
+def test_gfx11_quant2_launcher_rejects_other_architectures(
+    launcher,
+    kernel_name,
+):
+    gfx = get_gfx()
+    if gfx == "gfx1100":
+        pytest.skip("requires a non-gfx1100 runtime")
+
+    x = torch.zeros((1, 32), device="cuda", dtype=torch.int8)
+    weight = torch.zeros((1, 64, 32), device="cuda", dtype=torch.int8)
+    output = torch.zeros((1, 32), device="cuda", dtype=torch.bfloat16)
+    sorted_ids = torch.zeros(1, device="cuda", dtype=torch.int32)
+    sorted_expert_ids = torch.zeros(1, device="cuda", dtype=torch.int32)
+    max_token_ids = torch.ones(2, device="cuda", dtype=torch.int32)
+    scales = torch.ones((1, 1), device="cuda", dtype=torch.float32)
+
+    with pytest.raises(RuntimeError, match=rf"requires gfx1100, got {gfx}"):
+        launcher(
+            x,
+            weight,
+            output,
+            sorted_ids,
+            sorted_expert_ids,
+            max_token_ids,
+            1,
+            topk_weight=scales,
+            x_scale=scales,
+            w_scale=scales,
+            block_m=16,
+            kernel_name=kernel_name,
+        )
+
+
+def _make_runtime_case(
+    token_count,
+    topk,
+    last_expert,
+    model_dim=256,
+    inter_dim=512,
+    expert_count=4,
+):
+    torch.manual_seed(31 + token_count + topk + model_dim + inter_dim)
+    experts = expert_count
+    hidden = torch.randn(
+        (token_count, model_dim),
+        device="cuda",
+        dtype=torch.bfloat16,
+    )
+    w1 = torch.randn(
+        (experts, inter_dim * 2, model_dim),
+        device="cuda",
+        dtype=torch.bfloat16,
+    )
+    w2 = torch.randn(
+        (experts, model_dim, inter_dim),
+        device="cuda",
+        dtype=torch.bfloat16,
+    )
+    w1_q, w1_scale = _quantize_rows(w1)
+    w2_q, w2_scale = _quantize_rows(w2)
+    w1_q = shuffle_weight(w1_q, layout=(16, 16))
+    w2_q = shuffle_weight(w2_q, layout=(16, 16))
+    if last_expert:
+        topk_ids = torch.full(
+            (token_count, topk),
+            experts - 1,
+            device="cuda",
+            dtype=torch.int32,
+        )
+    else:
+        token_ids = torch.arange(token_count, device="cuda", dtype=torch.int32)
+        topk_ids = torch.stack(
+            tuple((token_ids + slot) % experts for slot in range(topk)),
+            dim=1,
+        )
+    topk_weights = torch.rand(
+        (token_count, topk),
+        device="cuda",
+        dtype=torch.float32,
+    )
+    topk_weights /= topk_weights.sum(dim=1, keepdim=True)
+    return hidden, w1_q, w2_q, w1_scale, w2_scale, topk_weights, topk_ids
+
+
+def _run_case(case, output=None):
+    hidden, w1, w2, w1_scale, w2_scale, topk_weights, topk_ids = case
+    return fused_moe(
+        hidden,
+        w1,
+        w2,
+        topk_weights,
+        topk_ids,
+        quant_type=aiter.QuantType.per_Token,
+        w1_scale=w1_scale,
+        w2_scale=w2_scale,
+        dtype=torch.bfloat16,
+        output=output,
+    )
+
+
+def _with_guard(tensor, elements=4096):
+    flat = tensor.flatten()
+    guarded = torch.empty(
+        flat.numel() + elements,
+        dtype=tensor.dtype,
+        device=tensor.device,
+    )
+    guarded[: flat.numel()].copy_(flat)
+    ret = guarded[: flat.numel()].view_as(tensor)
+    ret.is_shuffled = True
+    return ret
+
+
+@pytest.mark.parametrize(
+    "token_count,topk,last_expert,model_dim,inter_dim,expert_count",
+    [
+        (1, 1, True, 256, 512, 4),
+        (7, 1, True, 256, 512, 4),
+        (16, 2, False, 256, 512, 4),
+        (17, 1, True, 256, 512, 4),
+        (33, 1, True, 256, 512, 4),
+        (16, 2, False, 288, 544, 4),
+        (16, 2, False, 4096, 14336, 8),
+    ],
+)
+def test_gfx11_quant2_matches_triton_and_is_deterministic(
+    monkeypatch,
+    token_count,
+    topk,
+    last_expert,
+    model_dim,
+    inter_dim,
+    expert_count,
+):
+    if get_gfx() != "gfx1100":
+        pytest.skip("gfx1100-only CK Quant2 validation")
+
+    case = list(
+        _make_runtime_case(
+            token_count,
+            topk,
+            last_expert,
+            model_dim,
+            inter_dim,
+            expert_count,
+        )
+    )
+    case[1] = _with_guard(case[1])
+    case[2] = _with_guard(case[2])
+    case = tuple(case)
+
+    monkeypatch.delenv("AITER_DISABLE_GFX11_CK_QUANT2", raising=False)
+    ck_output = _run_case(case)
+    repeated = _run_case(case)
+    torch.testing.assert_close(repeated, ck_output, rtol=0, atol=0)
+
+    output = torch.empty_like(ck_output)
+    returned = _run_case(case, output=output)
+    assert returned is output
+    torch.testing.assert_close(output, ck_output, rtol=0, atol=0)
+
+    monkeypatch.setenv("AITER_DISABLE_GFX11_CK_QUANT2", "1")
+    triton_output = _run_case(case)
+    similarity = torch.nn.functional.cosine_similarity(
+        ck_output.float().flatten(),
+        triton_output.float().flatten(),
+        dim=0,
+    )
+    assert 1 - similarity < 0.01
