+# SPDX-License-Identifier: MIT
+# Copyright (C) 2026, Advanced Micro Devices, Inc. All rights reserved.
+
+import os
+from dataclasses import dataclass
+
+import torch
+
+
+GFX11_QUANT2_STAGE1_KERNEL = (
+    "moe_cktile2stages_gemm1_128x16x128x64_1x4_"
+    "16x16x16_1perCU_per_token_silu"
+)
+GFX11_QUANT2_STAGE2_KERNEL = (
+    "moe_cktile2stages_gemm2_128x16x128x64_1x4_"
+    "16x16x16_1perCU_per_token_MulRoutedWeight"
+)
+
+_DISABLE_VALUES = ("1", "true", "True", "yes", "YES")
+_VALIDATED_GFX1100_PROBLEMS = frozenset(
+    {
+        (1, 256, 512, 4, 1),
+        (7, 256, 512, 4, 1),
+        (16, 256, 512, 4, 2),
+        (16, 288, 544, 4, 2),
+        (16, 4096, 14336, 8, 2),
+        (17, 256, 512, 4, 1),
+        (33, 256, 512, 4, 1),
+    }
+)
+
+
+@dataclass(frozen=True)
+class Gfx11Quant2Problem:
+    arch: str
+    token_count: int
+    model_dim: int
+    inter_dim: int
+    expert_count: int
+    topk: int
+    input_dtype: torch.dtype
+    output_dtype: torch.dtype
+    activation: int
+    quant_type: int
+    q_dtype_a: torch.dtype
+    q_dtype_w: torch.dtype
+    is_gated: bool
+    gate_mode: str
+    doweight_stage1: bool
+    w1_preshuffled: bool
+    w2_preshuffled: bool
+    has_weight_scales: bool
+    has_a1_scale: bool
+    has_a2_scale: bool
+    has_bias: bool
+    expert_parallel: bool
+    has_num_local_tokens: bool
+    stage2_scatter: bool
+    hidden_pad: int
+    intermediate_pad: int
+
+
+def ck_gfx11_wmma_supports(problem: Gfx11Quant2Problem) -> bool:
+    disabled = os.environ.get("AITER_DISABLE_GFX11_CK_QUANT2", "") in _DISABLE_VALUES
+    ret = (
+        not disabled
+        and problem.arch == "gfx1100"
+        and (
+            problem.token_count,
+            problem.model_dim,
+            problem.inter_dim,
+            problem.expert_count,
+            problem.topk,
+        )
+        in _VALIDATED_GFX1100_PROBLEMS
+        and problem.model_dim % 32 == 0
+        and problem.inter_dim % 32 == 0
+        and problem.input_dtype == torch.bfloat16
+        and problem.output_dtype == torch.bfloat16
+        and problem.activation == 0
+        and problem.quant_type == 2
+        and problem.q_dtype_a == torch.int8
+        and problem.q_dtype_w == torch.int8
+        and problem.is_gated
+        and problem.gate_mode == "separated"
+        and not problem.doweight_stage1
+        and problem.w1_preshuffled
+        and problem.w2_preshuffled
+        and problem.has_weight_scales
+        and not problem.has_a1_scale
+        and not problem.has_a2_scale
+        and not problem.has_bias
+        and not problem.expert_parallel
+        and not problem.has_num_local_tokens
+        and not problem.stage2_scatter
+        and problem.hidden_pad == 0
+        and problem.intermediate_pad == 0
+    )
+    return ret
