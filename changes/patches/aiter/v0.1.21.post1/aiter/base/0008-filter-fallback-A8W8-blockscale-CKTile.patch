From b50292c3a50403adbb7f2d95eca4f79c88995d01 Mon Sep 17 00:00:00 2001
From: Mika Laitio <mika.laitio@amd.com>
Date: Fri, 4 Sep 2026 00:57:24 -0700
Subject: [PATCH 08/22] A8W8 blockscale CKTile

- Exclude gfx1100 from CKTile code objects
- Preserve validated GPU targets in mixed builds
- Use the existing Triton public API fallback

Tools used:
- GPT: 5.6 Sol

Signed-off-by: Mika Laitio <mika.laitio@amd.com>
---
 aiter/jit/optCompilerConfig.json  | 8 ++++++++
 op_tests/test_jit_module_archs.py | 8 ++++++++
 2 files changed, 16 insertions(+)

diff --git a/aiter/jit/optCompilerConfig.json b/aiter/jit/optCompilerConfig.json
index 29a18801..3ac3c213 100644
--- a/aiter/jit/optCompilerConfig.json
+++ b/aiter/jit/optCompilerConfig.json
@@ -236,6 +236,14 @@
         "blob_gen_cmd": "f'{AITER_CSRC_DIR}/ck_gemm_a8w8_blockscale/gen_instances.py --working_path {{}} --tune_file {AITER_CONFIGS.AITER_CONFIG_GEMM_A8W8_BLOCKSCALE_FILE}'"
     },
     "module_gemm_a8w8_blockscale_cktile": {
+        "supported_gpu_archs": [
+            "gfx90a",
+            "gfx940",
+            "gfx941",
+            "gfx942",
+            "gfx950",
+            "gfx1250"
+        ],
         "srcs": [
             "f'{AITER_CSRC_DIR}/pybind/gemm_a8w8_blockscale_cktile_pybind.cu'",
             "f'{AITER_CSRC_DIR}/py_itfs_cu/gemm_common.cu'",
diff --git a/op_tests/test_jit_module_archs.py b/op_tests/test_jit_module_archs.py
index c56d73a3..1f8c9bfe 100644
--- a/op_tests/test_jit_module_archs.py
+++ b/op_tests/test_jit_module_archs.py
@@ -63,3 +63,11 @@ def test_get_args_of_build_rejects_unsupported_direct_jit(tmp_path, monkeypatch)
         match=r"module_supported.*gfx1100.*gfx90a",
     ):
         core.get_args_of_build("module_supported")
+
+
+def test_a8w8_blockscale_cktile_filters_gfx1100(monkeypatch):
+    monkeypatch.setattr(core, "get_gfx_list", lambda: ["gfx1100", "gfx90a"])
+
+    args = core.get_args_of_build("module_gemm_a8w8_blockscale_cktile")
+
+    assert args["gpu_archs"] == ["gfx90a"]
--
2.43.0
