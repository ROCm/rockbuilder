From 14c674da574025fe6443da595a9bc6e5b3565be3 Mon Sep 17 00:00:00 2001
From: Mika Laitio <mika.laitio@amd.com>
Date: Tue, 1 Sep 2026 17:36:14 -0700
Subject: [PATCH] rccl dedupe normalized GPU targets

- Add an amd-mainline RCCL patch that removes
  duplicate base architectures after stripping target
  feature qualifiers.
- TheRock test targets include both gfx90a:xnack-
  and gfx90a:xnack+, which normalize to gfx90a and
  previously created duplicate RCCL CMake targets.
- Rebuild offload architecture flags from the
  deduplicated target list.

Tools used:
- GPT: 5.6 Sol

Signed-off-by: Mika Laitio <mika.laitio@amd.com>
---
 ...0-rccl-dedupe-normalized-GPU-targets.patch | 48 +++++++++++++++++++
 1 file changed, 48 insertions(+)
 create mode 100644 patches/amd-mainline/rocm-systems/0010-rccl-dedupe-normalized-GPU-targets.patch

diff --git a/patches/amd-mainline/rocm-systems/0010-rccl-dedupe-normalized-GPU-targets.patch b/patches/amd-mainline/rocm-systems/0010-rccl-dedupe-normalized-GPU-targets.patch
new file mode 100644
index 0000000..c032d37
--- /dev/null
+++ b/patches/amd-mainline/rocm-systems/0010-rccl-dedupe-normalized-GPU-targets.patch
@@ -0,0 +1,48 @@
+From 279e56a8cd004792c49687eef777c435a13db0ee Mon Sep 17 00:00:00 2001
+From: Mika Laitio <mika.laitio@amd.com>
+Date: Tue, 1 Sep 2026 17:35:16 -0700
+Subject: [PATCH] rccl dedupe normalized GPU targets
+
+- RCCL strips target feature qualifiers before
+  creating device libraries.
+- Both gfx90a:xnack- and gfx90a:xnack+ become
+  gfx90a, which previously produced duplicate CMake
+  target names.
+- Remove duplicate normalized targets before
+  constructing offload architecture flags.
+
+Tools used:
+- GPT: 5.6 Sol
+
+Signed-off-by: Mika Laitio <mika.laitio@amd.com>
+---
+ projects/rccl/cmake/DeviceLinker.cmake | 11 ++++++++++-
+ 1 file changed, 10 insertions(+), 1 deletion(-)
+
+diff --git a/projects/rccl/cmake/DeviceLinker.cmake b/projects/rccl/cmake/DeviceLinker.cmake
+index 966fb49d21..3e71b4875a 100644
+--- a/projects/rccl/cmake/DeviceLinker.cmake
++++ b/projects/rccl/cmake/DeviceLinker.cmake
+@@ -89,10 +89,19 @@ message(STATUS "Device Linker: inherited compile options: ${DL_INHERITED_FLAGS}"
+ # Parse GPU_TARGETS: strip target features, build offload-arch flag list
+ # ---------------------------------------------------------------------------
+ set(DL_GPU_TARGETS "")
+-set(DL_OFFLOAD_ARCH_FLAGS "")
+ foreach(_gpu_raw ${GPU_TARGETS})
+   string(REGEX REPLACE ":.*" "" _gpu "${_gpu_raw}")
+   list(APPEND DL_GPU_TARGETS "${_gpu}")
++endforeach()
++
++# Feature-qualified targets normalize to the same base architecture. For
++# example, gfx90a:xnack-;gfx90a:xnack+ becomes gfx90a;gfx90a. Remove duplicates
++# before creating rccl_device_<target> libraries to avoid duplicate CMake
++# target names.
++list(REMOVE_DUPLICATES DL_GPU_TARGETS)
++
++set(DL_OFFLOAD_ARCH_FLAGS "")
++foreach(_gpu ${DL_GPU_TARGETS})
+   list(APPEND DL_OFFLOAD_ARCH_FLAGS "--offload-arch=${_gpu}")
+ endforeach()
+ message(STATUS "Device Linker: GPU targets = ${DL_GPU_TARGETS}")
+--
+2.43.0
