From 17b3777c562e0e9fc2fa7594f41d716cef23d23c Mon Sep 17 00:00:00 2001
From: Mika Laitio <mika.laitio@amd.com>
Date: Thu, 3 Sep 2026 16:03:59 -0700
Subject: [PATCH] Add LLVM offload host triple fix

- Fix the "host-x86_64-mageia-linux" case by
  ensuring that this three-component host triple
  produces the four-component host triple
  "host-x86_64-mageia-linux-unknown".
- Do not change LLVM's compiler target to
  "x86_64-mageia-linux-gnu"; that would break GCC
  header and compiler runtime lookup.
- Keep the compiler target as
  "x86_64-mageia-linux" and normalize only its
  representation in the offload bundle.
- Add the fix as an amd-mainline LLVM patch with a
  regression test for the Mageia triple.

Tools used:
- Codex: GPT-5

Signed-off-by: Mika Laitio <mika.laitio@amd.com>
---
 ...normalize-offload-bundle-host-triples.patch | 69 ++++++++++++++++++
 1 file changed, 69 insertions(+)
 create mode 100644 patches/amd-mainline/llvm-project/0001-normalize-offload-bundle-host-triples.patch

--- /dev/null
+++ b/patches/amd-mainline/llvm-project/0001-normalize-offload-bundle-host-triples.patch
@@ -0,0 +1,69 @@
+From 28f92a5332630302733e68aab44d829239aa8d73 Mon Sep 17 00:00:00 2001
+From: Mika Laitio <mika.laitio@amd.com>
+Date: Thu, 3 Sep 2026 16:03:59 -0700
+Subject: [PATCH] Normalize offload bundle host
+ triples
+
+- Fix the "host-x86_64-mageia-linux" case by
+  ensuring that this three-component host triple
+  produces the four-component host triple
+  "host-x86_64-mageia-linux-unknown".
+- Do not change LLVM's compiler target to
+  "x86_64-mageia-linux-gnu"; that would break GCC
+  header and compiler runtime lookup.
+- Keep the compiler target as
+  "x86_64-mageia-linux" and normalize only its
+  representation in the offload bundle.
+- Add a regression test for the Mageia triple.
+
+Tools used:
+- Codex: GPT-5
+
+Signed-off-by: Mika Laitio <mika.laitio@amd.com>
+---
+ .../linker-wrapper-host-triple.c               | 18 ++++++++++++++++++
+ .../clang-linker-wrapper/ClangLinkerWrapper.cpp | 12 ++++++++++--
+ 2 files changed, 28 insertions(+), 2 deletions(-)
+ create mode 100644 clang/test/OffloadTools/clang-linker-wrapper/linker-wrapper-host-triple.c
+
+--- /dev/null
++++ b/clang/test/OffloadTools/clang-linker-wrapper/linker-wrapper-host-triple.c
+@@ -0,0 +1,18 @@
++// REQUIRES: x86-registered-target
++
++// RUN: %clang -cc1 %s -triple x86_64-unknown-linux-gnu \
++// RUN:   -emit-obj -o %t.elf.o
++// RUN: llvm-offload-binary -o %t.out \
++// RUN:   --image=file=%t.elf.o,kind=hip,triple=amdgcn-amd-amdhsa,arch=gfx90a
++// RUN: %clang -cc1 %s -triple x86_64-unknown-linux-gnu \
++// RUN:   -emit-obj -o %t.o -fembed-offload-object=%t.out
++// RUN: clang-linker-wrapper --host-triple=x86_64-mageia-linux \
++// RUN:   --wrapper-verbose --save-temps --dry-run \
++// RUN:   --linker-path=/usr/bin/ld %t.o -o a.out 2>&1 \
++// RUN:   | FileCheck %s
++
++// CHECK: clang-offload-bundler
++// CHECK-SAME: -targets=host-x86_64-mageia-linux-unknown,
++// CHECK-SAME: hip-amdgcn-amd-amdhsa--gfx90a
++
++int main() { return 0; }
+--- a/clang/tools/clang-linker-wrapper/ClangLinkerWrapper.cpp
++++ b/clang/tools/clang-linker-wrapper/ClangLinkerWrapper.cpp
+@@ -471,7 +471,15 @@ fatbinary(ArrayRef<std::tuple<StringRef, StringRef, StringRef>> InputFiles,
+   llvm::Triple HostTriple(
+       Args.getLastArgValue(OPT_host_triple_EQ, sys::getDefaultTargetTriple()));
+-  SmallVector<StringRef> Targets = {
+-      Saver.save("-targets=host-" + HostTriple.normalize())};
++  // This fixes the "host-x86_64-mageia-linux" case by ensuring that this
++  // three-component host triple produces the four-component host triple
++  // "host-x86_64-mageia-linux-unknown". The LLVM compiler target cannot be
++  // changed to "x86_64-mageia-linux-gnu" because that would break GCC header
++  // and compiler runtime lookup. Keep the compiler target as
++  // "x86_64-mageia-linux" and normalize only its representation in the
++  // offload bundle.
++  SmallVector<StringRef> Targets = {Saver.save(
++      "-targets=host-" +
++      HostTriple.normalize(llvm::Triple::CanonicalForm::FOUR_IDENT))};
+   for (const auto &[File, TripleRef, Arch] : InputFiles) {
+     std::string NormalizedTriple =
+         normalizeForBundler(Triple(TripleRef), !Arch.empty());
